---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/sections/PageHero.astro';
import InquiryCta from '../../components/sections/InquiryCta.astro';
import Breadcrumb from '../../components/ui/Breadcrumb.astro';
import ApplicationGrid from '../../components/pages/solutions/ApplicationGrid.astro';
import ProcessSteps from '../../components/sections/ProcessSteps.astro';

import hero from '../../assets/solutions/index/hero.webp';
import residential from '../../assets/solutions/index/application-01.webp';
import commercial from '../../assets/solutions/index/application-02.webp';
import industrial from '../../assets/solutions/index/application-03.webp';
import facade from '../../assets/solutions/index/application-04.webp';

const applications = [
  { title: '住宅空间', image: residential },
  { title: '商业空间', image: commercial },
  { title: '工业地坪', image: industrial, href: '/solutions/industrial-floor' },
  { title: '建筑外立面与公共区域', image: facade },
];

const steps = [
  { index: '01', title: '先选场景', desc: '住宅、商业、工业' },
  { index: '02', title: '再看产品', desc: '匹配材料与施工需求' },
  { index: '03', title: '提交询盘', desc: '确认规格及预计数量' },
  { index: '04', title: '后续对接', desc: '获取产品资料与报价' },
];
---

<Base title="解决方案">
  <PageHero
    eyebrow="应用场景"
    title="解决方案"
    description="从住宅商业空间到工业地坪，根据不同场景需求匹配合适的材料体系。"
    image={hero}
    imageAlt="MENARO 解决方案"
    primary={{ label: '查看产品', href: '/products' }}
    secondary={{ label: '获取报价', href: '/quote' }}
  />

  <Breadcrumb items={[{ label: '首页', href: '/' }, { label: '解决方案' }]} />

  <ApplicationGrid
    eyebrow="应用分类"
    title="按建筑用途选择材料"
    note="选择住宅、商业或工业应用，了解适合的材料体系。"
    items={applications}
  />

  <ProcessSteps
    eyebrow="服务流程"
    title="更方便的产品选型"
    note="告诉我们您的项目用途和需求，我们会推荐相应产品并协助询价。"
    steps={steps}
  />

  <InquiryCta
    eyebrow="欢迎与美纳罗建立合作"
    title="让合适的产品更快进入你的采购链"
    description="欢迎就产品、包装、定制与采购需求与我们联系。"
    cta={{ label: '提交采购询盘', href: '/quote' }}
  />
</Base>
