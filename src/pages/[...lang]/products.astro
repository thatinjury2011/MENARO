---
import ProductFeatureBar from "../../components/products/ProductFeatureBar.astro";
import ProductGrid from "../../components/products/ProductGrid.astro";
import FeaturedProduct from "../../components/products/FeaturedProduct.astro";
import CtaSection from "../../components/shared/CtaSection.astro";
import PageHero from "../../components/shared/PageHero.astro";
import Layout from "../../layouts/Layout.astro";
import { productsPage } from "../../data/pages/products";
import { localeStaticPaths, localeOf } from "../../i18n/locales";

// 一个页面文件同时产出两种语言的路由：/xxx/ 与 /en/xxx/
export const getStaticPaths = localeStaticPaths;

const locale = localeOf(Astro.currentLocale);

const t = productsPage[locale];
---

<Layout title={t.title}>
  <PageHero
    label={t.hero.label}
    title={t.title}
    subtitle={t.hero.subtitle}
    description={t.hero.description}
    features={t.hero.features}
    image={null}
    bgImage="/images/products/hero.webp"
  />
  <ProductFeatureBar />
  <ProductGrid />
  <FeaturedProduct />
  <CtaSection />
</Layout>
