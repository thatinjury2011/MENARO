---
import ApplicationSpaces from "../../components/solutions/ApplicationSpaces.astro";
import BathroomSolution from "../../components/solutions/BathroomSolution.astro";
import ProcessSteps from "../../components/solutions/ProcessSteps.astro";
import RecommendedSystems from "../../components/solutions/RecommendedSystems.astro";
import CtaSection from "../../components/shared/CtaSection.astro";
import PageHero from "../../components/shared/PageHero.astro";
import Layout from "../../layouts/Layout.astro";
import { solutionsPage } from "../../data/pages/solutions";
import { localeStaticPaths, localeOf } from "../../i18n/locales";

// 一个页面文件同时产出两种语言的路由：/xxx/ 与 /en/xxx/
export const getStaticPaths = localeStaticPaths;

const locale = localeOf(Astro.currentLocale);

const t = solutionsPage[locale];
---

<Layout title={t.title}>
  <PageHero
    label={t.hero.label}
    title={t.title}
    subtitle={t.hero.subtitle}
    description={t.hero.description}
    features={t.hero.features}
    image={null}
    bgImage="/images/solutions/hero.webp"
  />
  <RecommendedSystems />
  <ProcessSteps />
  <ApplicationSpaces />
  <BathroomSolution />
  <CtaSection />
</Layout>
