---
import Base from '../layouts/Base.astro';
import PageHero from '../components/sections/PageHero.astro';
import InquiryCta from '../components/sections/InquiryCta.astro';
import Breadcrumb from '../components/ui/Breadcrumb.astro';
import CaseGrid from '../components/pages/cases/CaseGrid.astro';

import hero from '../assets/cases/hero.webp';
import case01 from '../assets/cases/case-01.webp';
import case02 from '../assets/cases/case-02.webp';
import case03 from '../assets/cases/case-03.webp';
import case04 from '../assets/cases/case-04.webp';
import case05 from '../assets/cases/case-05.webp';
import case06 from '../assets/cases/case-06.webp';
import caseWide from '../assets/cases/case-wide.webp';

const cases = [
  { title: '台州腾达中心', category: '商业办公建筑', image: case01 },
  { title: '台州鑫都国际大酒店', category: '酒店空间', image: case02 },
  { title: '黄岩宁溪龙仕翔悦境酒店', category: '精品度假酒店', image: case03 },
  { title: '台州路桥腾达研究院', category: '研究与办公空间', image: case04 },
  { title: '台州市新党校', category: '公共教育建筑', image: case05 },
  { title: '台州绿樾湖滨', category: '湖滨居住空间', image: case06 },
  { title: '台州市椒江区玖樟府精装项目', category: '精品住宅精装', image: caseWide, wide: true },
];
---

<Base title="项目案例">
  <PageHero
    eyebrow="MENARO · APPLICATIONS"
    title="项目案例"
    description="了解建筑材料在不同项目类型中的应用。"
    image={hero}
    imageAlt="MENARO 项目案例"
    primary={{ label: '获取报价', href: '/quote' }}
  />

  <Breadcrumb
    items={[{ label: '首页', href: '/' }, { label: '项目案例', href: '/cases' }, { label: '项目展示' }]}
  />

  <CaseGrid eyebrow="项目展示" title="项目展示" items={cases} />

  <InquiryCta
    eyebrow="欢迎与美纳罗建立合作"
    title="让合适的产品更快进入你的采购链"
    description="欢迎就产品、包装、定制与采购需求与我们联系。"
    cta={{ label: '提交采购询盘', href: '/quote' }}
  />
</Base>
