---
import CaseList from "../components/cases/CaseList.astro";
import FeaturedCase from "../components/cases/FeaturedCase.astro";
import CtaSection from "../components/shared/CtaSection.astro";
import PageHero from "../components/shared/PageHero.astro";
import StatsBar from "../components/shared/StatsBar.astro";
import Layout from "../layouts/Layout.astro";
import { casesPage } from "../data/pages/cases";

const t = casesPage.zh;
---

<Layout title={t.title}>
  <PageHero
    label={t.hero.label}
    title={t.title}
    subtitle={t.hero.subtitle}
    subtitleClass="text-white"
    description={t.hero.description}
    features={t.hero.features}
    bgImage="/images/solutions/hero.webp"
  />

  <CaseList />
  <FeaturedCase />

  <section class="w-full bg-white px-4 pb-4 sm:px-6">
    <div class="mx-auto max-w-7xl">
      <StatsBar items={t.stats} />
    </div>
  </section>

  <CtaSection title={t.cta.title} description={t.cta.description} />
</Layout>
