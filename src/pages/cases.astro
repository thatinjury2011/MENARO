---
import CaseList from "../components/cases/CaseList.astro";
import FeaturedCase from "../components/cases/FeaturedCase.astro";
import CtaSection from "../components/shared/CtaSection.astro";
import PageHero from "../components/shared/PageHero.astro";
import StatsBar from "../components/shared/StatsBar.astro";
import Layout from "../layouts/Layout.astro";

const heroFeatures = [
  { name: "低VOC" },
  { name: "意大利品质" },
  { name: "高端" },
  { name: "环保友好" },
];

const stats = [
  { label: "完成项目", value: "500+" },
  { label: "服务国家", value: "25+" },
  { label: "全球铺贴面积", value: "10M+ m2" },
  { label: "客户满意度", value: "98%" },
];
---

<Layout title="项目案例">
  <PageHero
    label="MENARO"
    title="项目案例"
    subtitle="在不同的真实项目案例中验证非凡的可靠性能"
    subtitleClass="text-white"
    description="从高端住宅到标志性商业空间，MENARO方案兼顾美观、强度与可靠性"
    features={heroFeatures}
    bgImage="/images/solutions/hero.webp"
  />

  <CaseList />
  <FeaturedCase />

  <section class="w-full bg-white px-4 pb-4 sm:px-6">
    <div class="mx-auto max-w-7xl">
      <StatsBar items={stats} />
    </div>
  </section>

  <CtaSection
    title="有项目计划？"
    description="我们的专家团队可提供专业建议和定制化解决方案"
  />
</Layout>
