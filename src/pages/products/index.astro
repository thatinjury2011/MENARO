---
import Base from '../../layouts/Base.astro';
import Container from '../../components/ui/Container.astro';
import Button from '../../components/ui/Button.astro';
import Breadcrumb from '../../components/ui/Breadcrumb.astro';
import InquiryCta from '../../components/sections/InquiryCta.astro';
import CatalogGroup from '../../components/pages/products/CatalogGroup.astro';

import iconTileGrout from '../../assets/icons/category-tile-grout.webp';
import iconTileAdhesive from '../../assets/icons/category-tile-adhesive.webp';
import iconSealant from '../../assets/icons/category-sealant.webp';
import iconFloor from '../../assets/icons/category-floor.webp';
import iconWaterproof from '../../assets/icons/category-waterproof.webp';
import iconCoating from '../../assets/icons/category-coating.webp';
import iconWoodwork from '../../assets/icons/category-woodwork.webp';
import iconDoors from '../../assets/icons/category-doors.webp';
import iconFlooring from '../../assets/icons/category-flooring.webp';
import iconBathware from '../../assets/icons/category-bathware.webp';
import iconLighting from '../../assets/icons/category-lighting.webp';
import iconFurniture from '../../assets/icons/category-furniture.webp';

const construction = [
  {
    title: '美缝与填缝材料',
    desc: '环氧美缝剂、晶瓷美缝剂、填缝材料',
    icon: iconTileGrout,
    href: '/products/tile-grout',
  },
  {
    title: '瓷砖胶与铺贴材料',
    desc: '瓷砖胶、瓷砖背胶、铺贴辅材',
    icon: iconTileAdhesive,
    href: '/products/tile-adhesive',
  },
  {
    title: '建筑密封胶与结构胶',
    desc: '玻璃胶、耐候密封胶、结构胶',
    icon: iconSealant,
    href: '/products/sealant',
  },
  {
    title: '环氧地坪与自流平',
    desc: '环氧彩砂自流平、环氧地坪',
    icon: iconFloor,
    href: '/products/floor',
  },
  { title: '防水与防护材料', desc: '防水涂料、防水浆料、防护材料', icon: iconWaterproof },
  { title: '建筑涂料与艺术漆', desc: '内墙漆、外墙漆、艺术漆、底漆', icon: iconCoating },
];

const interior = [
  { title: '全屋定制与木作系统', desc: '橱柜、衣柜、室内木门、墙板、木饰面', icon: iconWoodwork },
  { title: '门窗与移门系统', desc: '系统门窗、铝木门窗、联动移门、折叠门', icon: iconDoors },
  { title: '地板与装饰面料', desc: '实木地板、多层地板、SPC 地板、饰面板', icon: iconFlooring },
  { title: '卫浴洁具与五金配件', desc: '卫浴洁具、龙头花洒、五金配件', icon: iconBathware },
  { title: '照明与智能控制', desc: '室内照明、商业照明、智能控制', icon: iconLighting },
  { title: '家具与软装家居', desc: '活动家具、窗帘布艺、家居配饰', icon: iconFurniture },
];
---

<Base title="产品体系">
  <section class="bg-base-100 pt-14 pb-10 lg:pt-20 lg:pb-14">
    <Container>
      <div class="flex flex-col gap-5 lg:flex-row lg:items-end lg:justify-between">
        <div class="flex max-w-[720px] flex-col gap-4">
          <p class="text-[12px] tracking-[0.08em] text-mn-muted">PRODUCT CATALOG · 产品目录</p>
          <h1 class="text-[32px] leading-tight font-bold tracking-tight text-mn-ink lg:text-[44px]">产品体系</h1>
          <p class="text-[14px] leading-7 text-mn-muted">
            覆盖建筑与装修施工材料、空间成品与定制系统两大板块。已上线系列可直接查看产品资料，规划中系列欢迎就供货与定制需求提前沟通。
          </p>
        </div>
        <div class="flex flex-wrap gap-4">
          <Button href="/quote" withArrow class="min-w-[168px] justify-between">获取报价</Button>
          <Button href="/contact" variant="outline" withArrow class="min-w-[168px] justify-between">联系我们</Button>
        </div>
      </div>
    </Container>
  </section>

  <Breadcrumb items={[{ label: '首页', href: '/' }, { label: '产品体系' }]} />

  <div class="bg-base-100 py-6 lg:py-10">
    <Container>
      <CatalogGroup
        index="01"
        title="建筑与装修施工材料"
        description="用于建筑及装修施工的铺贴、粘接、密封、防水和表面处理，为住宅、商业及工程项目提供可靠的材料解决方案。"
        items={construction}
      />
      <CatalogGroup
        index="02"
        title="空间成品与定制系统"
        description="为住宅及商业空间提供可安装、可使用的成品与配套系统，支持标准化采购及个性化定制。"
        items={interior}
      />
    </Container>
  </div>

  <InquiryCta
    eyebrow="MENARO · 产品与制造合作"
    title="更多产品与制造合作"
    description="产品制造、定制生产、项目配套——按你的市场与项目需求确认方案。"
    cta={{ label: '联系我们', href: '/contact' }}
  />
</Base>
