---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/sections/PageHero.astro';
import InquiryCta from '../../components/sections/InquiryCta.astro';
import Breadcrumb from '../../components/ui/Breadcrumb.astro';
import IntroBlock from '../../components/pages/products/IntroBlock.astro';
import SeriesCards from '../../components/pages/products/SeriesCards.astro';
import PackagingSpecs from '../../components/pages/products/PackagingSpecs.astro';

import hero from '../../assets/products/floor/hero.webp';
import intro from '../../assets/products/floor/intro.webp';
import packaging from '../../assets/products/floor/packaging.webp';
import series01 from '../../assets/products/floor/series-01.webp';
import series02 from '../../assets/products/floor/series-02.webp';
import series03 from '../../assets/products/floor/series-03.webp';

const series = [
  {
    badge: '旗舰系列',
    title: '旗舰系列',
    subtitle: '环氧彩砂自流平',
    bullets: ['环氧彩砂自流平层面', '配套底涂与系统辅材'],
    packaging: '包装：按项目确认',
    usage: '适用：商业展示与高标室内地坪',
    link: { label: '查看代表产品', href: '/products/floor/epoxy-sand' },
    image: series01,
    accent: 'gray' as const,
  },
  {
    badge: '专业系列',
    title: '专业系列',
    subtitle: '常规环氧自流平',
    bullets: ['环氧自流平地坪体系'],
    packaging: '包装：按项目确认',
    usage: '适用：工业与商业室内地坪',
    link: { label: '获取报价', href: '/quote' },
    image: series02,
    accent: 'gray' as const,
  },
  {
    badge: '经典系列',
    title: '经典系列',
    subtitle: '环氧滚涂地坪',
    bullets: ['环氧地坪漆与配套涂层'],
    packaging: '包装：按项目确认',
    usage: '适用：基础地坪项目',
    link: { label: '获取报价', href: '/quote' },
    image: series03,
    accent: 'gray' as const,
  },
];
---

<Base title="环氧地坪与环氧彩砂自流平">
  <PageHero
    eyebrow="产品系列"
    title="环氧地坪与环氧彩砂自流平"
    description="提供环氧彩砂自流平及相关地坪材料，适用于商业、工业与公共空间。"
    image={hero}
    imageAlt="MENARO 环氧地坪材料"
    primary={{ label: '询价与合作', href: '/contact' }}
    secondary={{ label: '返回产品中心', href: '/products' }}
  />

  <Breadcrumb
    items={[
      { label: '首页', href: '/' },
      { label: '产品体系', href: '/products' },
      { label: '环氧地坪' },
    ]}
  />

  <IntroBlock
    eyebrow="产品介绍"
    title="地坪系统与自流平材料"
    description="提供环氧彩砂自流平及相关地坪材料，适用于商业、工业与公共空间。"
    bullets={['环氧彩砂自流平系统', '适配商业、工业与展示空间地坪', '按项目需求匹配底涂、中涂、面涂与辅料']}
    image={intro}
    imageAlt="环氧地坪材料展示"
    cta={{ label: '获取报价', href: '/quote' }}
  />

  <SeriesCards
    eyebrow="产品系列"
    title="按需求选择产品系列"
    note="根据使用场景和施工要求，选择合适的产品与包装形式。"
    cards={series}
  />

  <PackagingSpecs
    eyebrow="包装与技术资料"
    title="包装规格与采购支持"
    description="请提供项目面积、基层情况及目标效果，以便推荐合适的地坪系统与用量方案。"
    image={packaging}
    imageAlt="环氧地坪材料包装形式"
    specs={[
      { label: '包装形式', value: '按实际供货规格确认' },
      { label: '合作服务', value: '项目配套、品牌定制、成套方案供货' },
      { label: '技术资料', value: '施工体系图、颜色说明、用量建议' },
    ]}
    note="产品规格、可选包装及交货条件以正式报价资料为准。"
  />

  <InquiryCta
    eyebrow="欢迎与 MENARO 建立合作"
    title="让合适的产品更快进入你的采购链"
    description="欢迎就产品、包装、定制与采购需求与我们联系。"
    cta={{ label: '提交采购询盘', href: '/quote' }}
  />
</Base>
