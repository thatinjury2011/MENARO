---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/sections/PageHero.astro';
import InquiryCta from '../../components/sections/InquiryCta.astro';
import Breadcrumb from '../../components/ui/Breadcrumb.astro';
import IntroBlock from '../../components/pages/products/IntroBlock.astro';
import SeriesCards from '../../components/pages/products/SeriesCards.astro';
import PackagingSpecs from '../../components/pages/products/PackagingSpecs.astro';

import hero from '../../assets/products/sealant/hero.webp';
import intro from '../../assets/products/sealant/intro.webp';
import packaging from '../../assets/products/sealant/packaging.webp';
import series01 from '../../assets/products/sealant/series-01.webp';
import series02 from '../../assets/products/sealant/series-02.webp';
import series03 from '../../assets/products/sealant/series-03.webp';

const series = [
  {
    badge: '旗舰系列',
    title: '旗舰系列',
    subtitle: '建筑耐候密封',
    bullets: ['MS-786 高级中性耐候密封胶'],
    packaging: '包装：单管 300ml/支',
    usage: '适用：系统窗、阳光房、铝板密封',
    link: { label: '查看代表产品', href: '/products/sealant/ms-786' },
    image: series01,
    accent: 'gray' as const,
  },
  {
    badge: '专业系列',
    title: '专业系列',
    subtitle: '中性硅酮密封',
    bullets: ['MS-781 环保型中性硅酮密封胶'],
    packaging: '包装：单管 300ml/支',
    usage: '适用：门窗、家装家居密封',
    link: { label: '获取报价', href: '/quote' },
    image: series02,
    accent: 'gray' as const,
  },
  {
    badge: '经典系列',
    title: '经典系列',
    subtitle: '美容收边胶',
    bullets: ['MS-050 美容收边胶'],
    packaging: '包装：单管 300ml/支',
    usage: '适用：室内收边、接缝美化',
    link: { label: '获取报价', href: '/quote' },
    image: series03,
    accent: 'gray' as const,
  },
];
---

<Base title="建筑密封胶">
  <PageHero
    eyebrow="产品系列"
    title="建筑密封胶"
    description="适用于门窗、幕墙及室内外建筑接缝的密封与粘接需求。"
    image={hero}
    imageAlt="MENARO 建筑密封胶产品"
    primary={{ label: '询价与合作', href: '/contact' }}
    secondary={{ label: '返回产品中心', href: '/products' }}
  />

  <Breadcrumb
    items={[
      { label: '首页', href: '/' },
      { label: '产品体系', href: '/products' },
      { label: '建筑密封胶' },
    ]}
  />

  <IntroBlock
    eyebrow="产品介绍"
    title="建筑接缝与粘接材料"
    description="适用于门窗、幕墙及室内外建筑接缝的密封与粘接需求。"
    bullets={['门窗、幕墙与接缝密封', '耐候、防水与粘接应用', '配套工程、批发与品牌定制']}
    image={intro}
    imageAlt="建筑密封胶展示"
    cta={{ label: '获取报价', href: '/quote' }}
  />

  <SeriesCards
    eyebrow="产品系列"
    title="按需求选择产品系列"
    note="根据使用场景和施工要求，选择合适的产品与包装形式。"
    cards={series}
  />

  <PackagingSpecs
    eyebrow="包装与技术资料"
    title="包装规格与采购支持"
    description="可咨询胶管规格、用途、外箱包装及相关产品资料，并根据目的地和采购数量洽谈供货条件。"
    image={packaging}
    imageAlt="建筑密封胶包装形式"
    specs={[
      { label: '包装形式', value: '硬支 280/300ml；软支 590ml' },
      { label: '合作服务', value: '定制颜色、外箱定制、OEM / ODM' },
      { label: '技术资料', value: 'TDS、SDS、施工与储存说明' },
    ]}
    note="产品规格、可选包装及交货条件以正式报价资料为准。"
  />

  <InquiryCta
    eyebrow="欢迎与 MENARO 建立合作"
    title="让合适的产品更快进入你的采购链"
    description="欢迎就产品、包装、定制与采购需求与我们联系。"
    cta={{ label: '提交采购询盘', href: '/quote' }}
  />
</Base>
