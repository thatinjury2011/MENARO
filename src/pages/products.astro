---
import ProductFeatureBar from "../components/products/ProductFeatureBar.astro";
import ProductGrid from "../components/products/ProductGrid.astro";
import FeaturedProduct from "../components/products/FeaturedProduct.astro";
import CtaSection from "../components/shared/CtaSection.astro";
import PageHero from "../components/shared/PageHero.astro";
import Layout from "../layouts/Layout.astro";

const heroFeatures = [
  { name: "高端饰面" },
  { name: "可靠品质" },
  { name: "防水" },
  { name: "环保友好" },
];
---

<Layout title="产品 | MENARO 美纳罗">
  <PageHero
    title="产品"
    subtitle="高端瓷砖铺贴材料"
    description="专业系统解决方案，融合意大利技术，呈现持久美观效果。"
    features={heroFeatures}
  />
  <ProductFeatureBar />
  <ProductGrid />
  <FeaturedProduct />
  <CtaSection />
</Layout>
