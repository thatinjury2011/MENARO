---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/sections/PageHero.astro';
import InquiryCta from '../../components/sections/InquiryCta.astro';
import Breadcrumb from '../../components/ui/Breadcrumb.astro';
import FounderBlock from '../../components/pages/about/FounderBlock.astro';
import GlobalLocations from '../../components/pages/about/GlobalLocations.astro';
import AdvantageBand from '../../components/pages/about/AdvantageBand.astro';
import JoinBand from '../../components/pages/about/JoinBand.astro';

import hero from '../../assets/about/hero.webp';
import founder from '../../assets/about/intro.webp';
import advantageBg from '../../assets/about/advantage-bg.webp';
import global01 from '../../assets/about/global-01.webp';
import global02 from '../../assets/about/global-02.webp';
import global03 from '../../assets/about/global-03.webp';
import global04 from '../../assets/about/global-04.webp';

import iconCity from '../../assets/icons/global-city.webp';
import iconAddress from '../../assets/icons/global-address.webp';
import iconPeople from '../../assets/icons/global-people.webp';
import iconFuture from '../../assets/icons/global-future.webp';

import advantage01 from '../../assets/icons/advantage-01.webp';
import advantage02 from '../../assets/icons/advantage-02.webp';
import advantage03 from '../../assets/icons/advantage-03.webp';
import advantage04 from '../../assets/icons/advantage-04.webp';
import advantage05 from '../../assets/icons/advantage-05.webp';
import advantage06 from '../../assets/icons/advantage-06.webp';

const locations = [
  {
    location: '中国 · 台州',
    locationEn: 'Taizhou, China',
    title: '品牌运营中心',
    desc: '品牌管理、市场运营、客户服务与项目协同。',
    icon: iconCity,
    image: global01,
  },
  {
    location: '中国 · 安徽',
    locationEn: 'Anhui, China',
    title: '自主制造基地',
    desc: '配套成熟的生产设备与质量管理体系，专注于高品质建筑材料的研发与生产。',
    icon: iconAddress,
    image: global02,
  },
  {
    location: '越南 · 同奈',
    locationEn: 'Dong Nai, Vietnam',
    title: '合作生产基地',
    desc: '依托本地制造资源与供应链优势，为海外市场提供灵活、高效的生产与交付支持。',
    icon: iconPeople,
    image: global03,
  },
  {
    location: '未来布局',
    locationEn: 'Global Expansion',
    title: '持续全球拓展',
    desc: '面向全球市场，持续优化产能布局与供应体系，满足更广泛的项目需求。',
    icon: iconFuture,
    image: global04,
  },
];

const advantages = [
  {
    title: '终端应用洞察',
    desc: '深入了解不同建筑场景的材料需求，提供更贴合实际应用的解决方案。',
    icon: advantage01,
  },
  {
    title: '制造与品质控制',
    desc: '结合生产基地标准制造流程，严格把控品质，确保产品品质。',
    icon: advantage02,
  },
  {
    title: '产品整合能力',
    desc: '整合多品类建筑材料，提供一站式供应方案，满足多样化需求。',
    icon: advantage03,
  },
  {
    title: '全球供应服务',
    desc: '覆盖全球市场，提供高效、稳定、灵活的供应与物流支持。',
    icon: advantage04,
  },
  {
    title: '项目服务支持',
    desc: '提供前期咨询、技术支持与项目落地服务，助力客户顺利完成项目。',
    icon: advantage05,
  },
  {
    title: '售后与长期合作',
    desc: '重视客户体验，提供专业的售后支持，与客户保持长期、稳定合作。',
    icon: advantage06,
  },
];
---

<Base title="关于我们">
  <PageHero
    brandMark
    title="关于我们"
    subtitle="把高品质中国制造连接到全球建筑应用"
    description="美纳罗专注于高品质建筑材料的研发、制造与全球供应，并整合中国优质制造资源与供应链协同，为全球客户提供稳定、可靠的产品供应和面向项目的解决方案。"
    image={hero}
    imageAlt="MENARO 品牌空间"
    primary={{ label: '了解我们的故事', href: '#founder' }}
  />

  <Breadcrumb items={[{ label: '首页', href: '/' }, { label: '关于我们' }]} />

  <div id="founder">
    <FounderBlock
      eyebrow="FOUNDER"
      title="品牌创始人 | Wang UP"
      subtitle="源于真实的行业经验，更懂材料，更懂客户"
      paragraphs={[
        'Wang UP先生自2010年进入建筑材料行业，长期深耕产品应用、供应链管理、项目交付与客户服务，积累了丰富的行业经验与经营管理能力。',
        '凭借对建筑材料性能、实际施工及长期使用需求的深入理解，他逐步将事业延伸至制造领域，投资布局建筑材料制造基地，推动产品研发、生产管理、品质控制与供应链体系建设。',
        '基于多年行业积累及制造端经验，他创立了MENARO美纳罗品牌，以自主制造为基础，整合国内外优质合作制造资源，将中国高品质制造与全球市场需求紧密连接，为客户提供可靠的建筑材料、专业的产品服务及定制化解决方案。',
      ]}
      quote={{ text: '好的建筑，始于合适的材料，也源于对真实应用场景的深刻理解。', signature: 'Wang UP' }}
      image={founder}
      imageAlt="MENARO 品牌创始人 Wang UP"
    />
  </div>

  <GlobalLocations
    eyebrow="GLOBAL OPERATIONS & MANUFACTURING"
    title="全球运营与制造布局"
    note="以中国为运营与制造基础，逐步拓展海外合作生产基地，构建面向全球市场的多区域制造与供应体系。"
    items={locations}
  />

  <AdvantageBand
    eyebrow="MENARO"
    title="我们的核心优势"
    note="我们整合中国优质制造资源与全球市场经验，致力于为客户提供更具竞争力的建筑材料解决方案。"
    items={advantages}
  />

  <JoinBand
    title="期待与您携手"
    subtitle="以更好的材料，创造更优质的建筑空间"
    description="无论您是开发商、建筑商、设计机构还是渠道合作伙伴，美纳罗将以专业的产品与服务，助力您的项目成功。"
    image={advantageBg}
    imageAlt="MENARO 与合作伙伴携手"
    cta={{ label: '联系我们', href: '/contact' }}
  />

  <InquiryCta
    eyebrow="欢迎与美纳罗建立合作"
    title="让合适的产品更快进入你的采购链"
    description="欢迎就产品、包装、定制与采购需求与我们联系。"
    cta={{ label: '提交采购询盘', href: '/quote' }}
  />
</Base>
