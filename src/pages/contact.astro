---
import Base from '../layouts/Base.astro';
import Container from '../components/ui/Container.astro';
import PageHero from '../components/sections/PageHero.astro';
import Breadcrumb from '../components/ui/Breadcrumb.astro';
import InquiryForm from '../components/sections/InquiryForm.astro';
import ContactCard from '../components/pages/contact/ContactCard.astro';

import hero from '../assets/contact/hero.webp';
import photo from '../assets/contact/photo.webp';

import iconAddress from '../assets/icons/contact-address.webp';
import iconPhone from '../assets/icons/contact-phone.webp';
import iconWhatsapp from '../assets/icons/contact-whatsapp.webp';
import iconMail from '../assets/icons/contact-mail.webp';
import iconTime from '../assets/icons/contact-time.webp';

const info = [
  { icon: iconPhone, label: '电话', value: '+86 576 8853 9555（工作时间 9:00 - 18:00）' },
  { icon: iconWhatsapp, label: 'WhatsApp', value: '+86 189 5760 1234（可直接添加联系）' },
  { icon: iconMail, label: '企业邮箱', value: 'info@menarobm.com' },
  { icon: iconTime, label: '工作时间（北京时间）', value: '周一至周五 9:00 - 18:00' },
];
---

<Base title="联系我们">
  <PageHero
    eyebrow="商务询盘"
    title="联系我们"
    description="咨询产品资料、包装规格、样品与报价，请留下采购需求和联系方式。"
    image={hero}
    imageAlt="MENARO 品牌空间与产品应用"
    primary={{ label: '获取报价', href: '/quote' }}
  />

  <Breadcrumb items={[{ label: '首页', href: '/' }, { label: '联系我们' }]} />

  <section class="bg-base-100 py-12 lg:py-16">
    <Container>
      <div class="grid grid-cols-1 gap-8 lg:grid-cols-[minmax(0,0.82fr)_minmax(0,1fr)] lg:gap-10">
        <ContactCard
          title="告诉我们您的采购需求"
          paragraphs={[
            '无论您需要产品资料、包装规格、样品测试，还是定制化解决方案，我们都将根据您的市场需求，提供合适的产品方案与专业的报价支持。',
          ]}
          photo={photo}
          photoAlt="MENARO 商务洽谈"
          address="中国 · 浙江 · 台州"
          addressIcon={iconAddress}
          items={info}
        />

        <div class="rounded-box border border-mn-border bg-base-100 p-6 lg:p-8">
          <InquiryForm
            variant="contact"
            title="提交询盘"
            note="请留下联系人、国家/地区、意向产品，以及邮箱或 WhatsApp 中至少一种联系方式。"
            submitLabel="提交采购询盘"
          />
        </div>
      </div>
    </Container>
  </section>
</Base>
