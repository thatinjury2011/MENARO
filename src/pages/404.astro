---
import Base from '../layouts/Base.astro';
---

<Base title="页面未找到">
  <section
    class="mx-auto flex w-full max-w-[90rem] flex-col items-start gap-6 px-5 py-24 lg:px-10 lg:py-32"
  >
    <p class="text-sm font-medium tracking-[0.2em] text-mn-gold uppercase">404</p>
    <h1 class="text-3xl font-semibold text-mn-ink lg:text-4xl">页面未找到</h1>
    <p class="max-w-xl leading-relaxed text-mn-muted">您访问的页面不存在或已移动。</p>
    <a href="/" class="btn btn-primary px-6">返回首页</a>
  </section>
</Base>
