---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Container from '../components/ui/Container.astro';
import PageHero from '../components/sections/PageHero.astro';
import InquiryForm from '../components/sections/InquiryForm.astro';
import WhyCard from '../components/pages/quote/WhyCard.astro';
import QuoteSteps from '../components/pages/quote/QuoteSteps.astro';

import hero from '../assets/quote/hero.webp';
import why from '../assets/quote/why.webp';

import iconShield from '../assets/icons/value-shield.webp';
import iconLayers from '../assets/icons/advantage-03.webp';
import iconGlobe from '../assets/icons/form-globe.webp';
import process01 from '../assets/icons/process-01.webp';
import process02 from '../assets/icons/process-02.webp';
import process03 from '../assets/icons/process-03.webp';
import process04 from '../assets/icons/form-box.webp';

const highlights = [
  { icon: iconShield, title: '源头品质', desc: '稳定可靠' },
  { icon: iconLayers, title: '产品齐全', desc: '应用广泛' },
  { icon: iconGlobe, title: '全球供应', desc: '专业支持' },
];

const whyItems = ['专业的产品解决方案', '灵活的包装与OEM/ODM', '稳定的供货与交付', '面向全球的服务支持'];

const steps = [
  { title: '提交需求', desc: '填写并提缴询盘信息', icon: process01 },
  { title: '专人联系', desc: '我们的团队将尽快与您联系', icon: process02 },
  { title: '提供方案与报价', desc: '根据您的需求提供产品方案与报价', icon: process03 },
  { title: '确认合作', desc: '确定产品、数量与交付安排', icon: process04 },
];
---

<Base title="获取报价">
  <PageHero
    eyebrow="获取报价"
    title="获取报价"
    description="告诉我们您的采购需求，我们将为您提供合适的产品方案、报价和服务支持。"
    image={hero}
    imageAlt="MENARO 产品系列"
    primary={{ label: '填写询价信息', href: '#quote-form' }}
  />

  <section class="border-b border-mn-border bg-base-100 py-6">
    <Container>
      <ul class="flex flex-wrap items-center justify-center gap-x-10 gap-y-4 lg:justify-start">
        {
          highlights.map((item) => (
            <li class="flex items-center gap-2.5">
              <Image src={item.icon} alt="" width={48} height={48} class="size-5 object-contain" loading="lazy" />
              <span class="flex flex-col">
                <span class="text-[13px] font-semibold text-mn-ink">{item.title}</span>
                <span class="text-[11px] text-mn-muted">{item.desc}</span>
              </span>
            </li>
          ))
        }
      </ul>
    </Container>
  </section>

  <section id="quote-form" class="bg-base-100 py-12 lg:py-16">
    <Container>
      <div class="grid grid-cols-1 gap-8 lg:grid-cols-[minmax(0,0.72fr)_minmax(0,1fr)] lg:gap-10">
        <WhyCard
          title="为什么选择 MENARO美纳罗？"
          items={whyItems}
          image={why}
          imageAlt="MENARO 产品应用空间"
        />

        <div class="rounded-box border border-mn-border bg-base-100 p-6 lg:p-8">
          <InquiryForm
            variant="quote"
            title="获取报价"
            note="我们会根据您填写的产品、数量与目标市场，提供对应的产品方案与报价。"
            submitLabel="获取报价"
          />
        </div>
      </div>
    </Container>
  </section>

  <QuoteSteps title="询价流程" subtitle="简单 · 高效 · 专业" steps={steps} />
</Base>
