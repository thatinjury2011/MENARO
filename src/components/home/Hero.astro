---
// 首页 Hero
import PageHero from "../shared/PageHero.astro";

const actions = [
  { label: "浏览产品", href: "/products", variant: "solid" as const },
  { label: "查看解决方案", href: "/solutions", variant: "ghost" as const },
];

const features = [
  { name: "低VOC配方" },
  { name: "色彩稳定" },
  { name: "耐污性能" },
  { name: "防霉保护" },
];
---

<PageHero
  label="MENARO"
  title="水性环氧彩砂"
  subtitle="高端瓷砖缝隙美化解决方案"
  description="高性能、低VOC、色彩稳定的系统方案，保护每一处细节并提升空间质感"
  features={features}
  featuresPlacement="side"
  actions={actions}
  image={null}
  bgImage="/images/home/hero.webp"
  blurMask={false}
/>
