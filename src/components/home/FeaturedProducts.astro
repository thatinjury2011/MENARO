---
// 首页：精选产品（Product 水印 + 人物图 + 4 卡一行）
// 图片约定：产品图复用 /images/products/*，人物图 /images/global/lab-expert.webp
import SectionTitle from "../shared/SectionTitle.astro";

const products = [
  {
    name: "水性环氧彩砂",
    desc: "色彩稳定、耐污耐磨，适用于高端瓷砖缝隙美化",
    href: "/products",
    image: "/images/products/sealing.png",
  },
  {
    name: "高性能瓷砖胶",
    desc: "粘结力强，施工顺滑，适用于多种瓷砖铺贴场景",
    href: "/products",
    image: "/images/products/tile-glue.png",
  },
  {
    name: "环氧美缝添加剂",
    desc: "提升美缝材料性能，让整体铺贴系统更耐用",
    href: "/products",
    image: "/images/products/epoxy-additive.png",
  },
  {
    name: "柔性防水涂料",
    desc: "为卫浴、阳台等潮湿区域提供可靠防水保护",
    href: "/products",
    image: "/images/products/waterproof.png",
  },
];
---

<section class="relative w-full overflow-hidden bg-white px-4 py-16 sm:px-6">
  <span
    class="pointer-events-none absolute top-1/3 left-0 hidden -rotate-90 text-[7rem] leading-none font-black tracking-tighter text-neutral-100 select-none lg:block"
    aria-hidden="true">Product</span
  >

  <div class="relative mx-auto max-w-7xl">
    <SectionTitle title="精选产品" variant="highlight" />

    <!-- 人物图：/images/global/lab-expert.webp -->
    <div class="relative z-10 -mb-16 hidden justify-end pr-16 lg:flex">
      <img
        src="/images/global/lab-expert.webp"
        alt=""
        class="h-56 w-auto object-contain"
      />
    </div>

    <div class="relative rounded-3xl bg-[#e2d2c1] px-6 py-8 sm:px-8">
      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {
          products.map((product) => (
            <article class="flex flex-col rounded-2xl bg-white p-4 shadow-[0_16px_40px_-20px_rgba(0,0,0,0.3)]">
              <figure class="flex h-32 items-center justify-center">
                <img
                  src={product.image}
                  alt={product.name}
                  class="max-h-full w-auto object-contain"
                />
              </figure>
              <div class="mt-4 flex flex-1 flex-col items-center gap-2 text-center">
                <h3 class="text-sm font-bold text-neutral-800">
                  {product.name}
                </h3>
                <p class="text-xs leading-relaxed text-neutral-500">
                  {product.desc}
                </p>
                <a
                  href={product.href}
                  class="mt-auto pt-1 text-xs text-amber-700 transition-colors hover:text-amber-800"
                >
                  查看详情›
                </a>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</section>
