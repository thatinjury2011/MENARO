---
// 首页：项目亮点（3 个项目卡）
import SectionTitle from "../shared/SectionTitle.astro";
import ProjectCards from "../shared/ProjectCards.astro";
import { projectHighlights } from "../../data/home/projectHighlights";
import { homeProjects } from "../../data/cases/caseList";
import { localeOf } from "../../i18n/locales";

const locale = localeOf(Astro.currentLocale);

const t = projectHighlights[locale];

// 项目数据与案例页同源（src/data/cases/caseList.ts），这里只挑 show.home 的
const projects = homeProjects(locale);
---

<section class="w-full bg-white px-4 py-16 sm:px-6">
  <div class="mx-auto max-w-7xl">
    <SectionTitle title={t.title} variant="highlight" />

    <div class="mt-8 rounded-3xl bg-[#e9e3d9] p-6 sm:p-8">
      <ProjectCards items={projects} />
    </div>
  </div>
</section>
