---
import Container from '../ui/Container.astro';
import { getLangFromUrl, localizePath } from '../../i18n/utils';
import { ui } from '../../i18n/ui';

interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  items: Crumb[];
}

const { items } = Astro.props;
const lang = getLangFromUrl(Astro.url);
---

<nav aria-label={ui[lang].breadcrumbAria} class="border-b border-mn-border bg-base-100">
  <Container class="py-4">
    <ol class="flex flex-wrap items-center gap-2 text-[13px] text-mn-muted">
      {
        items.map((item, i) => (
          <li class="flex items-center gap-2">
            {item.href ? (
              <a href={localizePath(item.href, lang)} class="transition-colors hover:text-mn-green">
                {item.label}
              </a>
            ) : (
              <span class="text-mn-ink">{item.label}</span>
            )}
            {i < items.length - 1 && <span aria-hidden="true">/</span>}
          </li>
        ))
      }
    </ol>
  </Container>
</nav>