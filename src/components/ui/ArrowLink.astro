---
import ArrowIcon from './ArrowIcon.astro';

interface Props {
  href: string;
  class?: string;
  direction?: 'right' | 'up-right';
}

const { href, class: className = '', direction = 'right' } = Astro.props;
---

<a
  href={href}
  class:list={[
    'group inline-flex items-center gap-2 text-[18px] leading-[27px] font-bold text-mn-ink transition-colors hover:text-mn-green',
    className,
  ]}
>
  <slot />
  <ArrowIcon
    direction={direction}
    className="size-[18px] transition-transform duration-200 group-hover:translate-x-1"
  />
</a>
