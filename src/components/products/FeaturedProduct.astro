---
// 产品页：精选产品（左文右图）
// 图片约定：/images/products/featured.webp
// 上这个板块的产品由 src/data/products.ts 里每条记录的 show.featured 决定
import SectionTitle from "../shared/SectionTitle.astro";
import Icon from "../shared/Icon.astro";
import { oneBy } from "../../data/products/catalog";
import { featuredProduct } from "../../data/products/featuredProduct";
import { localeOf } from "../../i18n/locales";
import { localeHref } from "../../i18n/links";

const locale = localeOf(Astro.currentLocale);

const product = oneBy("featured", locale);
const t = featuredProduct[locale];
---

<section class="relative w-full overflow-hidden bg-white px-4 py-16 sm:px-6">
  <span
    class="pointer-events-none absolute inset-x-0 top-8 hidden text-center text-[7rem] leading-none font-black tracking-tight text-neutral-100 select-none lg:block"
    aria-hidden="true">MENARO</span
  >

  <div class="relative mx-auto max-w-6xl">
    <SectionTitle title={t.title} />

    <div
      class="mt-8 grid items-stretch gap-8 rounded-3xl bg-white p-6 shadow-[0_18px_50px_-24px_rgba(0,0,0,0.3)] md:grid-cols-2 md:p-8"
    >
      <div class="flex flex-col items-start justify-center gap-4">
        <h3 class="text-xl font-bold text-neutral-800">{product.name}</h3>
        <ul class="flex flex-col gap-1.5 text-xs leading-relaxed text-neutral-500">
          {product.highlights?.map((item) => <li>{item}</li>)}
        </ul>
        <a
          href={localeHref(locale, "/products")}
          class="mt-2 inline-flex items-center gap-2 rounded-lg border border-neutral-300 px-5 py-2 text-xs font-medium text-neutral-700 transition-colors hover:bg-neutral-50"
        >
          {t.detailLink}
          <Icon name="arrowRight" class="size-4" />
        </a>
      </div>

      <div class="overflow-hidden rounded-2xl">
        <img
          src={product.bannerImage ?? product.image}
          alt={product.name}
          class="h-full min-h-64 w-full object-cover"
        />
      </div>
    </div>
  </div>
</section>
