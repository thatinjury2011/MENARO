---
// 产品页：4 个核心卖点条
import Icon from "../shared/Icon.astro";
import { featureBar } from "../../data/products/featureBar";
import { localeOf } from "../../i18n/locales";

const locale = localeOf(Astro.currentLocale);

const t = featureBar[locale];
---

<section class="w-full px-4 pt-14 sm:px-6">
  <div
    class="mx-auto flex max-w-6xl flex-col divide-y divide-neutral-200 rounded-2xl bg-white px-4 py-8 shadow-[0_18px_50px_-24px_rgba(0,0,0,0.25)] sm:flex-row sm:divide-x sm:divide-y-0"
  >
    {
      t.features.map((feature) => (
        <div class="flex flex-1 flex-col items-center gap-2 px-6 py-4 text-center">
          <Icon name={feature.icon} class="size-7 text-amber-700" />
          <h3 class="text-sm font-bold text-neutral-800">{feature.name}</h3>
          <p class="text-xs leading-relaxed text-neutral-500">
            {feature.desc}
          </p>
        </div>
      ))
    }
  </div>
</section>
