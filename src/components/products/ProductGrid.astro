---
// 产品页：产品网格（背景水印 + 顶部人物图 + 3+2 卡片布局）
import ProductCard from "./ProductCard.astro";
// 产品数据唯一来源：src/data/products.ts（加/删产品只改那里）
import { productList } from "../../data/products/catalog";
import { localeOf } from "../../i18n/locales";

const locale = localeOf(Astro.currentLocale);

const products = productList(locale);

// 3+2 布局：前 3 张铺满一行，后 2 张居中
const gridClass = (index: number) => {
  if (index < 3) return "sm:col-span-1 lg:col-span-2";
  return index === 3
    ? "sm:col-span-1 lg:col-span-2 lg:col-start-2"
    : "sm:col-span-1 lg:col-span-2 lg:col-start-4";
};
---

<section class="relative w-full overflow-hidden bg-white px-4 py-16 sm:px-6">
  <!-- 背景水印 -->
  <span
    class="pointer-events-none absolute top-1/2 left-0 hidden -translate-y-1/2 -rotate-90 text-[9rem] leading-none font-black tracking-tighter text-neutral-100 select-none lg:block"
    aria-hidden="true">Product</span
  >

  <div class="relative mx-auto max-w-7xl">
    <!-- 顶部人物图：/images/global/lab-expert.webp -->
    <div class="relative z-10 -mb-16 hidden justify-center md:flex">
      <img
        src="/images/global/lab-expert.webp"
        alt=""
        class="h-72 w-auto object-contain"
      />
    </div>

    <div
      class="relative z-20 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-6"
    >
      {
        products.map((product, index) => (
          <div class:list={["flex", gridClass(index)]}>
            <ProductCard
              name={product.name}
              description={product.description}
              keywords={product.keywords ?? []}
              image={product.image}
            />
          </div>
        ))
      }
    </div>
  </div>
</section>
