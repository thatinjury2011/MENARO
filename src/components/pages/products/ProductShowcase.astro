---
import { Image } from 'astro:assets';
import Container from '../../ui/Container.astro';
import Button from '../../ui/Button.astro';
import type { ImageMetadata } from 'astro';

interface Props {
  eyebrow?: string;
  caption?: string;
  title: string;
  description?: string;
  model: string;
  packaging: string;
  highlight: string;
  image: ImageMetadata;
  imageAlt: string;
  cta: { label: string; href: string };
}

const { eyebrow = '产品详情', caption = '包装概念参考', title, description, model, packaging, highlight, image, imageAlt, cta } =
  Astro.props;
---

<section class="bg-base-100 py-14 lg:py-20">
  <Container>
    <div class="grid grid-cols-1 items-center gap-10 lg:grid-cols-2 lg:gap-16">
      <div class="flex flex-col gap-3 bg-mn-paper px-6 pt-4 pb-6">
        <p class="text-[11px] tracking-wide text-mn-muted">{caption}</p>
        <Image
          src={image}
          alt={imageAlt}
          widths={[600, 900, 1186]}
          sizes="(min-width: 1024px) 50vw, 100vw"
          class="mx-auto h-[360px] w-auto object-contain lg:h-[460px]"
          loading="lazy"
        />
      </div>

      <div class="flex flex-col gap-4">
        <p class="text-[12px] tracking-[0.08em] text-mn-muted">{eyebrow}</p>
        <h2 class="text-[26px] leading-tight font-bold tracking-tight text-mn-ink lg:text-[34px]">{title}</h2>
        {description && <p class="text-[14px] leading-7 text-mn-muted">{description}</p>}

        <div class="flex flex-wrap gap-2 pt-1">
          <span class="rounded border border-mn-border bg-mn-paper px-3 py-2 text-[12px] text-mn-muted">型号：{model}</span>
          <span class="rounded border border-mn-border bg-mn-paper px-3 py-2 text-[12px] text-mn-muted">
            包装：{packaging}
          </span>
        </div>

        <p class="flex items-start gap-2 pt-1 text-[13px] text-mn-ink">
          <span class="mt-2 size-1 shrink-0 rounded-full bg-mn-muted" aria-hidden="true" />
          {highlight}
        </p>

        <div class="pt-2">
          <Button href={cta.href} withArrow>{cta.label}</Button>
        </div>
      </div>
    </div>
  </Container>
</section>
