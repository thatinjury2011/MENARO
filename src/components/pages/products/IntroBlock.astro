---
import { Image } from 'astro:assets';
import Container from '../../ui/Container.astro';
import Button from '../../ui/Button.astro';
import type { ImageMetadata } from 'astro';

interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  note?: string;
  bullets?: string[];
  chips?: string[];
  image: ImageMetadata;
  imageAlt: string;
  cta?: { label: string; href: string };
}

const { eyebrow, title, description, note, bullets, chips, image, imageAlt, cta } = Astro.props;
---

<section class="bg-base-100 py-14 lg:py-20">
  <Container>
    <div class="grid grid-cols-1 items-center gap-10 lg:grid-cols-2 lg:gap-16">
      <Image
        src={image}
        alt={imageAlt}
        widths={[600, 900, 1186]}
        sizes="(min-width: 1024px) 50vw, 100vw"
        class="w-full rounded-box object-cover"
        loading="lazy"
      />

      <div class="flex flex-col gap-4">
        {eyebrow && <p class="text-[12px] tracking-[0.08em] text-mn-muted uppercase">{eyebrow}</p>}
        <h2 class="text-[26px] leading-tight font-bold tracking-tight text-mn-ink lg:text-[34px]">{title}</h2>
        {description && <p class="text-[14px] leading-7 text-mn-muted">{description}</p>}
        {note && <p class="text-[13px] leading-6 text-mn-muted">{note}</p>}

        {
          bullets && (
            <ul class="flex flex-col gap-2 pt-1">
              {bullets.map((b) => (
                <li class="flex items-start gap-2 text-[14px] text-mn-ink">
                  <span class="mt-2 size-1.5 shrink-0 rounded-full bg-mn-green" aria-hidden="true" />
                  {b}
                </li>
              ))}
            </ul>
          )
        }

        {
          chips && (
            <ul class="flex flex-wrap gap-2 pt-1">
              {chips.map((c) => (
                <li class="rounded border border-mn-border bg-mn-paper px-3 py-2 text-[12px] text-mn-ink">{c}</li>
              ))}
            </ul>
          )
        }

        {
          cta && (
            <div class="pt-2">
              <Button href={cta.href} withArrow>{cta.label}</Button>
            </div>
          )
        }
      </div>
    </div>
  </Container>
</section>
