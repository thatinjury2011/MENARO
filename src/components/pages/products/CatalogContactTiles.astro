---
import { getLangFromUrl, localizePath } from '../../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = {
  zh: { contact: '联系我们', wechat: '微信咨询', contactLabel: '前往联系我们页面', whatsappLabel: '通过 WhatsApp 联系我们' },
  en: { contact: 'Contact us', wechat: 'WeChat', contactLabel: 'Go to the contact page', whatsappLabel: 'Reach us on WhatsApp' },
}[lang];

const whatsappHref = 'https://wa.me/8613738577658';
const tile = 'flex h-[76px] flex-col items-center justify-center gap-[5px] rounded-[12px] bg-[#eef6ef]';
const label = 'text-[12px] leading-[16px] font-bold text-[#054b34]';
---

<div class="grid grid-cols-3 gap-[10px] px-[14px]">
  <a href={localizePath('/contact', lang)} aria-label={t.contactLabel} class={`${tile} transition-colors hover:bg-[#e6f0e8]`}>
    <svg
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.4"
      stroke-linejoin="round"
      class="size-6 text-[#054b34]"
      aria-hidden="true"
    >
      <rect x="2.6" y="5.4" width="18.8" height="13.2" rx="1.2"></rect>
      <path d="m3.4 6.6 8.6 6 8.6-6"></path>
    </svg>
    <span class={label}>{t.contact}</span>
  </a>

  <a
    href={whatsappHref}
    target="_blank"
    rel="noopener noreferrer"
    aria-label={t.whatsappLabel}
    class={`${tile} transition-colors hover:bg-[#e6f0e8]`}
  >
    <svg
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.4"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="size-6 text-[#054b34]"
      aria-hidden="true"
    >
      <path d="M7.1 3.6 5.2 4c-1 .2-1.6 1.1-1.5 2 .6 4.5 2.9 8.6 6.3 11.7 3.1 2.9 7.1 4.7 11.3 5.1 1 .1 1.8-.5 2-1.5l.4-1.9-4.6-1.9-1.7 2.2c-2.8-1.4-5.1-3.6-6.5-6.2l2.2-1.7-1.9-4.6Z"></path>
    </svg>
    <span class={label}>WhatsApp</span>
  </a>

  <div class={tile}>
    <svg
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.3"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="size-6 text-[#054b34]"
      aria-hidden="true"
    >
      <path d="M9.4 3.5c-3.4 0-6.1 2.3-6.1 5.1 0 1.6.9 3 2.3 4l-.7 2 2.4-1.2c.6.1 1.3.2 2.1.2 3.4 0 6.1-2.3 6.1-5s-2.7-5.1-6.1-5.1Z"></path>
      <circle cx="7.3" cy="8" r="0.75" fill="currentColor" stroke="none"></circle>
      <circle cx="11.4" cy="8" r="0.75" fill="currentColor" stroke="none"></circle>
      <path d="M16.4 10.6c-2.7 0-4.9 1.9-4.9 4.2 0 1.3.7 2.5 1.9 3.3l-.5 1.7 2-.9c.5.1 1 .1 1.5.1 2.7 0 4.9-1.9 4.9-4.2s-2.2-4.2-4.9-4.2Z"></path>
      <circle cx="14.7" cy="14.6" r="0.7" fill="currentColor" stroke="none"></circle>
      <circle cx="18.1" cy="14.6" r="0.7" fill="currentColor" stroke="none"></circle>
    </svg>
    <span class={label}>{t.wechat}</span>
  </div>
</div>
