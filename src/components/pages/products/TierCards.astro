---
import { Image } from 'astro:assets';
import Container from '../../ui/Container.astro';
import type { ImageMetadata } from 'astro';

interface Tier {
  name: string;
  code: string;
  subtitle?: string;
  desc: string;
  footer: string;
  image: ImageMetadata;
  accent?: 'gray' | 'green' | 'gold';
}

interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  note?: string;
  footnote?: string;
  tiers: Tier[];
}

const { eyebrow, title, subtitle, note, footnote, tiers } = Astro.props;

const accentBar: Record<NonNullable<Tier['accent']>, string> = {
  gray: 'bg-mn-border',
  green: 'bg-mn-green',
  gold: 'bg-mn-gold',
};
---

<section class="bg-base-200/70 py-14 lg:py-24">
  <Container>
    <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
      <div class="flex flex-col gap-2">
        {eyebrow && <p class="text-[12px] tracking-[0.08em] text-mn-muted">{eyebrow}</p>}
        <h2 class="text-[28px] leading-tight font-bold tracking-tight text-mn-ink lg:text-[40px]">{title}</h2>
        {subtitle && <p class="text-[13px] text-mn-muted">{subtitle}</p>}
      </div>
      {note && <p class="max-w-[520px] text-[13px] leading-6 text-mn-muted lg:text-right">{note}</p>}
    </div>

    <ul class="mt-8 grid grid-cols-1 gap-6 lg:mt-12 lg:grid-cols-3">
      {
        tiers.map((tier) => (
          <li class="flex flex-col overflow-hidden rounded-box border border-mn-border bg-base-100">
            <span class:list={['block h-1', accentBar[tier.accent ?? 'gray']]} aria-hidden="true" />
            <div class="bg-mn-paper px-6 py-5">
              <Image
                src={tier.image}
                alt={tier.name}
                widths={[423, 846]}
                sizes="(min-width: 1024px) 33vw, 100vw"
                class="mx-auto h-[180px] w-auto object-contain"
                loading="lazy"
              />
            </div>
            <div class="flex flex-1 flex-col gap-4 px-6 py-6">
              <div class="flex items-baseline justify-between gap-3">
                <p class="text-xl font-bold tracking-wide text-mn-ink">{tier.name}</p>
                <p class="text-[13px] text-mn-muted">{tier.code}</p>
              </div>
              {tier.subtitle && <p class="-mt-2 text-[13px] font-semibold text-mn-green">{tier.subtitle}</p>}
              <p class="text-[13px] leading-6 text-mn-muted">{tier.desc}</p>
              <p class="mt-auto border-t border-mn-border pt-4 text-[12px] text-mn-muted">{tier.footer}</p>
            </div>
          </li>
        ))
      }
    </ul>

    {
      footnote && (
        <p class="mt-8 text-[12px] leading-6 text-mn-muted">
          {footnote}
        </p>
      )
    }
  </Container>
</section>
