---
import Container from '../../ui/Container.astro';

interface Props {
  eyebrow?: string;
  title: string;
  note?: string;
  items: { title: string; desc: string }[];
}

const { eyebrow, title, note, items } = Astro.props;
---

<section class="bg-base-100 py-14 lg:py-20">
  <Container>
    <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
      <div class="flex flex-col gap-2">
        {eyebrow && <p class="text-[12px] tracking-[0.08em] text-mn-muted">{eyebrow}</p>}
        <h2 class="text-[26px] leading-tight font-bold tracking-tight text-mn-ink lg:text-[34px]">{title}</h2>
      </div>
      {note && <p class="max-w-[520px] text-[13px] leading-6 text-mn-muted lg:text-right">{note}</p>}
    </div>

    <ul class="mt-8 grid grid-cols-1 gap-6 lg:mt-10 lg:grid-cols-2">
      {
        items.map((item) => (
          <li class="flex flex-col gap-3 rounded-box border border-mn-border p-6 lg:p-7">
            <p class="text-[16px] font-semibold text-mn-ink">{item.title}</p>
            <p class="text-[13px] leading-6 text-mn-muted">{item.desc}</p>
          </li>
        ))
      }
    </ul>
  </Container>
</section>
