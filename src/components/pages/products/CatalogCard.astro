---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { getLangFromUrl, localizePath } from '../../../i18n/utils';
import { ui } from '../../../i18n/ui';

interface Item {
  title: string;
  desc: string;
  icon: ImageMetadata;
  href?: string;
}

interface Props {
  index: string;
  title: string;
  description: string;
  banner: ImageMetadata;
  items: Item[];
}

const { index, title, description, banner, items } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const labels = ui[lang];
---

<article class="overflow-hidden rounded-[12px] bg-white">
  <div class="relative min-h-[121px] overflow-hidden">
    <Image src={banner} alt="" widths={[362, 724, 1086]} sizes="362px" class="absolute inset-0 size-full object-cover" />
    <div class="relative flex min-h-[121px] items-center pl-[16px]">
      <span class="shrink-0 font-['Times_New_Roman',_serif] text-[36px] leading-none text-[#054b34]">{index}</span>
      <span class="ml-[10px] h-[56px] w-px shrink-0 bg-[#c9d3cc]" aria-hidden="true" />
      <div class="ml-[18px] min-w-0 flex-1 pr-[70px] max-[389px]:pr-[20px]">
        <h2 class="text-[17px] leading-[1.3] font-bold text-[#054b34]">{title}</h2>
        <p class="mt-[6px] text-[11px] leading-[16px] text-[#064b35]/80">{description}</p>
      </div>
    </div>
  </div>

  <ul>
    {
      items.map((item) => {
        const online = Boolean(item.href);
        const content = (
          <>
            <Image src={item.icon} alt="" width={48} height={48} class="size-[26px] shrink-0 object-contain" loading="lazy" />
            <span class="ml-[18px] min-w-0 flex-1">
              <span class="block text-[14px] leading-[19px] font-bold text-black">{item.title}</span>
              <span class="mt-[4px] block text-[10.5px] leading-[16px] text-[#333]">{item.desc.replace(/、/g, ' · ')}</span>
            </span>
            <span
              class:list={[
                'ml-2 inline-flex h-6 shrink-0 items-center gap-1 rounded-full px-2 text-[11px]',
                online ? 'bg-[#07563d] text-white' : 'bg-[#d6d8d6] text-[#333]',
              ]}
            >
              {online ? (
                <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" class="size-[10px]" aria-hidden="true">
                  <path d="M3.2 8.4 6.4 11.6 12.8 4.8" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              ) : (
                <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" class="size-[10px]" aria-hidden="true">
                  <circle cx="8" cy="8" r="6.2" stroke-width="1.2" />
                  <path d="M8 4.6V8l2.4 1.6" stroke-width="1.2" stroke-linecap="round" />
                </svg>
              )}
              {online ? labels.online : labels.planning}
            </span>
            <svg
              viewBox="0 0 20 20"
              fill="none"
              stroke="currentColor"
              stroke-width="1.4"
              class="ml-[7px] size-3 shrink-0 text-[#054b34]"
              aria-hidden="true"
            >
              <path d="m8 4 6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </>
        );

        return (
          <li class="mx-[15px] border-t border-[#eef0ed] first:border-t-0">
            {online ? (
              <a href={item.href && localizePath(item.href, lang)} class="flex min-h-[73px] items-center py-[9px]">
                {content}
              </a>
            ) : (
              <div class="flex min-h-[73px] items-center py-[9px]">{content}</div>
            )}
          </li>
        );
      })
    }
  </ul>
</article>
