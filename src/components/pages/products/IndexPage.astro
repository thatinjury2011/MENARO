---
import Base from '../../../layouts/Base.astro';
import Container from '../../ui/Container.astro';
import Button from '../../ui/Button.astro';
import Breadcrumb from '../../ui/Breadcrumb.astro';
import InquiryCta from '../../sections/InquiryCta.astro';
import CatalogGroup from './CatalogGroup.astro';
import { getLangFromUrl, localizePath } from '../../../i18n/utils';

import iconTileGrout from '../../../assets/icons/category-tile-grout.webp';
import iconTileAdhesive from '../../../assets/icons/category-tile-adhesive.webp';
import iconSealant from '../../../assets/icons/category-sealant.webp';
import iconFloor from '../../../assets/icons/category-floor.webp';
import iconWaterproof from '../../../assets/icons/category-waterproof.webp';
import iconCoating from '../../../assets/icons/category-coating.webp';
import iconWoodwork from '../../../assets/icons/category-woodwork.webp';
import iconDoors from '../../../assets/icons/category-doors.webp';
import iconFlooring from '../../../assets/icons/category-flooring.webp';
import iconBathware from '../../../assets/icons/category-bathware.webp';
import iconLighting from '../../../assets/icons/category-lighting.webp';
import iconFurniture from '../../../assets/icons/category-furniture.webp';

const lang = getLangFromUrl(Astro.url);

const c = {
  zh: {
    pageTitle: '产品体系',
    eyebrow: 'PRODUCT CATALOG · 产品目录',
    title: '产品体系',
    description:
      '覆盖建筑与装修施工材料、空间成品与定制系统两大板块。已上线系列可直接查看产品资料，规划中系列欢迎就供货与定制需求提前沟通。',
    primary: { label: '获取报价', href: '/quote' },
    secondary: { label: '联系我们', href: '/contact' },
    crumbs: [{ label: '首页', href: '/' }, { label: '产品体系' }],
    groups: [
      {
        index: '01',
        title: '建筑与装修施工材料',
        description:
          '用于建筑及装修施工的铺贴、粘接、密封、防水和表面处理，为住宅、商业及工程项目提供可靠的材料解决方案。',
        items: [
          { title: '美缝与填缝材料', desc: '环氧美缝剂、晶瓷美缝剂、填缝材料', href: '/products/tile-grout' },
          { title: '瓷砖胶与铺贴材料', desc: '瓷砖胶、瓷砖背胶、铺贴辅材', href: '/products/tile-adhesive' },
          { title: '建筑密封胶与结构胶', desc: '玻璃胶、耐候密封胶、结构胶', href: '/products/sealant' },
          { title: '环氧地坪与自流平', desc: '环氧彩砂自流平、环氧地坪', href: '/products/floor' },
          { title: '防水与防护材料', desc: '防水涂料、防水浆料、防护材料' },
          { title: '建筑涂料与艺术漆', desc: '内墙漆、外墙漆、艺术漆、底漆' },
        ],
      },
      {
        index: '02',
        title: '空间成品与定制系统',
        description: '为住宅及商业空间提供可安装、可使用的成品与配套系统，支持标准化采购及个性化定制。',
        items: [
          { title: '全屋定制与木作系统', desc: '橱柜、衣柜、室内木门、墙板、木饰面' },
          { title: '门窗与移门系统', desc: '系统门窗、铝木门窗、联动移门、折叠门' },
          { title: '地板与装饰面料', desc: '实木地板、多层地板、SPC 地板、饰面板' },
          { title: '卫浴洁具与五金配件', desc: '卫浴洁具、龙头花洒、五金配件' },
          { title: '照明与智能控制', desc: '室内照明、商业照明、智能控制' },
          { title: '家具与软装家居', desc: '活动家具、窗帘布艺、家居配饰' },
        ],
      },
    ],
    cta: {
      eyebrow: 'MENARO · 产品与制造合作',
      title: '更多产品与制造合作',
      description: '产品制造、定制生产、项目配套——按你的市场与项目需求确认方案。',
      cta: { label: '联系我们', href: '/contact' },
    },
  },
  en: {
    pageTitle: 'Products',
    eyebrow: 'PRODUCT CATALOG',
    title: 'Products',
    description:
      'Two portfolios: construction and finishing materials, plus interior products and custom systems. Available series link straight to product information; planned series are open for early supply and customisation discussions.',
    primary: { label: 'Get a Quote', href: '/quote' },
    secondary: { label: 'Contact us', href: '/contact' },
    crumbs: [{ label: 'Home', href: '/' }, { label: 'Products' }],
    groups: [
      {
        index: '01',
        title: 'Construction & finishing materials',
        description:
          'Installation, bonding, sealing, waterproofing and surface finishing for residential, commercial and engineering projects.',
        items: [
          { title: 'Tile grout & jointing', desc: 'Epoxy grout, ceramic grout, joint fillers', href: '/products/tile-grout' },
          { title: 'Tile adhesive & installation', desc: 'Tile adhesive, tile back glue, installation accessories', href: '/products/tile-adhesive' },
          { title: 'Sealants & structural adhesives', desc: 'Glass sealant, weatherproof sealant, structural adhesive', href: '/products/sealant' },
          { title: 'Epoxy flooring & self-levelling', desc: 'Epoxy coloured sand self-levelling, epoxy floor coatings', href: '/products/floor' },
          { title: 'Waterproofing & protection', desc: 'Waterproof coatings, waterproof slurry, protective materials' },
          { title: 'Architectural & decorative coatings', desc: 'Interior paint, exterior paint, decorative paint, primer' },
        ],
      },
      {
        index: '02',
        title: 'Interior products & custom systems',
        description:
          'Installable, ready-to-use products and systems for residential and commercial spaces, available as standard supply or customised projects.',
        items: [
          { title: 'Whole-house customisation & joinery', desc: 'Cabinets, wardrobes, interior doors, wall panels, veneers' },
          { title: 'Doors, windows & sliding systems', desc: 'System windows, aluminium-wood windows, sliding and folding doors' },
          { title: 'Flooring & decorative panels', desc: 'Solid wood, engineered and SPC flooring, decorative panels' },
          { title: 'Sanitary ware & hardware', desc: 'Sanitary ware, faucets and showers, hardware' },
          { title: 'Lighting & smart control', desc: 'Residential lighting, commercial lighting, smart control' },
          { title: 'Furniture & soft furnishing', desc: 'Loose furniture, curtains and fabrics, home accessories' },
        ],
      },
    ],
    cta: {
      eyebrow: 'MENARO · PRODUCTS & MANUFACTURING',
      title: 'More products and manufacturing cooperation',
      description: 'Product manufacturing, custom production and project supply — scoped to your market and project requirements.',
      cta: { label: 'Contact us', href: '/contact' },
    },
  },
}[lang];

const constructionIcons = [iconTileGrout, iconTileAdhesive, iconSealant, iconFloor, iconWaterproof, iconCoating];
const interiorIcons = [iconWoodwork, iconDoors, iconFlooring, iconBathware, iconLighting, iconFurniture];
const groupIcons = [constructionIcons, interiorIcons];
const groups = c.groups.map((group, gi) => ({
  ...group,
  items: group.items.map((item, i) => ({ ...item, icon: groupIcons[gi][i] })),
}));
---

<Base title={c.pageTitle}>
  <section class="bg-base-100 pt-14 pb-10 lg:pt-20 lg:pb-14">
    <Container>
      <div class="flex flex-col gap-5 lg:flex-row lg:items-end lg:justify-between">
        <div class="flex max-w-[720px] flex-col gap-4">
          <p class="text-[12px] tracking-[0.08em] text-mn-muted">{c.eyebrow}</p>
          <h1 class="text-[32px] leading-tight font-bold tracking-tight text-mn-ink lg:text-[44px]">{c.title}</h1>
          <p class="text-[14px] leading-7 text-mn-muted">{c.description}</p>
        </div>
        <div class="flex flex-wrap gap-4">
          <Button href={localizePath(c.primary.href, lang)} withArrow class="min-w-[168px] justify-between">
            {c.primary.label}
          </Button>
          <Button
            href={localizePath(c.secondary.href, lang)}
            variant="outline"
            withArrow
            class="min-w-[168px] justify-between"
          >
            {c.secondary.label}
          </Button>
        </div>
      </div>
    </Container>
  </section>

  <Breadcrumb items={c.crumbs} />

  <div class="bg-base-100 py-6 lg:py-10">
    <Container>
      {
        groups.map((group) => (
          <CatalogGroup index={group.index} title={group.title} description={group.description} items={group.items} />
        ))
      }
    </Container>
  </div>

  <InquiryCta eyebrow={c.cta.eyebrow} title={c.cta.title} description={c.cta.description} cta={c.cta.cta} />
</Base>