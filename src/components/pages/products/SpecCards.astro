---
import { Image } from 'astro:assets';
import Container from '../../ui/Container.astro';
import type { ImageMetadata } from 'astro';

interface Props {
  title: string;
  note?: string;
  cards: { title: string; desc: string; image: ImageMetadata }[];
}

const { title, note, cards } = Astro.props;
---

<section class="bg-base-200/70 py-14 lg:py-24">
  <Container>
    <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
      <h2 class="text-[28px] leading-tight font-bold tracking-tight text-mn-ink lg:text-[40px]">{title}</h2>
      {note && <p class="max-w-[520px] text-[13px] leading-6 text-mn-muted lg:text-right">{note}</p>}
    </div>

    <ul class="mt-8 grid grid-cols-1 gap-6 lg:mt-12 lg:grid-cols-3">
      {
        cards.map((card) => (
          <li class="flex flex-col overflow-hidden rounded-box bg-base-100">
            <div class="bg-mn-paper px-6 py-8">
              <Image
                src={card.image}
                alt={card.title}
                widths={[404, 808]}
                sizes="(min-width: 1024px) 33vw, 100vw"
                class="mx-auto h-[260px] w-auto object-contain"
                loading="lazy"
              />
            </div>
            <div class="flex flex-1 flex-col gap-2 p-6">
              <p class="text-[15px] font-bold text-mn-ink">{card.title}</p>
              <p class="text-[13px] leading-6 text-mn-muted">{card.desc}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </Container>
</section>
