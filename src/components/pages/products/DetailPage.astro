---
import Base from '../../../layouts/Base.astro';
import PageHero from '../../sections/PageHero.astro';
import InquiryCta from '../../sections/InquiryCta.astro';
import Breadcrumb from '../../ui/Breadcrumb.astro';
import ProductShowcase from './ProductShowcase.astro';
import SpecCards from './SpecCards.astro';
import { getLangFromUrl, localizePath } from '../../../i18n/utils';
import type { ProductDetail } from '../../../data/product-details';

interface Props {
  product: ProductDetail;
}

const { product } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const c = product[lang];
const seriesHref = localizePath(`/products/${product.series}`, lang);

const text = {
  zh: {
    eyebrow: '产品详情',
    primary: { label: '询价与合作', href: '/contact' },
    secondary: { label: '返回产品中心', href: seriesHref },
    crumbs: ['首页', '产品体系'],
    showcaseEyebrow: '产品详情',
    caption: '包装概念参考',
    cta: { label: '获取批发报价', href: '/quote' },
    specTitle: '产品规格与采购信息',
    specNote: '提供所需规格、采购数量和目的地，即可咨询产品资料与供货报价。',
    ctaBand: {
      eyebrow: '欢迎与 MENARO 建立合作',
      title: '让合适的产品更快进入你的采购链',
      description: '欢迎就产品、包装、定制与采购需求与我们联系。',
      cta: { label: '提交采购询盘', href: '/contact' },
    },
  },
  en: {
    eyebrow: 'Product detail',
    primary: { label: 'Enquire & cooperate', href: '/contact' },
    secondary: { label: 'Back to products', href: seriesHref },
    crumbs: ['Home', 'Products'],
    showcaseEyebrow: 'Product detail',
    caption: 'Packaging reference',
    cta: { label: 'Request a wholesale quote', href: '/quote' },
    specTitle: 'Product specifications and procurement',
    specNote: 'Share the required specification, quantity and destination to request product documents and a supply quotation.',
    ctaBand: {
      eyebrow: 'Work with MENARO',
      title: 'Bring the right products into your supply chain faster',
      description: 'Talk to us about products, packaging, customisation and procurement.',
      cta: { label: 'Send an enquiry', href: '/contact' },
    },
  },
}[lang];

const cards = c.cards.map((card, i) => ({ ...card, image: product.gallery[i] }));

const seriesCategory = {
  'tile-grout': { zh: '美缝与填缝材料', en: 'Tile grout & jointing' },
  'tile-adhesive': { zh: '瓷砖胶与铺贴材料', en: 'Tile adhesive & installation' },
  sealant: { zh: '建筑密封胶与结构胶', en: 'Sealants & structural adhesives' },
  floor: { zh: '环氧地坪与自流平', en: 'Epoxy flooring & self-levelling' },
}[product.series];

const jsonLd = {
  '@type': 'Product',
  '@id': `${Astro.site ? new URL(Astro.url.pathname, Astro.site).href : Astro.url.href}#product`,
  name: c.title,
  description: c.description,
  sku: c.model,
  mpn: c.model,
  category: seriesCategory?.[lang] ?? product.series,
  url: Astro.site ? new URL(Astro.url.pathname, Astro.site).href : Astro.url.href,
  image: product.showcase.src ? [new URL(product.showcase.src, Astro.site ?? Astro.url).href] : undefined,
  brand: { '@type': 'Brand', name: 'MENARO' },
  manufacturer: { '@id': Astro.site ? new URL('/#organization', Astro.site).href : undefined },
  additionalProperty: [
    { '@type': 'PropertyValue', name: 'Model', value: c.model },
    { '@type': 'PropertyValue', name: 'Packaging', value: c.packaging },
  ],
};
---

<Base title={c.title} type="product" jsonLd={jsonLd}>
  <PageHero
    eyebrow={text.eyebrow}
    title={c.title}
    description={c.description}
    image={product.hero}
    imageAlt={c.heroAlt}
    primary={text.primary}
    secondary={text.secondary}
  />

  <Breadcrumb items={[...text.crumbs.map((label, i) => ({ label, href: i === 0 ? '/' : '/products' })), { label: c.title }]} />

  <ProductShowcase
    eyebrow={text.showcaseEyebrow}
    caption={text.caption}
    title={c.title}
    description={c.description}
    model={c.model}
    packaging={c.packaging}
    highlight={c.highlight}
    image={product.showcase}
    imageAlt={c.showcaseAlt}
    cta={text.cta}
  />

  <SpecCards title={text.specTitle} note={text.specNote} cards={cards} />

  <InquiryCta
    eyebrow={text.ctaBand.eyebrow}
    title={text.ctaBand.title}
    description={text.ctaBand.description}
    cta={text.ctaBand.cta}
  />
</Base>