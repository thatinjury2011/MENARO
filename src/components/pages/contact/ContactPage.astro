---
import Base from '../../../layouts/Base.astro';
import Container from '../../ui/Container.astro';
import Breadcrumb from '../../ui/Breadcrumb.astro';
import ContactHero from './ContactHero.astro';
import ContactCard from './ContactCard.astro';
import ContactForm from './ContactForm.astro';
import { getLangFromUrl } from '../../../i18n/utils';

import hero from '../../../assets/contact/hero.webp';
import photo from '../../../assets/contact/photo.webp';

import iconAddress from '../../../assets/icons/contact-address.webp';
import iconPhone from '../../../assets/icons/contact-phone.webp';
import iconWhatsapp from '../../../assets/icons/contact-whatsapp.webp';
import iconMail from '../../../assets/icons/contact-mail.webp';
import iconTime from '../../../assets/icons/contact-time.webp';

const lang = getLangFromUrl(Astro.url);

const c = {
  zh: {
    pageTitle: '联系我们',
    hero: {
      eyebrow: '商务询盘',
      title: '联系我们',
      description: '咨询产品资料、包装规格、样品与报价，请留下采购需求和联系方式。',
      imageAlt: 'MENARO 品牌空间与产品应用',
    },
    crumbs: [{ label: '首页', href: '/' }, { label: '联系我们' }],
    card: {
      eyebrow: '开始沟通',
      title: '告诉我们您的采购需求',
      paragraph:
        '无论您是需要产品资料、包装规格、样品测试，还是定制化解决方案，\n我们都将根据您的市场需求，提供合适的产品方案与专业的报价支持。',
      photoAlt: 'MENARO 商务洽谈',
      address: '中国 · 浙江 · 台州',
      addressNote: '欢迎与我们联系，获取产品资料与报价。',
      items: [
        { label: '电话', value: '+86 576 8853 9555（工作时间 9:00 - 18:00）', href: 'tel:+8657688539555' },
        { label: 'WhatsApp', value: '+86 188 5760 1234（可直接添加联系）', href: 'https://wa.me/8618857601234' },
        { label: '企业邮箱', value: 'info@menarobm.com', href: 'mailto:info@menarobm.com' },
        { label: '工作时间（北京时间）', value: '周一至周五 9:00 - 18:00' },
      ],
    },
    form: {
      eyebrow: '产品询盘',
      title: '提交询盘',
      requiredNote: '带 * 为必填。邮箱和 WhatsApp 至少填写一项。',
      note: '请留下联系人、国家/地区、意向产品，以及邮箱或 WhatsApp 中至少一种联系方式。',
      submit: '提交采购询盘',
    },
  },
  en: {
    pageTitle: 'Contact us',
    hero: {
      eyebrow: 'Business enquiry',
      title: 'Contact us',
      description:
        'For product documents, packaging specifications, samples and pricing, leave your requirements and contact details.',
      imageAlt: 'MENARO brand space and product applications',
    },
    crumbs: [{ label: 'Home', href: '/' }, { label: 'Contact' }],
    card: {
      eyebrow: 'Start a conversation',
      title: 'Tell us what you need to source',
      paragraph:
        'Whether you need product documents, packaging specifications, sample testing or a tailored solution, we will propose the right products and provide professional quotation support for your market.',
      photoAlt: 'MENARO business discussion',
      address: 'Taizhou, Zhejiang, China',
      addressNote: 'Get in touch for product documents and pricing.',
      items: [
        { label: 'Phone', value: '+86 576 8853 9555 (9:00 - 18:00 CST)', href: 'tel:+8657688539555' },
        { label: 'WhatsApp', value: '+86 188 5760 1234 (add us directly)', href: 'https://wa.me/8618857601234' },
        { label: 'Email', value: 'info@menarobm.com', href: 'mailto:info@menarobm.com' },
        { label: 'Business hours (Beijing time)', value: 'Monday to Friday, 9:00 - 18:00' },
      ],
    },
    form: {
      eyebrow: 'Product enquiry',
      title: 'Send an enquiry',
      requiredNote: '* Required. Provide at least one of email or WhatsApp.',
      note: 'Please include a contact person, country/region and products of interest, plus at least one of email or WhatsApp.',
      submit: 'Send an enquiry',
    },
  },
}[lang];

const icons = [iconPhone, iconWhatsapp, iconMail, iconTime];
const items = c.card.items.map((item, i) => ({ ...item, icon: icons[i] }));
---

<Base title={c.pageTitle} footerTheme="dark">
  <ContactHero
    eyebrow={c.hero.eyebrow}
    title={c.hero.title}
    description={c.hero.description}
    image={hero}
    imageAlt={c.hero.imageAlt}
  />

  <Breadcrumb items={c.crumbs} width="default" space="compact" />

  <section class="bg-base-100 pb-12 lg:pt-[11px] lg:pb-[47px]">
    <Container>
      <div class="grid grid-cols-1 gap-6 lg:grid-cols-[minmax(0,793fr)_minmax(0,885fr)] lg:gap-[28px]">
        <ContactCard
          eyebrow={c.card.eyebrow}
          title={c.card.title}
          paragraphs={[c.card.paragraph]}
          photo={photo}
          photoAlt={c.card.photoAlt}
          address={c.card.address}
          addressNote={c.card.addressNote}
          addressIcon={iconAddress}
          items={items}
        />

        <ContactForm
          eyebrow={c.form.eyebrow}
          title={c.form.title}
          requiredNote={c.form.requiredNote}
          note={c.form.note}
          submitLabel={c.form.submit}
        />
      </div>
    </Container>
  </section>
</Base>
