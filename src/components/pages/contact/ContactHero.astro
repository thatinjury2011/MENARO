---
import { Image } from 'astro:assets';
import Container from '../../ui/Container.astro';
import type { ImageMetadata } from 'astro';

interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  image: ImageMetadata;
  imageAlt: string;
}

const { eyebrow, title, description, image, imageAlt } = Astro.props;
---

<section class="relative isolate overflow-hidden bg-base-200">
  <Image
    src={image}
    alt={imageAlt}
    widths={[640, 960, 1440, 1920]}
    sizes="100vw"
    class="absolute inset-0 h-full w-full object-cover object-center"
    loading="eager"
    fetchpriority="high"
  />
  <div class="absolute inset-0 bg-white/85 lg:hidden"></div>

  <Container class="relative">
    <div class="flex flex-col py-12 lg:pt-[95px] lg:pb-[113px]">
      {
        eyebrow && (
          <p class="text-[15px] font-bold tracking-wide text-mn-ink lg:text-[19px] lg:leading-[32px] lg:tracking-normal">
            {eyebrow}
          </p>
        )
      }
      <h1 class="mt-2 text-[34px] leading-[1.15] font-bold tracking-tight text-mn-ink lg:mt-0 lg:text-[75px] lg:leading-[102px]">
        {title}
      </h1>
      {
        description && (
          <p class="mt-3 max-w-[760px] text-[15px] leading-7 text-mn-muted lg:mt-[22px] lg:text-[23px] lg:leading-[38px] lg:text-[#34483b]">
            {description}
          </p>
        )
      }
    </div>
  </Container>
</section>
