---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { getLangFromUrl } from '../../../i18n/utils';

interface InfoItem {
  icon: ImageMetadata;
  label: string;
  value: string;
  href?: string;
}

interface Props {
  eyebrow: string;
  title: string;
  paragraphs: string[];
  photo: ImageMetadata;
  photoAlt: string;
  address: string;
  addressNote: string;
  addressIcon: ImageMetadata;
  items: InfoItem[];
}

const { eyebrow, title, paragraphs, photo, photoAlt, address, addressNote, addressIcon, items } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const heading = { zh: '联系我们', en: 'Contact us' }[lang];

const rows = [
  { icon: addressIcon, label: address, value: addressNote, href: undefined },
  ...items,
];
---

<div class="flex h-full flex-col rounded-[3px] bg-[#edf4ef] px-6 pt-8 pb-10 lg:px-0 lg:pl-[38px] lg:pr-[48px] lg:pt-[32px] lg:pb-[40px]">
  <p class="text-[14px] font-bold tracking-wide text-mn-ink lg:text-[17.5px] lg:leading-[31px] lg:tracking-normal">
    {eyebrow}
  </p>
  <h2 class="mt-2 text-[26px] leading-[1.2] font-bold tracking-tight text-mn-ink lg:mt-[6px] lg:text-[47px] lg:leading-[70px]">
    {title}
  </h2>
  <div class="mt-3 flex flex-col lg:mt-[13px]">
    {
      paragraphs.map((p) => (
        <p class="whitespace-pre-line text-[15px] leading-7 text-mn-muted lg:text-[20.5px] lg:leading-[35px]">{p}</p>
      ))
    }
  </div>

  <Image
    src={photo}
    alt={photoAlt}
    widths={[400, 706, 1060]}
    sizes="(min-width: 1024px) 705px, 100vw"
    class="mt-5 aspect-[705/423] w-full rounded-[4px] object-cover lg:mt-[25px]"
    loading="lazy"
  />

  <div class="mt-6 h-px w-full bg-[#c4d1c7] lg:mt-[32px]"></div>
  <p class="mt-3 text-[20px] font-bold text-mn-ink lg:mt-[12px] lg:text-[29px] lg:leading-[45px]">{heading}</p>

  <ul class="mt-4 flex flex-col gap-4 lg:mt-[14px] lg:gap-[16px]">
    {
      rows.map((row) => {
        const body = (
          <>
            <Image
              src={row.icon}
              alt=""
              width={62}
              height={62}
              class="size-9 shrink-0 object-contain lg:size-[61px]"
              loading="lazy"
            />
            <span class="flex flex-col">
              <span class="text-[15px] leading-[24px] font-bold text-mn-ink lg:text-[20.5px] lg:leading-[31px]">
                {row.label}
              </span>
              <span class="text-[14px] leading-[24px] text-mn-muted lg:text-[20.5px] lg:leading-[31px]">{row.value}</span>
            </span>
          </>
        );
        return (
          <li>
            {row.href ? (
              <a href={row.href} class="flex items-center gap-3.5 lg:gap-[25px]">
                {body}
              </a>
            ) : (
              <div class="flex items-center gap-3.5 lg:gap-[25px]">{body}</div>
            )}
          </li>
        );
      })
    }
  </ul>
</div>
