---
import Base from '../../../layouts/Base.astro';
import Container from '../../ui/Container.astro';
import QuoteHero from './QuoteHero.astro';
import WhyCard from './WhyCard.astro';
import QuoteForm from './QuoteForm.astro';
import QuoteSteps from './QuoteSteps.astro';
import { getLangFromUrl } from '../../../i18n/utils';

import hero from '../../../assets/quote/hero.webp';
import why from '../../../assets/quote/why.webp';

import iconShield from '../../../assets/icons/value-shield.webp';
import iconLayers from '../../../assets/icons/layers-outline.webp';
import iconGlobe from '../../../assets/icons/form-globe.webp';
import processDoc from '../../../assets/icons/process-01.webp';
import processBox from '../../../assets/icons/process-02.webp';
import processSupport from '../../../assets/icons/process-03.webp';
import ContentScale from '../../ui/ContentScale.astro';

const lang = getLangFromUrl(Astro.url);

const c = {
  zh: {
    pageTitle: '获取报价',
    hero: {
      eyebrow: '获取报价',
      title: '获取报价',
      description: '告诉我们您的采购需求，我们将为您提供合适的产品\n方案、报价和服务支持。',
      imageAlt: 'MENARO 产品系列',
      highlights: [
        { title: '源头品质', desc: '稳定可靠' },
        { title: '产品齐全', desc: '应用广泛' },
        { title: '全球供应', desc: '专业支持' },
      ],
    },
    why: {
      lines: ['为什么选择', 'MENARO美纳罗？'],
      imageAlt: 'MENARO 产品应用空间',
      items: ['专业的产品解决方案', '灵活的包装与OEM/ODM', '稳定的供货与交付', '面向全球的服务支持'],
    },
    form: {
      title: '获取报价',
      requiredNote: '* 为必填项',
      submit: '获取报价',
    },
    steps: {
      title: '询价流程',
      subtitle: '简单 · 高效 · 专业',
      items: [
        { title: '提交需求', desc: '填写并提交询盘信息' },
        { title: '专人联系', desc: '我们的团队将尽快与您联系' },
        { title: '提供方案与报价', desc: '根据您的需求提供产品方案与报价' },
        { title: '确认合作', desc: '确定产品、数量与交付安排' },
      ],
    },
  },
  en: {
    pageTitle: 'Get a quote',
    hero: {
      eyebrow: 'Get a quote',
      title: 'Get a quote',
      description: 'Tell us what you need and we will propose the right products,\npricing and service support.',
      imageAlt: 'MENARO product range',
      highlights: [
        { title: 'Source quality', desc: 'Stable and reliable' },
        { title: 'Full range', desc: 'Wide applications' },
        { title: 'Global supply', desc: 'Professional support' },
      ],
    },
    why: {
      lines: ['Why choose', 'MENARO?'],
      imageAlt: 'MENARO products in application',
      items: [
        'Professional product solutions',
        'Flexible packaging and OEM/ODM',
        'Stable supply and delivery',
        'Worldwide service support',
      ],
    },
    form: {
      title: 'Get a quote',
      requiredNote: '* Required fields',
      submit: 'Get a quote',
    },
    steps: {
      title: 'How quoting works',
      subtitle: 'Simple · Efficient · Professional',
      items: [
        { title: 'Send your requirements', desc: 'Complete and submit the enquiry form' },
        { title: 'We get in touch', desc: 'Our team will contact you shortly' },
        { title: 'Solution and quotation', desc: 'We propose products and pricing to your needs' },
        { title: 'Confirm the order', desc: 'Products, quantities and delivery are agreed' },
      ],
    },
  },
}[lang];

const highlightIcons = [iconShield, iconLayers, iconGlobe];
const highlights = c.hero.highlights.map((item, i) => ({ ...item, icon: highlightIcons[i] }));
// 导出稿里第 1 步与第 3 步共用同一个「文档」图标
const stepIcons = [processDoc, processSupport, processDoc, processBox];
const steps = c.steps.items.map((item, i) => ({ ...item, icon: stepIcons[i] }));
---

<Base title={c.pageTitle} footerTheme="dark">
  <QuoteHero
    eyebrow={c.hero.eyebrow}
    title={c.hero.title}
    description={c.hero.description}
    image={hero}
    imageAlt={c.hero.imageAlt}
    highlights={highlights}
  />
  <ContentScale>
    <section class="bg-base-100 pb-12 lg:pt-[74px] lg:pb-[75px]">
      <Container width="narrow">
        <div class="grid grid-cols-1 gap-6 lg:grid-cols-[471px_minmax(0,1fr)] lg:gap-[29px]">
          <WhyCard lines={c.why.lines} items={c.why.items} image={why} imageAlt={c.why.imageAlt} />

          <QuoteForm
            title={c.form.title}
            requiredNote={c.form.requiredNote}
            submitLabel={c.form.submit}
          />
        </div>
      </Container>
    </section>

    <QuoteSteps title={c.steps.title} subtitle={c.steps.subtitle} steps={steps} />
  </ContentScale>
</Base>
