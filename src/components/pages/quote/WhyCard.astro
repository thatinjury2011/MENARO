---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import check from '../../../assets/icons/why-01.webp';

interface Props {
  /** 标题按导出稿分两行（第二行含品牌名） */
  lines: string[];
  items: string[];
  image: ImageMetadata;
  imageAlt: string;
}

const { lines, items, image, imageAlt } = Astro.props;
---

<div class="flex h-full flex-col overflow-hidden rounded-[5px] bg-[#083c30]">
  <div class="relative shrink-0">
    <Image
      src={image}
      alt={imageAlt}
      widths={[471, 942]}
      sizes="(min-width: 1024px) 471px, 100vw"
      class="aspect-[471/556] w-full object-cover"
      loading="lazy"
    />
    <span
      aria-hidden="true"
      class="absolute inset-x-0 bottom-0 h-[90px] bg-linear-to-b from-transparent to-[#083c30]"
    ></span>
  </div>

  <div class="flex flex-1 flex-col px-6 pb-10 text-white lg:px-[56px] lg:pb-[48px]">
    <h2
      class="-mt-2 text-[24px] leading-[1.15] font-bold tracking-[0.04em] lg:-mt-[7px] lg:text-[36px] lg:leading-[42px] lg:tracking-[1.44px]"
    >
      {lines.map((line, i) => (
        <>
          {i > 0 && <br />}
          {line}
        </>
      ))}
    </h2>

    <ul class="mt-6 flex flex-col gap-6 lg:mt-[48px] lg:gap-[51px] lg:pl-[24px]">
      {
        items.map((item) => (
          <li class="flex items-center gap-4 lg:gap-[33px]">
            <Image src={check} alt="" width={26} height={26} class="size-6 shrink-0 object-contain" loading="lazy" />
            <span class="text-[16px] leading-[27px] font-bold lg:text-[18px] lg:leading-[27px]">{item}</span>
          </li>
        ))
      }
    </ul>
  </div>
</div>
