---
import { Image } from 'astro:assets';
import Container from '../../ui/Container.astro';
import type { ImageMetadata } from 'astro';

interface Highlight {
  title: string;
  desc: string;
  icon: ImageMetadata;
}

interface Props {
  eyebrow: string;
  title: string;
  description: string;
  image: ImageMetadata;
  imageAlt: string;
  highlights: Highlight[];
}

const { eyebrow, title, description, image, imageAlt, highlights } = Astro.props;
---

<section class="relative isolate overflow-hidden bg-base-200">
  <Image
    src={image}
    alt={imageAlt}
    widths={[640, 960, 1440, 1920]}
    sizes="100vw"
    class="absolute inset-0 h-full w-full object-cover object-center"
    loading="eager"
    fetchpriority="high"
  />
  <div class="absolute inset-0 bg-white/85 lg:hidden"></div>

  <Container width="narrow" class="relative">
    <div class="flex flex-col py-12 lg:pt-[97px] lg:pb-[96px]">
      <p class="text-[14px] font-bold tracking-wide text-mn-ink lg:text-[18px] lg:leading-[27px]">{eyebrow}</p>
      <h1 class="mt-2 text-[32px] leading-[1.15] font-bold tracking-tight text-mn-ink lg:mt-[36px] lg:text-[64px] lg:leading-[93px]">
        {title}
      </h1>
      <p class="mt-3 max-w-[560px] whitespace-pre-line text-[15px] leading-7 text-mn-muted lg:mt-[15px] lg:text-[18px] lg:leading-[41px]">
        {description}
      </p>
      <span aria-hidden="true" class="mt-5 block h-[3px] w-[72px] bg-[#093929] lg:mt-[26px]"></span>

      <ul class="mt-6 flex flex-wrap items-center gap-y-4 lg:mt-[45px] lg:pl-[4px]">
        {
          highlights.map((item, i) => (
            <>
              {i > 0 && <li aria-hidden="true" class="mx-4 hidden h-[22px] w-px bg-[#c9cfc9] lg:mx-[60px] lg:block" />}
              <li class="flex w-[72px] flex-col items-center text-center whitespace-nowrap lg:w-auto lg:min-w-[72px]">
                <Image
                  src={item.icon}
                  alt=""
                  width={39}
                  height={39}
                  class="size-[39px] object-contain"
                  loading="lazy"
                />
                <span class="mt-[13px] flex flex-col text-[16px] leading-[20px] font-bold text-mn-ink lg:text-[18px]">
                  <span>{item.title}</span>
                  <span>{item.desc}</span>
                </span>
              </li>
            </>
          ))
        }
      </ul>
    </div>
  </Container>
</section>
