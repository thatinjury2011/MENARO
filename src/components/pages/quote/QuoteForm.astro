---
import Button from '../../ui/Button.astro';
import { getLangFromUrl } from '../../../i18n/utils';
import { inquiryForm } from '../../../data/inquiry-form';

import user from '../../../assets/icons/form-user.webp';
import mail from '../../../assets/icons/form-mail.webp';
import globe from '../../../assets/icons/form-globe.webp';
import whatsapp from '../../../assets/icons/form-whatsapp.webp';
import company from '../../../assets/icons/form-company.webp';
import box from '../../../assets/icons/form-box.webp';
import pencil from '../../../assets/icons/form-pencil.webp';

interface Props {
  title: string;
  requiredNote: string;
  submitLabel: string;
}

const { title, requiredNote, submitLabel } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = inquiryForm[lang];

const fieldClass =
  'h-[44px] w-full border border-[#cfd3cd] bg-white pr-3 pl-11 text-[15px] text-mn-ink outline-none transition-colors placeholder:text-mn-muted focus:border-mn-green lg:h-[58px] lg:pr-4 lg:pl-[40px] lg:text-[18px]';
const labelClass = 'text-[15px] font-bold text-mn-ink lg:text-[18px] lg:leading-[27px]';
const rowClass = 'flex flex-col gap-1.5 lg:gap-[8px]';

const fields = [
  { name: 'name', label: t.nameQuote, icon: user, placeholder: t.nameQuotePlaceholder, type: 'text', required: true },
  { name: 'email', label: t.email, icon: mail, placeholder: t.emailQuotePlaceholder, type: 'email', required: true },
  { name: 'country', label: t.country, icon: globe, placeholder: t.countryQuotePlaceholder, type: 'select', required: true },
  { name: 'whatsapp', label: 'WhatsApp', icon: whatsapp, placeholder: t.whatsappQuotePlaceholder, type: 'tel', required: true },
  { name: 'company', label: t.company, icon: company, placeholder: t.companyPlaceholder, type: 'text', wide: true },
  { name: 'quantity', label: t.quantity, icon: box, placeholder: t.quantityPlaceholder, type: 'text' },
  { name: 'message', label: t.messageQuote, icon: pencil, placeholder: t.messageQuotePlaceholder, type: 'text' },
];
---

<form
  class="flex h-full flex-col border border-[#dddddd] bg-white px-6 pt-6 pb-8 lg:px-[52px] lg:pt-[32px] lg:pb-[31px]"
  action="#"
  method="post"
  novalidate
>
  <div class="flex flex-wrap items-end justify-between gap-2">
    <h2 class="text-[26px] leading-[1.3] font-bold tracking-tight text-mn-ink lg:text-[40px] lg:leading-[52px]">
      {title}
    </h2>
    <p class="text-[13px] text-mn-muted lg:mb-[9px] lg:text-[18px] lg:leading-[27px]">{requiredNote}</p>
  </div>

  <fieldset class="mt-5 flex flex-col lg:mt-[26px]">
    <legend class:list={[labelClass, 'mb-1.5 lg:mb-[15px]']}>
      {t.productsLabel} <span class="text-[#bd695b]">*</span>
    </legend>

    <div class="flex flex-col gap-3">
      {
        t.groups.map((group) => (
          <div class="bg-[#fbfcfa]">
            <p class="flex h-[44px] items-center bg-[#edf4ef]/60 px-4 text-[15px] font-medium text-[#12372c] lg:h-[54px] lg:px-[18px] lg:text-[18px]">
              {group.index} {group.name}
            </p>
            <div class="grid grid-cols-1 gap-x-[8px] gap-y-2 px-4 py-3 sm:grid-cols-2 lg:px-[18px] lg:pb-[13px] lg:pt-[12px]">
              {group.items.map((item, i) => (
                <label class="flex cursor-pointer items-center gap-3">
                  <input type="checkbox" name={`product-${group.index}`} value={item} class="peer sr-only" />
                  <span class="relative size-[22px] shrink-0 rounded-[4px] border-[1.5px] border-[#578b73] bg-white transition-colors peer-checked:border-mn-green peer-checked:bg-mn-green peer-checked:[&>svg]:opacity-100 peer-focus-visible:outline peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-mn-focus lg:size-[24px]">
                    <svg
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="3"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      class="absolute inset-0 size-full p-[4px] text-white opacity-0 transition-opacity"
                    >
                      <path d="M4 12.5 9.5 18 20 6.5" />
                    </svg>
                  </span>
                  <span class="text-[15px] leading-[26px] text-[#052c23] lg:text-[18px] lg:leading-[32px]">{item}</span>
                  {group.planned[i] && (
                    <span class="inline-flex shrink-0 items-center gap-[6px] rounded-full bg-[#d7d9d6]/60 px-[6px] py-[2px] text-[11px] text-[#333] lg:text-[12px]">
                      <svg viewBox="0 0 12 12" fill="none" class="size-3 shrink-0" aria-hidden="true">
                        <circle cx="6" cy="6" r="5" stroke="currentColor" stroke-width="1.2" />
                        <circle cx="6" cy="6" r="1.6" fill="currentColor" />
                      </svg>
                      {t.planned}
                    </span>
                  )}
                </label>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </fieldset>

  <div class="mt-5 grid grid-cols-1 gap-x-[22px] gap-y-4 sm:grid-cols-2 lg:mt-[21px] lg:gap-y-[23px]">
    {
      fields.map((f) => (
        <label class:list={[rowClass, f.wide && 'sm:col-span-2']}>
          <span class={labelClass}>
            {f.label} {f.required && <span class="text-[#bd695b]">*</span>}
          </span>
          <span class="relative block">
            <span class="pointer-events-none absolute top-1/2 left-3.5 -translate-y-1/2 lg:left-[10px]">
              <img src={f.icon.src} alt="" width="22" height="22" class="size-[18px] object-contain lg:size-[22px]" />
            </span>
            {f.type === 'select' ? (
              <>
                <select name={f.name} required class:list={[fieldClass, 'appearance-none']}>
                  <option value="">{f.placeholder}</option>
                  {t.countries.map((c) => (
                    <option value={c}>{c}</option>
                  ))}
                </select>
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="pointer-events-none absolute top-1/2 right-4 size-4 -translate-y-1/2 text-mn-ink lg:size-6"
                  aria-hidden="true"
                >
                  <path d="m6 9 6 6 6-6" />
                </svg>
              </>
            ) : (
              <input
                type={f.type}
                name={f.name}
                required={f.required}
                placeholder={f.placeholder}
                class={fieldClass}
              />
            )}
          </span>
        </label>
      ))
    }
  </div>

  <div class="mt-5 lg:mt-[43px]">
    <Button
      type="submit"
      withArrow
      class="w-full justify-center gap-[25px] px-[35px] [&>svg]:size-[22px] lg:h-[67px] lg:text-[20px]"
    >
      {submitLabel}
    </Button>
  </div>
</form>
