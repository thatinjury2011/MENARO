---
import Container from '../../ui/Container.astro';

interface Partner {
  title: string;
  desc: string;
}

interface Props {
  eyebrow?: string;
  title: string;
  note?: string;
  items: Partner[];
}

const { eyebrow, title, note, items } = Astro.props;
---

<section class="bg-base-100 pb-14 pt-10 lg:pb-[106px] lg:pt-[68px]">
  <Container width="narrow">
    <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between lg:gap-10">
      <div class="flex flex-col gap-2 lg:gap-4">
        {eyebrow && (
          <p class="text-[12px] font-bold tracking-[0.08em] text-mn-ink lg:text-[16px] lg:leading-[24px]">{eyebrow}</p>
        )}
        <h2 class="text-[28px] leading-tight font-bold tracking-tight text-mn-ink lg:text-[48px] lg:leading-[70px]">{title}</h2>
      </div>
      {note && (
        <p class="max-w-[460px] text-[13px] leading-6 text-mn-muted lg:mb-[18px] lg:max-w-[560px] lg:text-right lg:text-[18px] lg:leading-[27px]">{note}</p>
      )}
    </div>

    <ul class="mt-8 grid grid-cols-1 gap-[18px] sm:grid-cols-2 lg:mt-[31px] lg:grid-cols-3 lg:gap-x-[17px]">
      {
        items.map((item) => (
          <li class="flex flex-col gap-3 border border-[#dddddd] bg-base-100 px-6 py-8 lg:min-h-[182px] lg:gap-[12px] lg:px-[50px] lg:pt-[51px] lg:pb-[40px]">
            <p class="text-[18px] font-bold text-mn-ink lg:text-[27px] lg:leading-[39px]">{item.title}</p>
            <p class="text-[13px] leading-6 text-mn-muted lg:text-[18px] lg:leading-[27px]">{item.desc}</p>
          </li>
        ))
      }
    </ul>
  </Container>
</section>


