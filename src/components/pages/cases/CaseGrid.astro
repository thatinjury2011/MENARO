---
import { Image } from 'astro:assets';
import Container from '../../ui/Container.astro';
import { getLangFromUrl, localizePath } from '../../../i18n/utils';
import type { ImageMetadata } from 'astro';

interface CaseItem {
  title: string;
  category: string;
  image: ImageMetadata;
  wide?: boolean;
}

interface Props {
  eyebrow?: string;
  title: string;
  items: CaseItem[];
}

const { eyebrow, title, items } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const itemHref = localizePath('/contact', lang);
---

<section class="bg-base-100 pb-14 pt-10 lg:pb-[107px] lg:pt-[51px]">
  <Container width="narrow">
    <div class="flex flex-col gap-2">
      {eyebrow && <p class="text-[12px] font-bold tracking-[0.08em] text-mn-ink lg:text-[16px] lg:leading-[24px]">{eyebrow}</p>}
      <h2 class="text-[28px] leading-tight font-bold tracking-tight text-mn-ink lg:text-[48px] lg:leading-[70px]">{title}</h2>
    </div>

    <ul class="mt-8 grid grid-cols-1 gap-[18px] sm:grid-cols-2 lg:mt-[37px] lg:grid-cols-3 lg:gap-[23px]">
      {
        items.map((item) => (
          <li class:list={[item.wide && 'sm:col-span-2 lg:col-span-3']}>
            <a href={itemHref} class="group relative block h-full overflow-hidden rounded-box">
              <Image
                src={item.image}
                alt={item.title}
                widths={item.wide ? [560, 1120, 1654] : [536, 800, 1072]}
                sizes={
                  item.wide
                    ? '(min-width: 1024px) 86vw, 100vw'
                    : '(min-width: 1024px) 28vw, (min-width: 640px) 45vw, 100vw'
                }
                class:list={[
                  'w-full object-cover transition-transform duration-500 group-hover:scale-[1.025]',
                  item.wide ? 'aspect-[1648/462]' : 'aspect-[536/462]',
                ]}
                loading="lazy"
              />
              <div class="absolute inset-0 bg-linear-to-t from-black/70 via-black/10 to-transparent"></div>
              <div class="absolute inset-x-0 bottom-0 flex flex-col gap-1 p-6 lg:gap-[14px] lg:px-[47px] lg:pb-[62px]">
                <p class="text-lg font-bold text-white lg:text-[34px] lg:leading-[51px]">{item.title}</p>
                <p class="text-[12px] text-white/80 lg:text-[20px] lg:leading-[30px]">{item.category}</p>
              </div>
            </a>
          </li>
        ))
      }
    </ul>
  </Container>
</section>
