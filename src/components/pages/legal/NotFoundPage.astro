---
import Base from '../../../layouts/Base.astro';
import Container from '../../ui/Container.astro';
import Button from '../../ui/Button.astro';
import { getLangFromUrl, localizePath } from '../../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const c = {
  zh: { pageTitle: '页面未找到', title: '页面未找到', desc: '您访问的页面不存在或已移动。', cta: '返回首页' },
  en: { pageTitle: 'Page not found', title: 'Page not found', desc: 'The page you requested does not exist or has moved.', cta: 'Back to home' },
}[lang];
---

<Base title={c.pageTitle}>
  <section class="bg-base-100 py-24 lg:py-32">
    <Container>
      <div class="flex flex-col items-start gap-4">
        <p class="text-[13px] tracking-[0.08em] text-mn-muted">404</p>
        <h1 class="text-[32px] leading-tight font-bold tracking-tight text-mn-ink lg:text-[44px]">{c.title}</h1>
        <p class="text-[14px] text-mn-muted">{c.desc}</p>
        <Button href={localizePath('/', lang)} withArrow class="mt-2 min-w-[168px] justify-between">{c.cta}</Button>
      </div>
    </Container>
  </section>
</Base>