---
import Base from '../../../layouts/Base.astro';
import Container from '../../ui/Container.astro';
import Breadcrumb from '../../ui/Breadcrumb.astro';
import ArrowIcon from '../../ui/ArrowIcon.astro';
import { getLangFromUrl, localizePath } from '../../../i18n/utils';

const lang = getLangFromUrl(Astro.url);

const c = {
  zh: {
    pageTitle: '网站地图',
    eyebrow: 'SITE MAP',
    title: '网站地图',
    intro: '站点全部页面索引，便于快速查找产品与资料。',
    crumbs: [{ label: '首页', href: '/' }, { label: '网站地图' }],
    groups: [
      { title: '产品体系', links: [
        { label: '产品目录', href: '/products' },
        { label: '美缝与填缝材料', href: '/products/tile-grout' },
        { label: '瓷砖胶与铺贴材料', href: '/products/tile-adhesive' },
        { label: '建筑密封胶与结构胶', href: '/products/sealant' },
        { label: '环氧地坪与自流平', href: '/products/floor' },
        { label: '氢化碳环彩砂美缝剂', href: '/products/tile-grout/mg-700' },
        { label: '高级中性耐候密封胶', href: '/products/sealant/ms-786' },
        { label: '环氧彩砂自流平系统', href: '/products/floor/epoxy-sand' },
      ] },
      { title: '解决方案与案例', links: [
        { label: '解决方案', href: '/solutions' },
        { label: '环氧彩砂自流平地坪', href: '/solutions/industrial-floor' },
        { label: '项目案例', href: '/cases' },
      ] },
      { title: '关于与合作', links: [
        { label: '关于我们', href: '/about' },
        { label: '制造与品质', href: '/about/manufacturing' },
        { label: '全球合作', href: '/global' },
      ] },
      { title: '联系与询盘', links: [
        { label: '联系我们', href: '/contact' },
        { label: '获取报价', href: '/quote' },
        { label: '隐私政策', href: '/privacy' },
        { label: '使用条款', href: '/terms' },
      ] },
    ],
  },
  en: {
    pageTitle: 'Sitemap',
    eyebrow: 'SITE MAP',
    title: 'Sitemap',
    intro: 'An index of every page on the site, to help you find products and documents quickly.',
    crumbs: [{ label: 'Home', href: '/' }, { label: 'Sitemap' }],
    groups: [
      { title: 'Products', links: [
        { label: 'Product catalog', href: '/products' },
        { label: 'Tile grout & jointing', href: '/products/tile-grout' },
        { label: 'Tile adhesive & installation', href: '/products/tile-adhesive' },
        { label: 'Sealants & structural adhesives', href: '/products/sealant' },
        { label: 'Epoxy flooring & self-levelling', href: '/products/floor' },
        { label: 'Coloured sand grout', href: '/products/tile-grout/mg-700' },
        { label: 'Neutral weatherproof sealant', href: '/products/sealant/ms-786' },
        { label: 'Epoxy coloured sand self-levelling', href: '/products/floor/epoxy-sand' },
      ] },
      { title: 'Solutions & projects', links: [
        { label: 'Solutions', href: '/solutions' },
        { label: 'Epoxy coloured sand flooring', href: '/solutions/industrial-floor' },
        { label: 'Project cases', href: '/cases' },
      ] },
      { title: 'About & cooperation', links: [
        { label: 'About us', href: '/about' },
        { label: 'Manufacturing & quality', href: '/about/manufacturing' },
        { label: 'Global cooperation', href: '/global' },
      ] },
      { title: 'Contact & enquiries', links: [
        { label: 'Contact us', href: '/contact' },
        { label: 'Get a quote', href: '/quote' },
        { label: 'Privacy policy', href: '/privacy' },
        { label: 'Terms of use', href: '/terms' },
      ] },
    ],
  },
}[lang];
---

<Base title={c.pageTitle}>
  <section class="bg-base-100 pt-12 pb-6 lg:pt-16">
    <Container>
      <div class="flex max-w-[860px] flex-col gap-3">
        <p class="text-[12px] tracking-[0.08em] text-mn-muted">{c.eyebrow}</p>
        <h1 class="text-[32px] leading-tight font-bold tracking-tight text-mn-ink lg:text-[40px]">{c.title}</h1>
        <p class="text-[13px] text-mn-muted">{c.intro}</p>
      </div>
    </Container>
  </section>

  <Breadcrumb items={c.crumbs} />

  <section class="bg-base-100 py-12 lg:py-16">
    <Container>
      <div class="grid grid-cols-1 gap-10 sm:grid-cols-2 lg:grid-cols-4">
        {
          c.groups.map((group) => (
            <div class="flex flex-col gap-4">
              <p class="text-[15px] font-bold text-mn-ink">{group.title}</p>
              <ul class="flex flex-col gap-2.5">
                {group.links.map((link) => (
                  <li>
                    <a
                      href={localizePath(link.href, lang)}
                      class="group inline-flex items-center gap-1.5 text-[13px] text-mn-muted transition-colors hover:text-mn-green"
                    >
                      {link.label}
                      <ArrowIcon className="size-3 opacity-0 transition-opacity group-hover:opacity-100" />
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </Container>
  </section>
</Base>