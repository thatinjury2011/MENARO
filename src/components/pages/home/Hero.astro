---
import { Image } from 'astro:assets';
import Container from '../../ui/Container.astro';
import Button from '../../ui/Button.astro';
import hero from '../../../assets/home/hero.webp';
import logo from '../../../assets/brand/logo.webp';
---

<section class="relative isolate overflow-hidden bg-base-200">
  <Image
    src={hero}
    alt="MENARO 建筑材料制造与全球供应的现代建筑外立面"
    widths={[960, 1440, 1920, 2880]}
    sizes="100vw"
    class="absolute inset-0 size-full object-cover object-right"
    loading="eager"
    fetchpriority="high"
  />
  <div
    class="absolute inset-0 bg-white/85 lg:bg-transparent lg:bg-linear-to-r lg:from-white lg:via-white/75 lg:to-white/0"
  >
  </div>

  <Container class="relative">
    <div class="flex max-w-[720px] flex-col gap-5 py-16 lg:gap-6 lg:py-[110px]">
      <img
        src={logo.src}
        alt="MENARO 美纳罗"
        width="237"
        height="82"
        class="h-11 w-auto self-start lg:h-12"
      />
      <p class="text-[13px] tracking-[0.05em] text-mn-muted">更好的材料，更好的建筑</p>

      <h1 class="text-[34px] leading-[1.2] font-bold tracking-tight text-mn-ink lg:text-[58px] lg:leading-[1.12]">
        高品质建筑材料制造<br />与全球供应
      </h1>

      <p class="text-base text-mn-muted lg:text-lg">建筑材料制造与全球供应</p>

      <p class="max-w-[640px] text-[14px] leading-7 text-mn-muted lg:text-[15px]">
        美纳罗专注于高品质建筑材料的研发、制造与全球供应，依托专业制造能力、稳定的生产资源及严格的品质管理体系，为全球经销商、批发商、品牌客户与工程采购商提供可靠的产品、专业定制服务和稳定的供应保障。
      </p>

      <div class="mt-3 flex flex-wrap gap-4">
        <Button href="/products" withArrow class="min-w-[188px] justify-between">查看核心产品</Button>
        <Button href="/contact" variant="white" withArrow class="min-w-[188px] justify-between">商务合作</Button>
      </div>
    </div>
  </Container>
</section>
