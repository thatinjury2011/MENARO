---
import Container from '../../ui/Container.astro';
import { getLangFromUrl } from '../../../i18n/utils';
import { home } from '../../../i18n/home';

import service01 from '../../../assets/icons/service-01.webp';
import service02 from '../../../assets/icons/service-02.webp';
import service03 from '../../../assets/icons/service-03.webp';
import service04 from '../../../assets/icons/service-04.webp';

const lang = getLangFromUrl(Astro.url);
const icons = [service01, service02, service03, service04];
const items = home[lang].services;
---

<section class="border-y border-mn-border bg-base-200/70">
  <Container>
    <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4">
      {
        items.map((item, i) => (
          <li
            class:list={[
              'flex items-center gap-4 px-0 py-6 sm:px-6 lg:py-7',
              i > 0 && 'sm:border-l sm:border-mn-border',
            ]}
          >
            <img src={icons[i].src} alt="" width="58" height="58" class="size-8 shrink-0" loading="lazy" />
            <div class="flex flex-col gap-1">
              <p class="text-[15px] font-semibold text-mn-ink">{item.title}</p>
              <p class="text-[13px] text-mn-muted">{item.desc}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </Container>
</section>