---
import { Image } from 'astro:assets';
import Container from '../../ui/Container.astro';
import { getLangFromUrl } from '../../../i18n/utils';
import { home } from '../../../i18n/home';

import partnersBg from '../../../assets/home/partners-bg.webp';
import p1 from '../../../assets/icons/partner-01.webp';
import p2 from '../../../assets/icons/partner-02.webp';
import p3 from '../../../assets/icons/partner-03.webp';
import p4 from '../../../assets/icons/partner-04.webp';

const lang = getLangFromUrl(Astro.url);
const t = home[lang].partners;
const icons = [p1, p2, p3, p4];
---

<section class="bg-base-100 py-14 lg:py-24">
  <Container>
    <div class="grid grid-cols-1 items-center gap-10 lg:grid-cols-[minmax(0,420px)_1fr] lg:gap-16">
      <div class="flex flex-col gap-5">
        <h2 class="text-[32px] leading-[1.15] font-bold tracking-tight text-mn-ink lg:text-[44px]">{t.title}</h2>
        <p class="text-[13px] leading-6 text-mn-muted">{t.desc}</p>
      </div>

      <Image
        src={partnersBg}
        alt={t.title}
        widths={[600, 1079]}
        sizes="(min-width: 1024px) 55vw, 100vw"
        class="w-full object-contain"
        loading="lazy"
      />
    </div>

    <ul class="mt-10 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:mt-14 lg:grid-cols-4">
      {
        t.items.map((item, i) => (
          <li class="flex flex-col gap-5 rounded-box border border-mn-border px-6 py-7">
            <img src={icons[i].src} alt="" width="34" height="34" class="size-6" loading="lazy" />
            <div class="flex flex-col gap-4">
              <p class="text-[15px] font-semibold text-mn-ink">{item.title}</p>
              <div class="flex flex-col gap-1 text-[12px] text-mn-muted">
                {item.lines.map((line) => <span>{line}</span>)}
              </div>
            </div>
          </li>
        ))
      }
    </ul>
  </Container>
</section>