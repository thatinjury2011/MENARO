---
import { Image } from 'astro:assets';
import Container from '../../ui/Container.astro';
import SectionHeading from '../../ui/SectionHeading.astro';
import ArrowLink from '../../ui/ArrowLink.astro';
import ArrowIcon from '../../ui/ArrowIcon.astro';
import { getLangFromUrl, localizePath } from '../../../i18n/utils';
import { home } from '../../../i18n/home';
import { ui } from '../../../i18n/ui';

import grout from '../../../assets/home/collection-tile-grout.webp';
import adhesive from '../../../assets/home/collection-tile-adhesive.webp';
import sealant from '../../../assets/home/collection-sealant.webp';
import floor from '../../../assets/home/collection-floor.webp';

const lang = getLangFromUrl(Astro.url);
const t = home[lang].collection;
const labels = ui[lang];
const images = [grout, adhesive, sealant, floor];
---

<section class="bg-base-100 py-14 lg:py-24">
  <Container>
    <div class="flex items-end justify-between gap-6">
      <SectionHeading title={t.title} subtitle={t.subtitle} />
      <ArrowLink href={localizePath('/products', lang)} class="shrink-0">{t.link}</ArrowLink>
    </div>

    <ul class="mt-8 grid grid-cols-1 gap-px overflow-hidden rounded-box border border-mn-border bg-mn-border sm:grid-cols-2 lg:mt-12 lg:grid-cols-4">
      {
        t.items.map((item, i) => (
          <li class="bg-base-100">
            <a href={localizePath(item.href, lang)} class="group flex h-full flex-col">
              <Image
                src={images[i]}
                alt={item.title}
                widths={[408, 816]}
                sizes="(min-width: 1024px) 25vw, (min-width: 640px) 50vw, 100vw"
                class="aspect-[408/250] w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
                loading="lazy"
              />
              <div class="flex flex-1 flex-col gap-2 p-6">
                <h3 class="text-lg font-semibold text-mn-ink">{item.title}</h3>
                <p class="text-[13px] text-mn-muted">{item.desc}</p>
                <div class="mt-auto flex items-center justify-between pt-6">
                  <span class="text-[13px] text-mn-ink">{labels.learnSeries}</span>
                  <span class="grid size-8 place-items-center rounded-full border border-mn-border text-mn-ink transition-colors group-hover:border-mn-green group-hover:bg-mn-green group-hover:text-white">
                    <ArrowIcon className="size-4" />
                  </span>
                </div>
              </div>
            </a>
          </li>
        ))
      }
    </ul>
  </Container>
</section>