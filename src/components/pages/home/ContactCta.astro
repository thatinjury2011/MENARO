---
import Container from '../../ui/Container.astro';
import Button from '../../ui/Button.astro';
import { getLangFromUrl, localizePath } from '../../../i18n/utils';
import { home } from '../../../i18n/home';

const lang = getLangFromUrl(Astro.url);
const t = home[lang].contactCta;
---

<section class="bg-[#f7f3ea] py-14 lg:py-20">
  <Container>
    <div
      class="flex flex-col gap-8 rounded-box bg-base-100 px-7 py-10 lg:flex-row lg:items-center lg:justify-between lg:px-12 lg:py-12"
    >
      <div class="flex flex-col gap-3">
        <p class="text-[13px] text-mn-muted lg:text-[16px]">{t.eyebrow}</p>
        <h2 class="text-2xl font-bold tracking-tight text-mn-ink lg:text-[38px] lg:leading-[56px]">{t.title}</h2>
        <p class="text-[13px] text-mn-muted lg:text-[17px] lg:leading-[27px]">{t.desc}</p>
      </div>
      <Button href={localizePath('/contact', lang)} withArrow class="shrink-0 min-w-[188px] justify-between">
        {t.cta}
      </Button>
    </div>
  </Container>
</section>