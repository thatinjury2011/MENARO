---
import { Image } from 'astro:assets';
import Container from '../../ui/Container.astro';
import SectionHeading from '../../ui/SectionHeading.astro';
import ArrowLink from '../../ui/ArrowLink.astro';
import { getLangFromUrl, localizePath } from '../../../i18n/utils';
import { home } from '../../../i18n/home';

import app01 from '../../../assets/home/application-01.webp';
import app02 from '../../../assets/home/application-02.webp';
import app03 from '../../../assets/home/application-03.webp';
import app04 from '../../../assets/home/application-04.webp';

const lang = getLangFromUrl(Astro.url);
const t = home[lang].applications;
const images = [app01, app02, app03, app04];
---

<section class="bg-base-100 py-14 lg:py-24">
  <Container>
    <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
      <SectionHeading title={t.title} subtitle={t.subtitle} />
      <div class="flex flex-col gap-4 lg:items-end">
        <p class="max-w-[560px] text-[13px] leading-6 text-mn-muted lg:text-right">{t.note}</p>
        <ArrowLink href={localizePath('/solutions', lang)}>{t.link}</ArrowLink>
      </div>
    </div>

    <ul class="mt-8 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:mt-12 lg:grid-cols-4">
      {
        t.scenes.map((scene, i) => (
          <li>
            <a href={localizePath('/solutions', lang)} class="group relative block overflow-hidden rounded-box">
              <Image
                src={images[i]}
                alt={scene.title}
                widths={[409, 818]}
                sizes="(min-width: 1024px) 25vw, (min-width: 640px) 50vw, 100vw"
                class="aspect-[409/335] w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
                loading="lazy"
              />
              <div class="absolute inset-0 bg-linear-to-t from-black/70 via-black/10 to-transparent"></div>
              <div class="absolute inset-x-0 bottom-0 flex flex-col gap-1 p-5">
                <p class="text-lg font-semibold text-white">{scene.title}</p>
                <p class="text-[12px] text-white/75">{scene.sub}</p>
              </div>
            </a>
          </li>
        ))
      }
    </ul>
  </Container>
</section>