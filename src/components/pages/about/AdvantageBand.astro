---
import { Image } from 'astro:assets';
import Container from '../../ui/Container.astro';
import type { ImageMetadata } from 'astro';

interface Advantage {
  title: string;
  desc: string;
  icon: ImageMetadata;
}

interface Props {
  eyebrow?: string;
  title: string;
  note?: string;
  items: Advantage[];
}

const { eyebrow, title, note, items } = Astro.props;
---

<section class="bg-primary py-14 text-white lg:py-20">
  <Container>
    <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
      <div class="flex flex-col gap-2">
        {eyebrow && <p class="text-[12px] tracking-[0.08em] text-white/60">{eyebrow}</p>}
        <h2 class="text-[28px] leading-tight font-bold tracking-tight lg:text-[40px]">{title}</h2>
      </div>
      {note && <p class="max-w-[520px] text-[13px] leading-6 text-white/70 lg:text-right">{note}</p>}
    </div>

    <ul class="mt-8 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:mt-12 lg:grid-cols-3 2xl:grid-cols-6">
      {
        items.map((item) => (
          <li class="flex flex-col gap-3 rounded-box border border-white/15 bg-white/5 p-6">
            <Image
              src={item.icon}
              alt=""
              width={64}
              height={64}
              class="size-8 object-contain brightness-0 invert"
              loading="lazy"
            />
            <p class="text-[15px] font-semibold">{item.title}</p>
            <p class="text-[12px] leading-6 text-white/70">{item.desc}</p>
          </li>
        ))
      }
    </ul>
  </Container>
</section>
