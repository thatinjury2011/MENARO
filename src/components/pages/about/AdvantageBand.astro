---
import { Image } from 'astro:assets';
import Container from '../../ui/Container.astro';
import type { ImageMetadata } from 'astro';

interface Advantage {
  title: string;
  desc: string;
  icon: ImageMetadata;
}

interface Props {
  eyebrow?: string;
  title: string;
  note?: string;
  items: Advantage[];
}

const { eyebrow, title, note, items } = Astro.props;
---

<section class="bg-primary py-14 text-white lg:pt-[48px] lg:pb-[64px]">
  <Container width="narrow">
    <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between lg:gap-10">
      <div class="flex flex-col">
        {
          eyebrow && (
            <p class="text-[14px] font-bold tracking-[0.3em] text-white lg:text-[16px] lg:leading-[24px]">{eyebrow}</p>
          )
        }
        <h2 class="mt-2 text-[30px] leading-[1.2] font-bold tracking-tight lg:mt-[15px] lg:text-[48px] lg:leading-[70px]">
          {title}
        </h2>
      </div>
      {
        note && (
          <p class="max-w-[780px] text-[15px] leading-6 text-white lg:mb-[18px] lg:text-right lg:text-[18px] lg:leading-[27px]">
            {note}
          </p>
        )
      }
    </div>

    <ul class="mt-8 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:mt-[32px] lg:grid-cols-3 lg:gap-[13px] xl:grid-cols-6">
      {
        items.map((item) => (
          <li class="flex flex-col items-center gap-3 rounded-[5px] border border-[#b1c5ba] bg-primary px-4 py-5 text-center lg:min-h-[215px] lg:gap-0 lg:px-[12px] lg:pt-[22px] lg:pb-0">
            <Image
              src={item.icon}
              alt=""
              width={54}
              height={54}
              class="size-12 object-contain lg:size-[54px]"
              loading="lazy"
            />
            <p class="text-[17px] leading-[26px] font-bold lg:mt-[13px] lg:text-[18px] lg:leading-[27px]">{item.title}</p>
            <p
              class="max-w-[222px] whitespace-pre-line text-[14px] leading-6 text-white lg:mt-[6px] lg:text-[17px] lg:leading-[20px]"
            >
              {item.desc}
            </p>
          </li>
        ))
      }
    </ul>
  </Container>
</section>
