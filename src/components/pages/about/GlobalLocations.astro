---
import { Image } from 'astro:assets';
import Container from '../../ui/Container.astro';
import type { ImageMetadata } from 'astro';

interface Location {
  location: string;
  locationEn: string;
  title: string;
  desc: string;
  icon: ImageMetadata;
  image: ImageMetadata;
}

interface Props {
  eyebrow?: string;
  title: string;
  note?: string;
  items: Location[];
}

const { eyebrow, title, note, items } = Astro.props;
---

<section class="bg-base-100 py-14 lg:py-20">
  <Container>
    <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
      <div class="flex flex-col gap-2">
        {eyebrow && <p class="text-[12px] tracking-[0.08em] text-mn-muted">{eyebrow}</p>}
        <h2 class="text-[28px] leading-tight font-bold tracking-tight text-mn-ink lg:text-[40px]">{title}</h2>
      </div>
      {note && <p class="max-w-[440px] text-[13px] leading-6 text-mn-muted lg:text-right">{note}</p>}
    </div>

    <ul class="mt-8 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:mt-12 lg:grid-cols-4">
      {
        items.map((item) => (
          <li class="overflow-hidden rounded-box border border-mn-border bg-base-100">
            <Image
              src={item.image}
              alt={item.location}
              widths={[420, 840]}
              sizes="(min-width: 1024px) 24vw, (min-width: 640px) 45vw, 100vw"
              class="aspect-[16/9] w-full object-cover"
              loading="lazy"
            />
            <div class="flex flex-col gap-3 p-5">
              <div class="flex items-center gap-2">
                <Image src={item.icon} alt="" width={48} height={48} class="size-5 object-contain" loading="lazy" />
                <span class="flex flex-col">
                  <span class="text-[13px] font-semibold text-mn-ink">{item.location}</span>
                  <span class="text-[11px] text-mn-muted">{item.locationEn}</span>
                </span>
              </div>
              <p class="text-[15px] font-bold text-mn-ink">{item.title}</p>
              <p class="text-[12px] leading-6 text-mn-muted">{item.desc}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </Container>
</section>
