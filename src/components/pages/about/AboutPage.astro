---
import Base from '../../../layouts/Base.astro';
import PageHero from '../../sections/PageHero.astro';
import InquiryCta from '../../sections/InquiryCta.astro';
import Breadcrumb from '../../ui/Breadcrumb.astro';
import FounderBlock from './FounderBlock.astro';
import GlobalLocations from './GlobalLocations.astro';
import AdvantageBand from './AdvantageBand.astro';
import JoinBand from './JoinBand.astro';
import { getLangFromUrl } from '../../../i18n/utils';

import hero from '../../../assets/about/hero.webp';
import founder from '../../../assets/about/intro.webp';
import advantageBg from '../../../assets/about/advantage-bg.webp';
import global01 from '../../../assets/about/global-01.webp';
import global02 from '../../../assets/about/global-02.webp';
import global03 from '../../../assets/about/global-03.webp';
import global04 from '../../../assets/about/global-04.webp';

import iconCity from '../../../assets/icons/global-city.webp';
import iconAddress from '../../../assets/icons/global-address.webp';
import iconPeople from '../../../assets/icons/global-people.webp';
import iconFuture from '../../../assets/icons/global-future.webp';

import advantage01 from '../../../assets/icons/advantage-01.webp';
import advantage02 from '../../../assets/icons/advantage-02.webp';
import advantage03 from '../../../assets/icons/advantage-03.webp';
import advantage04 from '../../../assets/icons/advantage-04.webp';
import advantage05 from '../../../assets/icons/advantage-05.webp';
import advantage06 from '../../../assets/icons/advantage-06.webp';
import ContentScale from '../../ui/ContentScale.astro';

const lang = getLangFromUrl(Astro.url);

const c = {
  zh: {
    pageTitle: '关于我们',
    hero: {
      title: '关于我们',
      subtitle: '把高品质中国制造连接到全球建筑应用',
      description:
        '美纳罗专注于高品质建筑材料的研发、制造与全球供应，\n并整合中国优质制造资源与供应链协同，\n为全球客户提供稳定、可靠的产品供应和面向项目的解决方案。',
      imageAlt: 'MENARO 品牌空间',
      primary: { label: '了解我们的故事', href: '#founder' },
    },
    crumbs: [{ label: '首页', href: '/' }, { label: '关于我们' }],
    founder: {
      eyebrow: 'FOUNDER',
      title: '品牌创始人 | Wang UP',
      subtitle: '源于真实的行业经验，更懂材料，更懂客户',
      paragraphs: [
        'Wang UP先生自2010年进入建筑材料行业，长期深耕产品应用、供应链管理、项目交付与客户服务，积累了丰富的行业经验与经营管理能力。',
        '凭借对建筑材料性能、实际施工及长期使用需求的深入理解，他逐步将事业延伸至制造领域，投资布局建筑材料制造基地，推动产品研发、生产管理、品质控制与供应链体系建设。',
        '基于多年行业积累及制造端经验，他创立了MENARO美纳罗品牌，以自主制造为基础，整合国内外优质合作制造资源，将中国高品质制造与全球市场需求紧密连接，为客户提供可靠的建筑材料、专业的产品服务及定制化解决方案。',
      ],
      quote: '好的建筑，始于合适的材料，\n也源于对真实应用场景的深刻理解。',
      signature: 'Wang UP',
      imageAlt: 'MENARO 品牌创始人 Wang UP',
    },
    locations: {
      eyebrow: 'GLOBAL OPERATIONS & MANUFACTURING',
      title: '全球运营与制造布局',
      note: '以中国为运营与制造基础，逐步拓展海外合作生产基地，\n构建面向全球市场的多区域制造与供应体系。',
      items: [
        { location: '中国 · 台州', locationEn: 'Taizhou, China', title: '品牌运营中心', desc: '品牌管理、市场运营、客户服务\n与项目协同。' },
        { location: '中国 · 安徽', locationEn: 'Anhui, China', title: '自主制造基地', desc: '配备成熟的生产设备与质量管理体系，\n专注于高品质建筑材料的研发与生产。' },
        { location: '越南 · 同奈', locationEn: 'Dong Nai, Vietnam', title: '合作生产基地', desc: '依托本地制造资源与供应链优势，\n为海外市场提供灵活、高效的生产\n与交付支持。' },
        { location: '未来布局', locationEn: 'Global Expansion', title: '持续全球拓展', desc: '面向全球市场，持续优化产能布局\n与供应体系，满足更广泛的项目需求。' },
      ],
    },
    advantages: {
      eyebrow: 'MENARO',
      title: '我们的核心优势',
      note: '我们整合中国优质制造资源与全球市场经验，致力于为客户提供更具竞争力的建筑材料解决方案。',
      items: [
        { title: '终端应用洞察', desc: '深入了解不同建筑场景的\n材料需求，提供更贴合\n实际应用的产品方案。' },
        { title: '制造与品质控制', desc: '结合生产基地标准制造流程，\n严格把控品质，确保产品\n生产品质。' },
        { title: '产品整合能力', desc: '整合多品类建筑材料，\n提供一站式供应方案，\n满足多样化需求。' },
        { title: '全球供应服务', desc: '覆盖全球市场，提供\n高效、稳定、灵活的\n供应与物流支持。' },
        { title: '项目服务支持', desc: '提供前期咨询、技术支持\n与项目落地服务，助力客户\n顺利完成项目。' },
        { title: '售后与长期合作', desc: '重视客户体验，提供专业\n的售后支持，与客户\n保持长期、稳定合作。' },
      ],
    },
    join: {
      title: '期待与您携手',
      subtitle: '以更好的材料，创造更优质的建筑空间',
      description: '无论您是开发商、建筑商、设计机构还是渠道合作伙伴，美纳罗将以专业的产品与服务，助力您的项目成功。',
      imageAlt: 'MENARO 与合作伙伴携手',
      cta: { label: '联系我们', href: '/contact' },
    },
    cta: {
      eyebrow: '欢迎与美纳罗建立合作',
      title: '让合适的产品更快进入你的采购链',
      description: '欢迎就产品、包装、定制与采购需求与我们联系。',
      button: { label: '提交采购询盘', href: '/contact' },
    },
  },
  en: {
    pageTitle: 'About us',
    hero: {
      title: 'About us',
      subtitle: 'Connecting high-quality Chinese manufacturing with global building applications',
      description: 'MENARO focuses on the development, manufacturing and global supply of high-quality building materials. By combining quality Chinese manufacturing resources with coordinated supply chains, we provide customers worldwide with dependable supply and project-oriented solutions.',
      imageAlt: 'MENARO brand space',
      primary: { label: 'Read our story', href: '#founder' },
    },
    crumbs: [{ label: 'Home', href: '/' }, { label: 'About' }],
    founder: {
      eyebrow: 'FOUNDER',
      title: 'Founder | Wang UP',
      subtitle: 'Grounded in real industry experience — we understand materials and customers',
      paragraphs: [
        'Wang UP entered the building materials industry in 2010, working deeply in product application, supply chain management, project delivery and customer service, building substantial industry and management experience.',
        'With a clear understanding of material performance, site practice and long-term service requirements, he extended his work into manufacturing — investing in building materials production bases and driving product development, production management, quality control and supply chain systems.',
        'Building on years of industry and manufacturing experience, he founded MENARO: in-house manufacturing supported by qualified partner factories at home and abroad, closely connecting high-quality Chinese manufacturing with global market demand to deliver reliable materials, professional product service and customised solutions.',
      ],
      quote: 'Good buildings start with the right materials — and with a deep understanding of real application scenarios.',
      signature: 'Wang UP',
      imageAlt: 'MENARO founder Wang UP',
    },
    locations: {
      eyebrow: 'GLOBAL OPERATIONS & MANUFACTURING',
      title: 'Global operations and manufacturing',
      note: 'With China as our operating and manufacturing base, we are expanding overseas partner production to build a multi-region manufacturing and supply system for global markets.',
      items: [
        { location: 'Taizhou', locationEn: 'Zhejiang, China', title: 'Brand operations centre', desc: 'Brand management, marketing operations, customer service and project coordination.' },
        { location: 'Anhui', locationEn: 'Anhui, China', title: 'In-house manufacturing base', desc: 'Equipped production lines and a quality management system, focused on the development and manufacture of high-quality building materials.' },
        { location: 'Dong Nai', locationEn: 'Vietnam', title: 'Partner production base', desc: 'Leveraging local manufacturing resources and supply chain strengths to provide flexible, efficient production and delivery for overseas markets.' },
        { location: 'Future network', locationEn: 'Global expansion', title: 'Continuous global expansion', desc: 'Continuously optimising capacity and supply structure to serve a wider range of project requirements.' },
      ],
    },
    advantages: {
      eyebrow: 'MENARO',
      title: 'Our core strengths',
      note: 'We combine quality Chinese manufacturing resources with global market experience to deliver more competitive building material solutions.',
      items: [
        { title: 'Application insight', desc: 'We understand the material needs of different building scenarios and propose solutions that fit real applications.' },
        { title: 'Manufacturing & quality control', desc: 'Standard manufacturing processes at our production base with strict quality control.' },
        { title: 'Product integration', desc: 'A multi-category portfolio and one-stop supply to meet varied requirements.' },
        { title: 'Global supply', desc: 'Worldwide coverage with efficient, stable and flexible supply and logistics support.' },
        { title: 'Project support', desc: 'Pre-sales consulting, technical support and on-the-ground project service.' },
        { title: 'After-sales & long-term cooperation', desc: 'A focus on customer experience, professional after-sales support and stable long-term partnerships.' },
      ],
    },
    join: {
      title: 'Let’s work together',
      subtitle: 'Better materials for better building spaces',
      description: 'Whether you are a developer, builder, design institute or channel partner, MENARO supports your project with professional products and service.',
      imageAlt: 'MENARO working with partners',
      cta: { label: 'Contact us', href: '/contact' },
    },
    cta: {
      eyebrow: 'Work with MENARO',
      title: 'Bring the right products into your supply chain faster',
      description: 'Talk to us about products, packaging, customisation and procurement.',
      button: { label: 'Send an enquiry', href: '/contact' },
    },
  },
}[lang];

const locationImages = [global01, global02, global03, global04];
const locationIcons = [iconAddress, iconCity, iconPeople, iconFuture];
const locations = c.locations.items.map((item, i) => ({ ...item, image: locationImages[i], icon: locationIcons[i] }));

const advantageIcons = [advantage01, advantage02, advantage03, advantage04, advantage05, advantage06];
const advantages = c.advantages.items.map((item, i) => ({ ...item, icon: advantageIcons[i] }));
---

<Base title={c.pageTitle}>
  <PageHero
    brandMark
    title={c.hero.title}
    subtitle={c.hero.subtitle}
    description={c.hero.description}
    image={hero}
    imageAlt={c.hero.imageAlt}
    primary={c.hero.primary}
  />
  <ContentScale>
    <Breadcrumb items={c.crumbs} />

    <div id="founder">
      <FounderBlock
        eyebrow={c.founder.eyebrow}
        title={c.founder.title}
        subtitle={c.founder.subtitle}
        paragraphs={c.founder.paragraphs}
        quote={{ text: c.founder.quote, signature: c.founder.signature }}
        image={founder}
        imageAlt={c.founder.imageAlt}
      />
    </div>

    <GlobalLocations
      eyebrow={c.locations.eyebrow}
      title={c.locations.title}
      note={c.locations.note}
      items={locations}
    />

    <AdvantageBand
      eyebrow={c.advantages.eyebrow}
      title={c.advantages.title}
      note={c.advantages.note}
      items={advantages}
    />

    <JoinBand
      title={c.join.title}
      subtitle={c.join.subtitle}
      description={c.join.description}
      image={advantageBg}
      imageAlt={c.join.imageAlt}
      cta={c.join.cta}
    />

    <InquiryCta eyebrow={c.cta.eyebrow} title={c.cta.title} description={c.cta.description} cta={c.cta.button} />
  </ContentScale>
</Base>
