---
import { Image } from 'astro:assets';
import Container from '../../ui/Container.astro';
import Button from '../../ui/Button.astro';
import type { ImageMetadata } from 'astro';

interface Props {
  title: string;
  subtitle?: string;
  description?: string;
  image: ImageMetadata;
  imageAlt: string;
  cta: { label: string; href: string };
}

const { title, subtitle, description, image, imageAlt, cta } = Astro.props;
---

<section class="relative isolate overflow-hidden">
  <Image
    src={image}
    alt={imageAlt}
    widths={[768, 1280, 1920]}
    sizes="100vw"
    class="absolute inset-0 h-full w-full object-cover"
    loading="lazy"
  />
  <div class="absolute inset-0 bg-linear-to-r from-mn-green/85 via-mn-green/55 to-transparent"></div>

  <Container class="relative">
    <div class="flex max-w-[620px] flex-col gap-4 py-16 text-white lg:py-24">
      <h2 class="text-[28px] leading-tight font-bold tracking-tight lg:text-[40px]">{title}</h2>
      {subtitle && <p class="text-[18px] leading-8 font-semibold lg:text-[22px]">{subtitle}</p>}
      {description && <p class="text-[14px] leading-7 text-white/85">{description}</p>}
      <div class="pt-2">
        <Button href={cta.href} variant="primary" withArrow class="min-w-[168px] justify-between">
          {cta.label}
        </Button>
      </div>
    </div>
  </Container>
</section>
