---
import { Image } from 'astro:assets';
import Container from '../../ui/Container.astro';
import Button from '../../ui/Button.astro';
import type { ImageMetadata } from 'astro';

interface Props {
  title: string;
  subtitle?: string;
  description?: string;
  image: ImageMetadata;
  imageAlt: string;
  cta: { label: string; href: string };
}

const { title, subtitle, description, image, imageAlt, cta } = Astro.props;
---

<section class="relative isolate overflow-hidden">
  <Image
    src={image}
    alt={imageAlt}
    widths={[768, 1280, 1920]}
    sizes="100vw"
    class="absolute inset-0 h-full w-full object-cover object-center"
    loading="lazy"
  />

  <Container width="narrow" class="relative">
    <div class="flex max-w-[700px] flex-col py-14 lg:max-w-[820px] lg:pt-[66px] lg:pb-[70px]">
      <h2 class="text-[28px] leading-[1.2] font-bold tracking-tight text-mn-ink lg:text-[56px] lg:leading-[84px]">
        {title}
      </h2>
      {
        subtitle && (
          <p class="mt-1 text-[20px] leading-[1.3] font-bold text-mn-ink lg:-mt-[6px] lg:text-[34px] lg:leading-[51px]">
            {subtitle}
          </p>
        )
      }
      {
        description && (
          <p class="mt-3 max-w-[660px] text-[15px] leading-[24px] font-bold text-mn-ink lg:mt-[8px] lg:text-[26px] lg:leading-[35px]">
            {description}
          </p>
        )
      }
      <div class="mt-6 lg:mt-[44px]">
        <Button href={cta.href} variant="primary" size="lg" withArrow class="min-w-[248px] justify-between">
          {cta.label}
        </Button>
      </div>
    </div>
  </Container>
</section>
