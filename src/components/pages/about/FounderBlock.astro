---
import { Image } from 'astro:assets';
import Container from '../../ui/Container.astro';
import type { ImageMetadata } from 'astro';

interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  paragraphs: string[];
  quote?: { text: string; signature?: string };
  image: ImageMetadata;
  imageAlt: string;
}

const { eyebrow = 'FOUNDER', title, subtitle, paragraphs, quote, image, imageAlt } = Astro.props;
---

<section class="bg-base-100 py-14 lg:py-24">
  <Container>
    <div class="grid grid-cols-1 items-center gap-10 lg:grid-cols-[minmax(0,0.85fr)_minmax(0,1fr)] lg:gap-16">
      <Image
        src={image}
        alt={imageAlt}
        widths={[520, 780, 1040]}
        sizes="(min-width: 1024px) 42vw, 100vw"
        class="w-full rounded-box object-cover"
        loading="lazy"
      />

      <div class="flex flex-col gap-4">
        <p class="text-[12px] tracking-[0.08em] text-mn-muted">{eyebrow}</p>
        <h2 class="text-[26px] leading-tight font-bold tracking-tight text-mn-ink lg:text-[34px]">{title}</h2>
        {subtitle && <p class="text-[15px] font-bold text-mn-ink">{subtitle}</p>}
        <div class="flex flex-col gap-3">
          {paragraphs.map((p) => <p class="text-[14px] leading-7 text-mn-muted">{p}</p>)}
        </div>

        {
          quote && (
            <figure class="mt-2 flex flex-col gap-3 rounded-box bg-base-200/70 px-6 py-5 lg:px-8 lg:py-6">
              <blockquote class="text-[15px] leading-7 font-semibold text-mn-ink lg:text-[17px]">
                “{quote.text}”
              </blockquote>
              {quote.signature && (
                <figcaption class="text-[13px] text-mn-muted">— {quote.signature}</figcaption>
              )}
            </figure>
          )
        }
      </div>
    </div>
  </Container>
</section>
