---
import { Image } from 'astro:assets';
import Container from '../../ui/Container.astro';
import type { ImageMetadata } from 'astro';

interface Scenario {
  title: string;
  desc: string;
  image: ImageMetadata;
}

interface Props {
  eyebrow?: string;
  title: string;
  note?: string;
  items: Scenario[];
  /** standard：3:2（默认）；wide：2:1，用于横向长图 */
  ratio?: 'standard' | 'wide';
}

const { eyebrow, title, note, items, ratio = 'standard' } = Astro.props;
const aspect = ratio === 'wide' ? 'aspect-[2/1]' : 'aspect-[3/2]';
---

<section class="bg-base-200/70 py-14 lg:py-20">
  <Container>
    <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
      <div class="flex flex-col gap-2">
        {eyebrow && <p class="text-[12px] tracking-[0.08em] text-mn-muted">{eyebrow}</p>}
        <h2 class="text-[28px] leading-tight font-bold tracking-tight text-mn-ink lg:text-[40px]">{title}</h2>
      </div>
      {note && <p class="max-w-[520px] text-[13px] leading-6 text-mn-muted lg:text-right">{note}</p>}
    </div>

    <ul class="mt-8 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:mt-10 lg:grid-cols-3">
      {
        items.map((item) => (
          <li class="overflow-hidden rounded-box bg-base-100">
            <Image
              src={item.image}
              alt={item.title}
              widths={[420, 840]}
              sizes="(min-width: 1024px) 32vw, (min-width: 640px) 46vw, 100vw"
              class:list={['w-full object-cover', aspect]}
              loading="lazy"
            />
            <div class="flex flex-col gap-2 p-6">
              <p class="text-[16px] font-bold text-mn-ink">{item.title}</p>
              <p class="text-[13px] leading-6 text-mn-muted">{item.desc}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </Container>
</section>
