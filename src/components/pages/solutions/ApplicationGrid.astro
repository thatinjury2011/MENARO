---
import { Image } from 'astro:assets';
import Container from '../../ui/Container.astro';
import ArrowIcon from '../../ui/ArrowIcon.astro';
import type { ImageMetadata } from 'astro';

interface Application {
  title: string;
  image: ImageMetadata;
  href?: string;
}

interface Props {
  eyebrow?: string;
  title: string;
  note?: string;
  items: Application[];
}

const { eyebrow, title, note, items } = Astro.props;
---

<section class="bg-base-100 py-14 lg:py-20">
  <Container>
    <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
      <div class="flex flex-col gap-2">
        {eyebrow && <p class="text-[12px] tracking-[0.08em] text-mn-muted">{eyebrow}</p>}
        <h2 class="text-[28px] leading-tight font-bold tracking-tight text-mn-ink lg:text-[40px]">{title}</h2>
      </div>
      {note && <p class="max-w-[460px] text-[13px] leading-6 text-mn-muted lg:text-right">{note}</p>}
    </div>

    <ul class="mt-8 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:mt-12 lg:grid-cols-4">
      {
        items.map((item) => {
          const Tag = item.href ? 'a' : 'div';
          return (
            <li>
              <Tag
                {...(item.href ? { href: item.href } : {})}
                class="group relative block overflow-hidden rounded-box"
              >
                <Image
                  src={item.image}
                  alt={item.title}
                  widths={[320, 640]}
                  sizes="(min-width: 1024px) 24vw, (min-width: 640px) 45vw, 100vw"
                  class="aspect-[3/4] w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
                  loading="lazy"
                />
                <div class="absolute inset-0 bg-linear-to-t from-black/70 via-black/10 to-transparent"></div>
                <div class="absolute inset-x-0 bottom-0 flex items-center justify-between gap-3 p-5">
                  <p class="text-[15px] font-semibold text-white">{item.title}</p>
                  <ArrowIcon className="size-4 shrink-0 text-white/85" />
                </div>
              </Tag>
            </li>
          );
        })
      }
    </ul>
  </Container>
</section>
