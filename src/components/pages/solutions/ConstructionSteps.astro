---
import { Image } from 'astro:assets';
import Container from '../../ui/Container.astro';
import type { ImageMetadata } from 'astro';

interface Step {
  index: string;
  title: string;
  desc: string;
  image: ImageMetadata;
}

interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  steps: Step[];
}

const { eyebrow, title, description, steps } = Astro.props;
---

<section class="bg-base-100 py-14 lg:py-20">
  <Container>
    <div class="grid grid-cols-1 gap-8 lg:grid-cols-[280px_1fr] lg:items-center lg:gap-12">
      <div class="flex flex-col gap-2">
        {eyebrow && <p class="text-[12px] tracking-[0.08em] text-mn-muted">{eyebrow}</p>}
        <h2 class="text-[28px] leading-tight font-bold tracking-tight text-mn-ink lg:text-[40px]">{title}</h2>
        {description && <p class="pt-2 text-[13px] leading-6 text-mn-muted">{description}</p>}
      </div>

      <ol class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-5">
        {
          steps.map((step) => (
            <li class="flex flex-col gap-3 rounded-box border border-mn-border bg-base-100 p-4">
              <div class="flex items-baseline gap-2">
                <span class="text-[13px] font-bold text-mn-green">{step.index}</span>
                <p class="text-[14px] font-semibold text-mn-ink">{step.title}</p>
              </div>
              <Image
                src={step.image}
                alt={step.title}
                widths={[240, 480]}
                sizes="(min-width: 1024px) 15vw, (min-width: 640px) 45vw, 100vw"
                class="aspect-[4/3] w-full rounded object-cover"
                loading="lazy"
              />
              <p class="text-[12px] leading-5 text-mn-muted">{step.desc}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </Container>
</section>
