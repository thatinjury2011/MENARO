---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Feature {
  title: string;
  desc: string;
  icon: ImageMetadata;
}

interface Props {
  items: Feature[];
}

const { items } = Astro.props;
---

<ul class="grid grid-cols-2 gap-6 pt-2 sm:grid-cols-3 lg:grid-cols-5">
  {
    items.map((item) => (
      <li class="flex flex-col items-start gap-2">
        <span class="flex size-12 items-center justify-center rounded-full border border-mn-border">
          <Image src={item.icon} alt="" width={73} height={73} class="size-5 object-contain" loading="lazy" />
        </span>
        <p class="text-[14px] font-bold text-mn-ink">{item.title}</p>
        <p class="text-[12px] leading-5 text-mn-muted">{item.desc}</p>
      </li>
    ))
  }
</ul>
