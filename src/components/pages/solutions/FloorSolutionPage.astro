---
import { Image } from 'astro:assets';
import Base from '../../../layouts/Base.astro';
import Container from '../../ui/Container.astro';
import Button from '../../ui/Button.astro';
import PageHero from '../../sections/PageHero.astro';
import InquiryCta from '../../sections/InquiryCta.astro';
import Breadcrumb from '../../ui/Breadcrumb.astro';
import FeatureRow from './FeatureRow.astro';
import ScenarioCards from './ScenarioCards.astro';
import ConstructionSteps from './ConstructionSteps.astro';
import { getLangFromUrl, localizePath } from '../../../i18n/utils';

import hero from '../../../assets/solutions/industrial-floor/hero.webp';
import intro from '../../../assets/solutions/industrial-floor/intro.webp';
import scene01 from '../../../assets/solutions/industrial-floor/scene-01.webp';
import scene02 from '../../../assets/solutions/industrial-floor/scene-02.webp';
import scene03 from '../../../assets/solutions/industrial-floor/scene-03.webp';
import step01 from '../../../assets/solutions/industrial-floor/step-01.webp';
import step02 from '../../../assets/solutions/industrial-floor/step-02.webp';
import step03 from '../../../assets/solutions/industrial-floor/step-03.webp';
import step04 from '../../../assets/solutions/industrial-floor/step-04.webp';
import step05 from '../../../assets/solutions/industrial-floor/step-05.webp';

import iconDiamond from '../../../assets/icons/value-diamond.webp';
import iconShield from '../../../assets/icons/value-shield.webp';
import iconShieldOutline from '../../../assets/icons/value-shield-outline.webp';
import iconTag from '../../../assets/icons/value-tag.webp';
import iconHome from '../../../assets/icons/value-home.webp';

const lang = getLangFromUrl(Astro.url);

const c = {
  zh: {
    pageTitle: '环氧彩砂自流平地坪解决方案',
    hero: {
      eyebrow: 'EPOXY COLORED SAND SELF-LEVELING',
      title: '环氧彩砂自流平地坪',
      subtitle: '高性能 · 美观耐用 · 适用于多种工业与商业空间',
      description: 'MENARO 美纳罗提供专业的环氧彩砂自流平地坪材料与解决方案，以优质原材料和稳定的产品性能，满足工厂、仓储、商业及公共空间的地坪需求。',
      imageAlt: '环氧彩砂自流平地坪实验室检测场景',
      primary: { label: '查看产品系列', href: '/products/floor' },
      secondary: { label: '获取报价', href: '/quote' },
    },
    crumbs: [{ label: '首页', href: '/' }, { label: '解决方案', href: '/solutions' }, { label: '环氧彩砂自流平地坪' }],
    intro: {
      eyebrow: 'PRODUCT INTRODUCTION',
      title: '产品介绍',
      description: 'MENARO 环氧彩砂自流平采用优质环氧树脂为基础，加入精选彩砂骨料，通过自流平施工形成整体无缝的装饰性与功能性地面。表面具有细腻的彩砂质感，耐磨、耐压、易清洁，适用于对地面品质要求较高的工业与商业空间。',
      imageAlt: '环氧彩砂自流平地坪表面',
      cta: { label: '了解更多产品信息', href: '/products/floor' },
      features: [
        { title: '彩砂质感', desc: '美观大气' },
        { title: '整体无缝', desc: '易清洁维护' },
        { title: '耐磨抗压', desc: '适用于人流' },
        { title: '多种颜色', desc: '可定制效果' },
        { title: '应用广泛', desc: '工厂 / 仓储 / 商业' },
      ],
    },
    scenarios: {
      eyebrow: 'APPLICATION SCENARIOS',
      title: '应用场景',
      note: '适用于工厂车间、仓储物流、商业空间、公共设施等多种场景，可根据实际功能分区与使用强度配置方案。',
      items: [
        { title: '工厂车间', desc: '耐磨抗压，适应生产环境的高强度使用。' },
        { title: '仓储与物流', desc: '平整美观，便于叉车等设备通行与日常维护。' },
        { title: '商业与展示空间', desc: '多种颜色与质感选择，提升空间整体美观度。' },
      ],
    },
    steps: {
      eyebrow: 'CONSTRUCTION PROCESS',
      title: '施工流程',
      description: '专业的施工流程，确保地坪效果与使用性能。',
      items: [
        { index: '01', title: '基层处理', desc: '打磨清洁，确保表面平整' },
        { index: '02', title: '底涂施工', desc: '增强附着力' },
        { index: '03', title: '彩砂自流平施工', desc: '均匀铺设，自流找平' },
        { index: '04', title: '消泡与找平', desc: '确保表面平整无气泡' },
        { index: '05', title: '养护完成', desc: '固化后呈现细腻彩砂效果' },
      ],
    },
    cta: {
      eyebrow: 'GET IN TOUCH',
      title: '获取环氧彩砂自流平地坪解决方案',
      description: '我们提供产品选型、技术支持与定制化服务，欢迎联系我们。',
      button: { label: '提交采购询盘', href: '/quote' },
    },
  },
  en: {
    pageTitle: 'Epoxy coloured sand self-levelling flooring',
    hero: {
      eyebrow: 'EPOXY COLORED SAND SELF-LEVELING',
      title: 'Epoxy coloured sand self-levelling flooring',
      subtitle: 'High performance · Attractive and durable · For industrial and commercial spaces',
      description: 'MENARO supplies professional epoxy coloured sand self-levelling materials and solutions. With quality raw materials and consistent product performance, we meet flooring requirements in factories, warehouses, commercial and public spaces.',
      imageAlt: 'Epoxy self-levelling flooring laboratory testing',
      primary: { label: 'View product series', href: '/products/floor' },
      secondary: { label: 'Get a Quote', href: '/quote' },
    },
    crumbs: [{ label: 'Home', href: '/' }, { label: 'Solutions', href: '/solutions' }, { label: 'Epoxy coloured sand self-levelling' }],
    intro: {
      eyebrow: 'PRODUCT INTRODUCTION',
      title: 'Product introduction',
      description: 'MENARO epoxy coloured sand self-levelling is based on quality epoxy resin with selected coloured sand aggregate. Applied as a self-levelling system, it forms a seamless decorative and functional floor with a fine sand texture that is wear resistant, load bearing and easy to clean — suited to industrial and commercial spaces with higher flooring requirements.',
      imageAlt: 'Epoxy coloured sand floor surface',
      cta: { label: 'More product information', href: '/products/floor' },
      features: [
        { title: 'Coloured sand finish', desc: 'Attractive appearance' },
        { title: 'Seamless', desc: 'Easy to clean and maintain' },
        { title: 'Wear and load resistant', desc: 'For high foot traffic' },
        { title: 'Colour options', desc: 'Customisable effects' },
        { title: 'Wide application', desc: 'Factory / warehouse / retail' },
      ],
    },
    scenarios: {
      eyebrow: 'APPLICATION SCENARIOS',
      title: 'Application scenarios',
      note: 'Suitable for factory floors, warehousing and logistics, commercial spaces and public facilities; systems are configured to the functional zones and traffic intensity.',
      items: [
        { title: 'Factory floors', desc: 'Wear and load resistant for intensive production environments.' },
        { title: 'Warehousing & logistics', desc: 'Level and attractive, easy for forklifts and daily maintenance.' },
        { title: 'Retail & showrooms', desc: 'A range of colours and textures to enhance the space.' },
      ],
    },
    steps: {
      eyebrow: 'CONSTRUCTION PROCESS',
      title: 'Construction process',
      description: 'A professional process that safeguards the finished floor and its performance.',
      items: [
        { index: '01', title: 'Substrate preparation', desc: 'Grind and clean to a level surface' },
        { index: '02', title: 'Primer', desc: 'Improve adhesion' },
        { index: '03', title: 'Self-levelling application', desc: 'Apply evenly and let it self-level' },
        { index: '04', title: 'De-aeration and levelling', desc: 'Ensure a level surface without bubbles' },
        { index: '05', title: 'Curing', desc: 'Fine coloured sand finish after curing' },
      ],
    },
    cta: {
      eyebrow: 'GET IN TOUCH',
      title: 'Request an epoxy coloured sand flooring solution',
      description: 'We provide product selection, technical support and customisation — get in touch.',
      button: { label: 'Send an enquiry', href: '/quote' },
    },
  },
}[lang];

const featureIcons = [iconDiamond, iconShieldOutline, iconShield, iconTag, iconHome];
const features = c.intro.features.map((f, i) => ({ ...f, icon: featureIcons[i] }));
const sceneImages = [scene03, scene01, scene02];
const scenarios = c.scenarios.items.map((s, i) => ({ ...s, image: sceneImages[i] }));
const stepImages = [step01, step02, step03, step04, step05];
const steps = c.steps.items.map((s, i) => ({ ...s, image: stepImages[i] }));
---

<Base title={c.pageTitle}>
  <PageHero
    eyebrow={c.hero.eyebrow}
    title={c.hero.title}
    subtitle={c.hero.subtitle}
    description={c.hero.description}
    image={hero}
    imageAlt={c.hero.imageAlt}
    primary={c.hero.primary}
    secondary={c.hero.secondary}
    variant="wide"
  />

  <Breadcrumb items={c.crumbs} />

  <section class="bg-base-100 py-14 lg:py-20">
    <Container>
      <div class="grid grid-cols-1 items-center gap-10 lg:grid-cols-2 lg:gap-16">
        <Image
          src={intro}
          alt={c.intro.imageAlt}
          widths={[600, 900, 1186]}
          sizes="(min-width: 1024px) 50vw, 100vw"
          class="aspect-[4/3] w-full rounded-box object-cover"
          loading="lazy"
        />
        <div class="flex flex-col gap-4">
          <p class="text-[12px] tracking-[0.08em] text-mn-muted">{c.intro.eyebrow}</p>
          <h2 class="text-[26px] leading-tight font-bold tracking-tight text-mn-ink lg:text-[34px]">{c.intro.title}</h2>
          <p class="text-[14px] leading-7 text-mn-muted">{c.intro.description}</p>
          <FeatureRow items={features} />
          <div class="pt-2">
            <Button href={localizePath(c.intro.cta.href, lang)} withArrow>{c.intro.cta.label}</Button>
          </div>
        </div>
      </div>
    </Container>
  </section>

  <ScenarioCards
    eyebrow={c.scenarios.eyebrow}
    title={c.scenarios.title}
    note={c.scenarios.note}
    items={scenarios}
  />

  <ConstructionSteps
    eyebrow={c.steps.eyebrow}
    title={c.steps.title}
    description={c.steps.description}
    steps={steps}
  />

  <InquiryCta eyebrow={c.cta.eyebrow} title={c.cta.title} description={c.cta.description} cta={c.cta.button} />
</Base>