---
// 项目案例页：筛选标签 + 案例网格（含轻量前端筛选）
import ProjectCards from "../shared/ProjectCards.astro";
import { caseCategories, caseList } from "../../data/cases/caseList";

const categories = caseCategories.map((category) => ({
  value: category.value,
  label: category.zh.label,
}));

const cases = caseList();
---

<section class="w-full bg-white px-4 py-12 sm:px-6">
  <div class="mx-auto max-w-7xl">
    <!-- 筛选标签 -->
    <div
      class="flex flex-wrap items-center justify-center gap-2 rounded-2xl bg-neutral-100 p-3"
    >
      {
        categories.map((category, index) => (
          <button
            type="button"
            data-filter={category.value}
            data-filter-default={index === 0 ? "true" : undefined}
            class:list={[
              "flex-1 rounded-xl px-5 py-2.5 text-sm font-semibold whitespace-nowrap transition-colors",
              index === 0
                ? "bg-[#6b5537] text-white"
                : "text-neutral-600 hover:bg-white",
            ]}
          >
            {category.label}
          </button>
        ))
      }
    </div>

    <!-- 案例网格 -->
    <div class="mt-6 rounded-3xl bg-[#e9e3d9] p-6 sm:p-8">
      <ProjectCards items={cases} />
    </div>
  </div>
</section>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>("[data-filter]");
  const cards = document.querySelectorAll<HTMLElement>("[data-project-card]");

  buttons.forEach((button) => {
    button.addEventListener("click", () => {
      const filter = button.dataset.filter ?? "all";

      buttons.forEach((item) => {
        const active = item === button;
        item.classList.toggle("bg-[#6b5537]", active);
        item.classList.toggle("text-white", active);
        item.classList.toggle("text-neutral-600", !active);
      });

      cards.forEach((card) => {
        const visible =
          filter === "all" || card.dataset.category === filter;
        card.classList.toggle("hidden", !visible);
      });
    });
  });
</script>
