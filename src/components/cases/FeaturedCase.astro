---
// 项目案例页：精选案例（左信息 / 中图 / 右文案 + 底部引述）
import { featuredProject } from "../../data/cases/caseList";
import { featuredCaseUi } from "../../data/cases/featuredCase";
import { bySlug as productBySlug } from "../../data/products/catalog";

const t = featuredCaseUi.zh;
const project = featuredProject();

const featured = project.featured;
if (!featured) {
  throw new Error("[FeaturedCase] 精选项目缺少 zh.featured 字段");
}

// 「使用产品」按 slug 引用产品，改产品名这里自动跟着变
const usedProduct = productBySlug(featured.productSlug);

const meta = [
  { term: t.metaType, value: featured.type },
  { term: t.metaArea, value: featured.area },
  { term: t.metaProduct, value: `MENARO${usedProduct.name}` },
  { term: t.metaYear, value: featured.year },
];
---

<section class="w-full bg-white px-4 py-16 sm:px-6">
  <div class="mx-auto max-w-7xl">
    <div
      class="rounded-3xl bg-white p-6 shadow-[0_18px_50px_-24px_rgba(0,0,0,0.3)] sm:p-10"
    >
      <div class="grid gap-8 lg:grid-cols-[auto_1.2fr_1fr] lg:gap-10">
        <!-- 左：项目信息 -->
        <dl class="flex flex-col gap-5 text-xs">
          {
            meta.map((item) => (
              <div>
                <dt class="text-neutral-500">{item.term}</dt>
                <dd class="mt-1 font-semibold text-neutral-800">
                  {item.value}
                </dd>
              </div>
            ))
          }
        </dl>

        <!-- 中：图片 -->
        <img
          src={project.image}
          alt={project.name}
          class="h-72 w-full rounded-2xl object-cover lg:h-80"
        />

        <!-- 右：文案 -->
        <div class="flex flex-col items-end gap-3 text-right">
          <span class="text-xs text-neutral-500">{t.kicker}</span>
          <h3 class="text-2xl font-bold text-neutral-800">{project.name}</h3>
          <p class="text-xs text-neutral-500">{project.location}</p>
          <p class="text-xs leading-relaxed text-neutral-500">
            {featured.blurb}
          </p>
        </div>
      </div>

      <!-- 引述 -->
      <figure class="mt-10 text-right">
        <blockquote class="text-xs leading-relaxed text-neutral-600 italic">
          {featured.quote}
        </blockquote>
        <figcaption class="mt-1 text-xs text-neutral-500">
          {featured.quoteBy}
        </figcaption>
      </figure>
    </div>
  </div>
</section>
