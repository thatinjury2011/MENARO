---
// 联系 · 获取报价页：页面主体（/contact 与 /quote 共用）
import CtaSection from "../shared/CtaSection.astro";
import PageHero from "../shared/PageHero.astro";
import ConnectPanel from "./ConnectPanel.astro";
import ContactInfoCard from "./ContactInfoCard.astro";
import HelpOptions from "./HelpOptions.astro";
import Location from "./Location.astro";
import MessageCard from "./MessageCard.astro";

const heroFeatures = [
  { name: "快速响应" },
  { name: "专家支持" },
  { name: "全球服务" },
  { name: "可靠品质" },
];
---

<PageHero
  label="MENARO"
  title="联系 · 获取报价"
  subtitle="有问题或项目需求？"
  subtitleClass="text-white"
  description="我们的团队将帮助您找到合适的解决方案"
  features={heroFeatures}
  bgImage="/images/contact/hero.webp"
/>

<!-- 发送消息 + 联系信息 -->
<section class="w-full bg-white px-4 pt-12 sm:px-6">
  <div class="mx-auto grid max-w-7xl gap-6 lg:grid-cols-2">
    <MessageCard />
    <ContactInfoCard />
  </div>
</section>

<Location />
<HelpOptions />
<ConnectPanel />
<CtaSection
  title="还有其他问题？"
  description="我们的专家团队可提供专业建议和定制化解决方案"
/>
