---
// 联系页：发送消息卡片（含公司名称）
import QuoteForm from "../shared/QuoteForm.astro";
import { messageCard } from "../../data/contact/messageCard";
import { localeOf } from "../../i18n/locales";

const locale = localeOf(Astro.currentLocale);

const t = messageCard[locale];
---

<div class="rounded-2xl bg-white p-6 shadow-[0_18px_50px_-24px_rgba(0,0,0,0.3)] sm:p-8">
  <h2 class="text-center text-lg font-bold text-[#6b5537]">{t.title}</h2>
  <p class="mt-1 text-center text-xs text-neutral-500">
    {t.description}
  </p>
  <QuoteForm withCompany class="mt-6" />
</div>
