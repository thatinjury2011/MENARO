---
// 联系页：联系信息卡片
// 邮箱 / 电话 / WhatsApp 的值与标签来自 src/data/site.ts 的 contact、contactLabels
import { brandName, contact, contactLabels, legalName } from "../../data/site";
import { contactInfoCard } from "../../data/contact/contactInfoCard";

const t = contactInfoCard.zh;
const labels = contactLabels.zh;

const rows = [
  [
    { term: labels.email, value: contact.email.value },
    { term: labels.phone, value: contact.phone.value },
  ],
  [
    { term: labels.whatsapp, value: contact.whatsapp.value },
    { term: t.hoursLabel, value: t.hours },
  ],
];
---

<div class="rounded-2xl bg-[#f8f3ea] p-6 sm:p-8">
  <h2 class="text-center text-lg font-bold text-[#6b5537]">{t.title}</h2>
  <p class="mt-1 text-center text-xs text-neutral-500">
    {t.description}
  </p>

  <div class="mt-8 flex flex-col divide-y divide-neutral-200">
    <!-- 公司 -->
    <div class="pb-6 text-center">
      <p class="text-xs font-bold text-neutral-800">{brandName.zh}</p>
      <p class="mt-1 text-xs text-neutral-500">{legalName}</p>
    </div>

    <!-- 邮箱 / 电话 -->
    {
      rows.map((row) => (
        <div class="grid grid-cols-2 gap-4 py-6 text-center">
          {row.map((cell) => (
            <div class="flex flex-col gap-1">
              <p class="text-xs font-bold text-neutral-800">{cell.term}</p>
              <p class="text-xs text-neutral-500">{cell.value}</p>
            </div>
          ))}
        </div>
      ))
    }

    <!-- 总部 -->
    <div class="pt-6 text-center">
      <p class="text-xs font-bold text-neutral-800">{t.hqLabel}</p>
      <p class="mt-1 text-xs leading-relaxed text-neutral-500">
        {contact.address.zh.full}
      </p>
    </div>
  </div>
</div>
