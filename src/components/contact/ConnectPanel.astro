---
// 联系页：WhatsApp 二维码 + 数据条
// 图片约定：/images/global/whatsapp-qr.png
//   透明底 + 白色码点，必须配深色底才看得见（不可再用 bg-white）
import StatsBar from "../shared/StatsBar.astro";

const stats = [
  { label: "服务国家", value: "100+" },
  { label: "行业经验", value: "10+" },
  { label: "完成项目", value: "5000+" },
  { label: "技术专家", value: "50+" },
];
---

<section class="w-full bg-white px-4 pb-16 sm:px-6">
  <div class="mx-auto grid max-w-7xl gap-6 lg:grid-cols-[1fr_2fr]">
    <!-- 二维码 -->
    <div
      class="flex flex-col items-center justify-center gap-3 rounded-2xl bg-neutral-100 px-6 py-8 text-center"
    >
      <h3 class="text-base font-bold text-[#6b5537]">联系我们</h3>
      <p class="text-xs leading-relaxed text-neutral-500">
        扫描二维码添加 WhatsApp<br />便于快速沟通
      </p>
      <img
        src="/images/global/whatsapp-qr.png"
        alt="WhatsApp 二维码"
        class="mt-2 size-28 rounded-lg bg-[#4a3a24] object-contain p-2"
      />
    </div>

    <!-- 数据 -->
    <div
      class="flex flex-col justify-center gap-6 rounded-2xl bg-neutral-100 px-8 py-8"
    >
      <div class="text-right">
        <p class="text-sm font-semibold text-neutral-800">
          让我们一起打造优秀项目
        </p>
        <p class="mt-1 text-xs leading-relaxed text-neutral-500">
          无论您有问题、需要支持，还是想讨论项目，我们都将帮助您推进成功
        </p>
      </div>
      <StatsBar items={stats} />
    </div>
  </div>
</section>
