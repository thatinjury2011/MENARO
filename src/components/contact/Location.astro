---
// 联系页：我们的位置（地图 + 地址说明）
// 图片约定：/images/contact/map.webp
// 城市与地址来自 src/data/site.ts 的 contact.address
import { contact } from "../../data/site";
import { location } from "../../data/contact/location";

const t = location.zh;
---

<section class="w-full bg-white px-4 py-16 sm:px-6">
  <div
    class="mx-auto grid max-w-7xl items-center gap-10 lg:grid-cols-2 lg:gap-14"
  >
    <img
      src="/images/contact/map.webp"
      alt={t.imageAlt}
      class="w-full rounded-2xl object-cover shadow-[0_18px_50px_-24px_rgba(0,0,0,0.3)]"
    />

    <div class="flex flex-col items-end gap-3 text-right">
      <h2 class="text-2xl font-bold text-[#6b5537]">{t.heading}</h2>
      <p class="text-base font-bold text-neutral-800">{contact.address.zh.city}</p>
      <p class="text-xs leading-relaxed text-neutral-500">
        {contact.address.zh.line1}<br />{contact.address.zh.line2}
      </p>
      <a
        href="#"
        class="mt-3 rounded-lg bg-[#6b5537] px-6 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-[#5a4730]"
      >
        {t.cta}
      </a>
    </div>
  </div>
</section>
