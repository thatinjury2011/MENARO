---
// 联系页：我们可以如何帮助您？（3 张卡片）
// 图片约定：/images/global/team-cta.webp
import SectionTitle from "../shared/SectionTitle.astro";
import { helpOptions } from "../../data/contact/helpOptions";
import { localeOf } from "../../i18n/locales";

const locale = localeOf(Astro.currentLocale);

const t = helpOptions[locale];
---

<section class="w-full bg-white px-4 py-16 sm:px-6">
  <div class="mx-auto max-w-7xl">
    <SectionTitle title={t.title} variant="highlight" class="mt-4" />

    <div class="mt-10 grid gap-6 sm:grid-cols-3">
      {
        t.options.map((option) => (
          <div class="flex flex-col items-center gap-3 rounded-2xl bg-neutral-100 px-6 py-9 text-center">
            <h3 class="text-base font-bold text-[#6b5537]">{option.name}</h3>
            <p class="text-xs leading-relaxed text-neutral-500">
              {option.desc}
            </p>
            <a
              href="#"
              class="mt-2 rounded-md bg-[#cbb49c] px-5 py-1.5 text-xs font-semibold text-[#4a3a24] transition-colors hover:bg-[#c0a58a]"
            >
              {option.link}›
            </a>
          </div>
        ))
      }
    </div>
  </div>
</section>
