---
// 解决方案页：施工流程（6 步 + 竖分隔）
import SectionTitle from "../shared/SectionTitle.astro";
import Icon from "../shared/Icon.astro";
import { processSteps } from "../../data/solutions/processSteps";

const t = processSteps.zh;
---

<section class="w-full bg-white px-4 py-16 sm:px-6">
  <div class="mx-auto max-w-7xl">
    <SectionTitle title={t.title} />

    <div
      class="mt-10 flex flex-col divide-y divide-neutral-200 rounded-2xl bg-white px-4 py-6 shadow-[0_18px_50px_-24px_rgba(0,0,0,0.25)] sm:flex-row sm:divide-x sm:divide-y-0"
    >
      {
        t.steps.map((step) => (
          <div class="flex flex-1 flex-col items-center gap-2 px-3 py-4 text-center">
            <Icon name={step.icon} class="size-7 text-amber-700/80" />
            <h3
              class="border-b border-neutral-300 pb-1 text-sm font-bold text-neutral-800"
            >
              {step.name}
            </h3>
            <p class="text-xs leading-relaxed text-neutral-500">{step.desc}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
