---
// 解决方案页：浴室解决方案（左大图 / 右标题 + 2×2 特性）
// 图片约定：/images/solutions/bathroom-solution.webp
import FeatureBadges from "../shared/FeatureBadges.astro";
import { bathroomSolution } from "../../data/solutions/bathroomSolution";
import { localeOf } from "../../i18n/locales";

const locale = localeOf(Astro.currentLocale);

const t = bathroomSolution[locale];
---

<section class="w-full bg-white px-4 py-16 sm:px-6">
  <div
    class="mx-auto grid max-w-6xl items-center gap-10 md:grid-cols-2 lg:gap-14"
  >
    <div class="overflow-hidden rounded-3xl">
      <img
        src="/images/solutions/bathroom-solution.webp"
        alt={t.imageAlt}
        class="h-80 w-full object-cover lg:h-96"
      />
    </div>

    <div class="flex flex-col gap-4">
      <h2 class="text-2xl font-bold text-neutral-800">{t.title}</h2>
      <p class="text-xs leading-relaxed text-neutral-500">
        {t.descriptionLines[0]}<br />{t.descriptionLines[1]}
      </p>
      <FeatureBadges
        items={t.features}
        tone="dark"
        orientation="stacked"
        class="mt-2"
      />
    </div>
  </div>
</section>
