---
// 解决方案页：应用空间（米色面板内 3×2 图片网格）
import SectionTitle from "../shared/SectionTitle.astro";

const spaces = [
  { name: "浴室", image: "/images/solutions/space-1.webp" },
  { name: "厨房", image: "/images/solutions/space-2.webp" },
  { name: "商业空间", image: "/images/solutions/space-3.webp" },
  { name: "高端住宅", image: "/images/solutions/space-4.webp" },
  { name: "酒店项目", image: "/images/solutions/space-5.webp" },
  { name: "公共基础设施", image: "/images/solutions/space-6.webp" },
];
---

<section class="w-full bg-white px-4 py-16 sm:px-6">
  <div class="mx-auto max-w-6xl">
    <SectionTitle title="应用空间" />

    <div class="mt-10 rounded-3xl bg-[#e9e3d9] p-6 sm:p-10">
      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          spaces.map((space) => (
            <div class="relative overflow-hidden rounded-2xl">
              <img
                src={space.image}
                alt={space.name}
                class="h-56 w-full object-cover"
              />
              <span class="absolute bottom-4 left-4 text-xl font-bold text-white drop-shadow-lg">
                {space.name}
              </span>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
