---
// 关于我们页：品牌故事（MENARO 水印 + 图文卡 + 三大支柱）
// 图片约定：/images/about/story.webp
import SectionTitle from "../shared/SectionTitle.astro";
import Icon from "../shared/Icon.astro";
import { brandStory, brandStoryWatermark } from "../../data/about/brandStory";
import { localeOf } from "../../i18n/locales";

const locale = localeOf(Astro.currentLocale);

const t = brandStory[locale];
---

<section class="relative w-full overflow-hidden bg-white px-4 py-16 sm:px-6">
  <div class="mx-auto max-w-7xl">
    <!-- 标题 + MENARO 水印 -->
    <div class="relative flex items-center justify-center">
      <span
        class="absolute inset-x-0 text-center text-[4rem] leading-none font-black tracking-tight text-neutral-100 select-none lg:text-[6.5rem]"
        aria-hidden="true">{brandStoryWatermark}</span
      >
      <SectionTitle title={t.title} variant="highlight" class="relative" />
    </div>

    <!-- 图文卡 -->
    <div
      class="mt-8 grid gap-8 rounded-3xl bg-white p-6 shadow-[0_18px_50px_-24px_rgba(0,0,0,0.3)] lg:grid-cols-2 lg:p-10"
    >
      <div class="flex flex-col gap-5">
        <h3 class="text-xl font-bold text-neutral-800">{t.heading}</h3>
        {
          t.paragraphs.map((paragraph) => (
            <p class="text-xs leading-relaxed text-neutral-500">{paragraph}</p>
          ))
        }

        <div class="mt-2 grid grid-cols-2 gap-4 sm:grid-cols-4">
          {
            t.stats.map((stat) => (
              <div class="flex flex-col gap-1">
                <span class="text-[10px] text-neutral-500">{stat.label}</span>
                <span class="text-lg font-bold text-neutral-800">
                  {stat.value}
                </span>
              </div>
            ))
          }
        </div>

        <div
          class="mt-2 w-fit rounded-lg border border-neutral-300 px-5 py-2 text-center"
        >
          <p class="text-sm font-semibold text-neutral-800">{t.originBadge.title}</p>
          <p class="text-[10px] text-neutral-500">{t.originBadge.desc}</p>
        </div>
      </div>

      <img
        src="/images/about/story.webp"
        alt={t.imageAlt}
        class="h-72 w-full rounded-2xl object-cover lg:h-full"
      />
    </div>

    <!-- 三大支柱 -->
    <div
      class="mt-10 grid grid-cols-1 divide-y divide-neutral-200 rounded-2xl bg-white py-2 text-center sm:grid-cols-3 sm:divide-x sm:divide-y-0"
    >
      {
        t.pillars.map((pillar) => (
          <div class="flex flex-col items-center gap-2 px-6 py-8">
            <Icon name={pillar.icon} class="size-6 text-amber-700/80" />
            <h3 class="text-sm font-bold text-neutral-800">{pillar.name}</h3>
            <p class="text-xs leading-relaxed text-neutral-500">
              {pillar.desc}
            </p>
          </div>
        ))
      }
    </div>
  </div>
</section>
