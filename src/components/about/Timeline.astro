---
// 关于我们页：发展历程（横向时间轴，lg 下上下交错）
import SectionTitle from "../shared/SectionTitle.astro";
import { timeline } from "../../data/about/timeline";

const t = timeline.zh;
---

<section class="w-full bg-white px-4 py-16 sm:px-6">
  <div class="mx-auto max-w-7xl">
    <SectionTitle title={t.title} variant="highlight" />

    <div class="relative mt-12">
      <!-- 时间轴横线（仅大屏） -->
      <div
        class="absolute inset-x-0 top-1/2 hidden h-px -translate-y-1/2 bg-neutral-300 lg:block"
      >
      </div>

      <ol class="relative grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-6 lg:gap-0">
        {
          t.milestones.map((item, index) => {            const above = index % 2 === 1;
            return (
              <li class="relative flex flex-col items-center lg:h-40">
                <span class="absolute top-1/2 hidden size-2.5 -translate-y-1/2 rounded-full bg-[#6b5537] lg:block" />
                <div
                  class:list={[
                    "flex flex-col items-center gap-0.5 text-center lg:absolute lg:inset-x-0",
                    above ? "lg:bottom-1/2 lg:mb-5" : "lg:top-1/2 lg:mt-5",
                  ]}
                >
                  <p class="text-base font-bold text-neutral-800">{item.year}</p>
                  <p class="text-[10px] leading-relaxed text-neutral-500">
                    {item.label}
                  </p>
                </div>
              </li>
            );
          })
        }
      </ol>
    </div>
  </div>
</section>
