---
import { navItems, quoteCta } from '../../data/site';

const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<header class="sticky top-0 z-50 border-b border-base-300 bg-base-100/95 backdrop-blur-md">
  <div
    class="mx-auto flex h-16 w-full max-w-[90rem] items-center gap-4 px-5 lg:h-[116px] lg:gap-10 lg:px-10"
  >
    <a href="/" class="flex shrink-0 items-center" aria-label="MENARO 首页">
      <img
        src="/brand/logo.png"
        alt="MENARO"
        width="237"
        height="82"
        class="h-9 w-auto lg:h-10"
      />
    </a>

    <nav aria-label="主导航" class="hidden flex-1 items-center justify-center gap-6 lg:flex xl:gap-9">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            aria-current={isActive(item.href) ? 'page' : undefined}
            class:list={[
              'group/nav relative py-1.5 text-sm font-medium tracking-wide transition-colors duration-200',
              'after:absolute after:inset-x-0 after:bottom-0 after:h-0.5 after:origin-left after:scale-x-0 after:bg-mn-green-hover after:transition-transform after:duration-300',
              'hover:text-mn-green-hover hover:after:scale-x-100',
              isActive(item.href) ? 'text-mn-green after:scale-x-100' : 'text-mn-ink',
            ]}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="ml-auto flex items-center gap-2 lg:ml-0">
      <a href={quoteCta.href} class="btn btn-primary hidden text-sm lg:inline-flex">
        {quoteCta.label}
      </a>

      <details class="dropdown dropdown-end lg:hidden">
        <summary class="btn btn-square btn-ghost" aria-label="打开导航菜单">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="size-5"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="1.8"
            aria-hidden="true"
          >
            <path stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16"></path>
          </svg>
        </summary>
        <ul
          class="menu dropdown-content z-50 mt-3 w-60 rounded-box border border-base-300 bg-base-100 p-2 shadow-lg"
        >
          {
            navItems.map((item) => (
              <li>
                <a
                  href={item.href}
                  aria-current={isActive(item.href) ? 'page' : undefined}
                  class:list={['py-3', isActive(item.href) && 'font-semibold']}
                >
                  {item.label}
                </a>
              </li>
            ))
          }
          <li class="mt-2">
            <a href={quoteCta.href} class="btn btn-primary btn-block">{quoteCta.label}</a>
          </li>
        </ul>
      </details>
    </div>
  </div>
</header>
