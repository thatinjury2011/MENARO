---
import Container from '../ui/Container.astro';
import ArrowIcon from '../ui/ArrowIcon.astro';
import { getLangFromUrl, localizePath, alternateLangHref } from '../../i18n/utils';
import { langLabel } from '../../i18n/config';
import { ui } from '../../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const t = ui[lang];
const otherLang = lang === 'zh' ? 'en' : 'zh';

const rawPath = Astro.url.pathname;
const path = lang === 'zh' ? rawPath : rawPath.replace(/^\/en(?=\/|$)/, '') || '/';
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
const switchHref = alternateLangHref(Astro.url, otherLang);
---

<header class="sticky top-0 z-50 border-b border-mn-border bg-[#f8f9f7]/95 backdrop-blur-md">
  <Container class="flex h-16 items-center gap-6 lg:h-[116px] lg:gap-10">
    <a href={localizePath('/', lang)} class="flex shrink-0 items-center" aria-label={t.logoLabel}>
      <img
        src="/brand/logo.png"
        alt={t.logoAlt}
        width="237"
        height="82"
        class="h-10 w-auto lg:h-[60px] 2xl:h-[82px]"
      />
    </a>

    <nav aria-label={t.navAria} class="hidden items-center gap-4 lg:ml-auto lg:flex xl:gap-6 2xl:ml-[270px] 2xl:gap-[44px]">
      {
        t.nav.map((item) => (
          <a
            href={localizePath(item.href, lang)}
            aria-current={isActive(item.href) ? 'page' : undefined}
            class:list={[
              'group/nav relative py-1.5 text-[14px] font-bold whitespace-nowrap transition-colors duration-200 lg:text-[15px] 2xl:text-[16px]',
              'after:absolute after:inset-x-0 after:bottom-0 after:h-0.5 after:origin-left after:scale-x-0 after:bg-mn-green-hover after:transition-transform after:duration-300',
              'hover:text-mn-green-hover hover:after:scale-x-100',
              isActive(item.href) ? 'text-mn-green after:scale-x-100' : 'text-mn-ink',
            ]}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="ml-auto flex items-center gap-2 lg:gap-4 2xl:gap-3">
      <a
        href={switchHref}
        hreflang={otherLang === 'zh' ? 'zh-CN' : 'en'}
        lang={otherLang === 'zh' ? 'zh-CN' : 'en'}
        class="hidden items-center gap-1 text-[14px] text-mn-ink transition-colors hover:text-mn-green xl:inline-flex 2xl:text-[16px]"
        aria-label={t.langSwitchAria}
      >
        {langLabel[lang]}
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" class="size-3" aria-hidden="true">
          <path d="m6 9 6 6 6-6"></path>
        </svg>
      </a>

      <a
        href={localizePath(t.quote.href, lang)}
        class="inline-flex h-[54px] min-w-[130px] shrink-0 items-center justify-between gap-3 rounded-[4px] bg-mn-green px-5 text-[14px] leading-[21px] font-bold whitespace-nowrap text-white transition-colors hover:bg-mn-green-hover"
      >
        {t.quote.label}
        <ArrowIcon className="size-[22px]" />
      </a>

      <details class="dropdown dropdown-end lg:hidden">
        <summary class="btn btn-square btn-ghost" aria-label={t.menuAria}>
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="size-5"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="1.8"
            aria-hidden="true"
          >
            <path stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16"></path>
          </svg>
        </summary>
        <ul
          class="menu dropdown-content z-50 mt-3 w-60 rounded-box border border-mn-border bg-base-100 p-2 shadow-lg"
        >
          {
            t.nav.map((item) => (
              <li>
                <a
                  href={localizePath(item.href, lang)}
                  aria-current={isActive(item.href) ? 'page' : undefined}
                  class:list={['py-3', isActive(item.href) && 'font-semibold']}
                >
                  {item.label}
                </a>
              </li>
            ))
          }
          <li>
            <a href={switchHref} class="py-3" hreflang={otherLang === 'zh' ? 'zh-CN' : 'en'}>
              {langLabel[lang]}
            </a>
          </li>
        </ul>
      </details>
    </div>
  </Container>
</header>