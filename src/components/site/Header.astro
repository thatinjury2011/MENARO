---
import Container from '../ui/Container.astro';
import { navItems, quoteCta } from '../../data/site';

const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<header class="sticky top-0 z-50 border-b border-mn-border bg-base-100/95 backdrop-blur-md">
  <Container class="flex h-16 items-center gap-6 lg:h-[116px] lg:gap-10">
    <a href="/" class="flex shrink-0 items-center" aria-label="MENARO 首页">
      <img src="/brand/logo.png" alt="MENARO" width="237" height="82" class="h-9 w-auto lg:h-11" />
    </a>

    <nav aria-label="主导航" class="hidden flex-1 items-center justify-center gap-4 lg:flex xl:gap-7">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            aria-current={isActive(item.href) ? 'page' : undefined}
            class:list={[
              'group/nav relative py-1.5 text-[14px] font-medium whitespace-nowrap transition-colors duration-200 xl:text-[15px]',
              'after:absolute after:inset-x-0 after:bottom-0 after:h-0.5 after:origin-left after:scale-x-0 after:bg-mn-green-hover after:transition-transform after:duration-300',
              'hover:text-mn-green-hover hover:after:scale-x-100',
              isActive(item.href) ? 'text-mn-green after:scale-x-100' : 'text-mn-ink',
            ]}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="ml-auto flex items-center gap-2 lg:ml-0 lg:gap-4">
      <button
        type="button"
        class="hidden items-center gap-1 text-[14px] text-mn-ink transition-colors hover:text-mn-green xl:inline-flex"
        aria-label="切换语言（当前：中文）"
      >
        中文
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" class="size-3" aria-hidden="true">
          <path d="m6 9 6 6 6-6"></path>
        </svg>
      </button>

      <a
        href={quoteCta.href}
        class="btn btn-primary h-auto min-h-0 rounded-field px-5 py-3 text-sm shadow-none"
      >
        {quoteCta.label}
      </a>

      <details class="dropdown dropdown-end lg:hidden">
        <summary class="btn btn-square btn-ghost" aria-label="打开导航菜单">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="size-5"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="1.8"
            aria-hidden="true"
          >
            <path stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16"></path>
          </svg>
        </summary>
        <ul
          class="menu dropdown-content z-50 mt-3 w-60 rounded-box border border-mn-border bg-base-100 p-2 shadow-lg"
        >
          {
            navItems.map((item) => (
              <li>
                <a
                  href={item.href}
                  aria-current={isActive(item.href) ? 'page' : undefined}
                  class:list={['py-3', isActive(item.href) && 'font-semibold']}
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </details>
    </div>
  </Container>
</header>
