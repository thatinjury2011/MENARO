---
import Container from '../ui/Container.astro';
import { getLangFromUrl, localizePath } from '../../i18n/utils';
import { ui } from '../../i18n/ui';

import linkedin from '../../assets/icons/social-linkedin.webp';
import youtube from '../../assets/icons/social-youtube.webp';
import wechat from '../../assets/icons/social-wechat.webp';
import whatsapp from '../../assets/icons/social-whatsapp.webp';

const lang = getLangFromUrl(Astro.url);
const t = ui[lang];
const year = new Date().getFullYear();

const socials = [
  { label: t.social.linkedin, href: '#', icon: linkedin },
  { label: t.social.youtube, href: '#', icon: youtube },
  { label: t.social.wechat, href: '#', icon: wechat },
  { label: t.social.whatsapp, href: '#', icon: whatsapp },
];
---

<footer class="border-t border-mn-border bg-base-100">
  <Container>
    <div class="flex flex-col gap-8 py-10 lg:flex-row lg:items-center lg:justify-between lg:py-9">
      <div class="flex flex-col gap-2">
        <a href={localizePath('/', lang)} class="inline-flex items-center" aria-label={t.logoLabel}>
          <img src="/brand/logo.png" alt={t.logoAlt} width="237" height="82" class="h-10 w-auto" />
        </a>
        <p class="text-xs text-mn-muted">{t.tagline}</p>
      </div>

      <nav aria-label={t.footerNavAria} class="flex flex-wrap items-center gap-x-7 gap-y-2">
        {
          [...t.nav, t.quote].map((item) => (
            <a
              href={localizePath(item.href, lang)}
              class="text-[13px] text-mn-ink transition-colors hover:text-mn-green"
            >
              {item.label}
            </a>
          ))
        }
      </nav>

      <ul class="flex items-center gap-4">
        {
          socials.map((s) => (
            <li>
              <a href={s.href} aria-label={s.label} class="block opacity-80 transition-opacity hover:opacity-100">
                <img src={s.icon.src} alt="" width="34" height="34" class="size-6" loading="lazy" />
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div
      class="flex flex-col gap-3 border-t border-mn-border py-5 text-xs text-mn-muted sm:flex-row sm:items-center sm:justify-between"
    >
      <p>© {year} MENARO. All Rights Reserved.</p>
      <ul class="flex flex-wrap items-center gap-x-5 gap-y-2">
        {
          t.legal.map((item) => (
            <li>
              <a href={localizePath(item.href, lang)} class="transition-colors hover:text-mn-green">
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </Container>
</footer>