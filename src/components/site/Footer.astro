---
import Container from '../ui/Container.astro';
import { getLangFromUrl, localizePath } from '../../i18n/utils';
import { ui } from '../../i18n/ui';

import linkedin from '../../assets/icons/social-linkedin.webp';
import youtube from '../../assets/icons/social-youtube.webp';
import wechat from '../../assets/icons/social-wechat.webp';
import whatsapp from '../../assets/icons/social-whatsapp.webp';
import linkedinWhite from '../../assets/icons/social-linkedin-white.webp';
import youtubeWhite from '../../assets/icons/social-youtube-white.webp';
import wechatWhite from '../../assets/icons/social-wechat-white.webp';
import whatsappWhite from '../../assets/icons/social-whatsapp-white.webp';

interface Props {
  /** light：米白底部（多数页面）；dark：深绿底部（联系我们 / 获取报价这类无 CTA 带的下单页） */
  theme?: 'light' | 'dark';
}

const { theme = 'light' } = Astro.props;
const dark = theme === 'dark';
const lang = getLangFromUrl(Astro.url);
const t = ui[lang];
const year = new Date().getFullYear();

const socials = [
  { label: t.social.linkedin, href: '#', icon: dark ? linkedinWhite : linkedin, external: false },
  { label: t.social.youtube, href: '#', icon: dark ? youtubeWhite : youtube, external: false },
  { label: t.social.wechat, href: '#', icon: dark ? wechatWhite : wechat, external: false },
  { label: t.social.whatsapp, href: 'https://wa.me/8613738577658', icon: dark ? whatsappWhite : whatsapp, external: true },
];
---

<footer
  class:list={[dark ? 'bg-[#01362d]' : 'bg-[#fbfaf6]']}
  style="font-size: clamp(4.8px, calc(100vw / 290), 6.8px)"
>
  <Container>
    <div class="lg:px-[2.7em]">
      <div class="flex flex-col gap-5 py-8 lg:flex-row lg:items-center lg:gap-0 lg:py-[1.7em]">
        <a href={localizePath('/', lang)} class="inline-flex shrink-0 items-center" aria-label={t.logoLabel}>
          <img
            src="/brand/logo-horizontal.png"
            alt={`${t.logoAlt} — ${t.tagline}`}
            width="270"
            height="55"
            class:list={['h-[38px] w-auto lg:h-[5.6em]', dark && 'brightness-0 invert']}
          />
        </a>

        <nav
          aria-label={t.footerNavAria}
          class="mt-5 flex flex-wrap items-center gap-x-5 gap-y-1 lg:mt-0 lg:ml-[15.5em] lg:gap-x-[2.4em]"
        >
          {
            t.nav.map((item) => (
              <a
                href={localizePath(item.href, lang)}
                class:list={[
                  'text-[13px] leading-6 transition-colors lg:text-[clamp(13px,1.83em,15px)]',
                  dark ? 'text-white/85 hover:text-white' : 'text-mn-muted hover:text-mn-green',
                ]}
              >
                {item.label}
              </a>
            ))
          }
        </nav>

        <ul class="flex items-center gap-4 lg:ml-auto lg:gap-[2.2em]">
          {
            socials.map((s) => (
              <li>
                <a
                  href={s.href}
                  aria-label={s.label}
                  target={s.external ? '_blank' : undefined}
                  rel={s.external ? 'noopener noreferrer' : undefined}
                  class="block opacity-80 transition-opacity hover:opacity-100"
                >
                  <img
                    src={s.icon.src}
                    alt=""
                    width="34"
                    height="34"
                    class:list={['size-6 lg:size-[3.4em]']}
                    loading="lazy"
                  />
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div class:list={['h-px', dark ? 'bg-white/25' : 'bg-mn-green/28']}></div>

      <div
        class:list={[
          'flex flex-col gap-1 py-2 text-[12px] sm:flex-row sm:items-center sm:justify-between lg:py-[0.9em] lg:text-[clamp(12px,1.7em,14px)]',
          dark ? 'text-white/70' : 'text-mn-muted',
        ]}
      >
        <p>© {year} MENARO. All Rights Reserved.</p>
        <ul class="flex flex-wrap items-center gap-x-4 gap-y-1">
          {
            t.legal.map((item, i) => (
              <li class="flex items-center gap-4">
                {i > 0 && <span class:list={[dark ? 'text-white/30' : 'text-mn-border']} aria-hidden="true">|</span>}
                <a
                  href={localizePath(item.href, lang)}
                  class:list={['transition-colors', dark ? 'hover:text-white' : 'hover:text-mn-green']}
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </Container>
</footer>