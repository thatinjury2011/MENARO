---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { getLangFromUrl, localizePath } from '../../i18n/utils';
import { ui } from '../../i18n/ui';
import { productDrawer } from '../../data/product-drawer';

import categoryTitle from '../../assets/drawer/category-title.webp';
import categoryBg from '../../assets/drawer/category-bg.webp';
import itemGrout from '../../assets/drawer/item-grout.webp';
import itemAdhesive from '../../assets/drawer/item-adhesive.webp';
import itemSealant from '../../assets/drawer/item-sealant.webp';
import itemEpoxy from '../../assets/drawer/item-epoxy.webp';
import itemWaterproof from '../../assets/drawer/item-waterproof.webp';
import itemCoating from '../../assets/drawer/item-coating.webp';
import itemJoinery from '../../assets/drawer/item-joinery.webp';
import itemWindows from '../../assets/drawer/item-windows.webp';
import itemFlooring from '../../assets/drawer/item-flooring.webp';
import itemSanitary from '../../assets/drawer/item-sanitary.webp';
import itemLighting from '../../assets/drawer/item-lighting.webp';
import itemFurniture from '../../assets/drawer/item-furniture.webp';
import collab from '../../assets/drawer/collab.webp';
import contactEmail from '../../assets/drawer/contact-email.webp';
import contactPhone from '../../assets/drawer/contact-phone.webp';

const lang = getLangFromUrl(Astro.url);
const t = productDrawer[lang];
const c = t.collab;

const icons: Record<string, ImageMetadata> = {
  grout: itemGrout,
  adhesive: itemAdhesive,
  sealant: itemSealant,
  epoxy: itemEpoxy,
  waterproof: itemWaterproof,
  coating: itemCoating,
  joinery: itemJoinery,
  windows: itemWindows,
  flooring: itemFlooring,
  sanitary: itemSanitary,
  lighting: itemLighting,
  furniture: itemFurniture,
  collab,
};
const bgs = { 'category-title': categoryTitle, 'category-bg': categoryBg };
const telHref = 'tel:+8613738577658';
// 抽屉内部尺寸统一用 em，随面板根字号等比缩放 → 整幅刚好铺满视口、无内部滚动条。
// 基准 16px 时：中文总高 1082px（67.6em，标题 1 行）、英文总高 1226px（76.6em，标题最多 2 行），
// 所以根字号除数按语言分开取，保证两种语言在任何视口高度下都严丝合缝。
const fitUnits = lang === 'zh' ? 69 : 78;
const descWidth = 'max-w-[20.5em]';
// 480 宽下分类说明要 3 行，分类条统一留 88 高（含标题 22 + 间距 6 + 3×19）
const bannerH = 'h-[5.5em]';
---

<div id="product-drawer" data-drawer class="fixed inset-0 z-[60] hidden" aria-hidden="true">
  <div
    data-drawer-backdrop
    class="absolute inset-0 bg-[#01362d]/[0.53] opacity-0 transition-opacity duration-300 ease-out"
  ></div>

  <aside
    data-drawer-panel
    role="dialog"
    aria-modal="true"
    aria-labelledby="product-drawer-title"
    class="absolute inset-0 flex w-full translate-x-full flex-col overflow-hidden bg-[#fbfcfa] transition-transform duration-300 ease-out lg:inset-x-auto lg:inset-y-0 lg:right-0 lg:w-[480px]"
    style={`font-size: clamp(9px, calc(100dvh / ${fitUnits}), 16px)`}
  >
    <div class="flex h-[5.25em] shrink-0 items-center justify-between px-[1.25em]">
      <a href={localizePath('/', lang)} class="flex shrink-0 items-center" aria-label={ui[lang].logoLabel}>
        <img
          src="/brand/logo-horizontal.png"
          alt="MENARO"
          width="270"
          height="55"
          class="h-[2.75em] w-[13.5em]"
        />
      </a>
      <div class="flex items-center">
        <span class="h-[1.75em] w-px bg-[#d9dfd8]" aria-hidden="true"></span>
        <h2 id="product-drawer-title" class="ml-[0.875em] text-[1.25em] leading-[1.75em] font-bold text-[#064b35]">
          {t.panelTitle}
        </h2>
        <button
          type="button"
          data-drawer-close
          class="mr-[0.75em] ml-[2.5em] flex size-[1.875em] cursor-pointer items-center justify-center text-[#064b35] transition-opacity hover:opacity-70"
          aria-label={t.closeLabel}
        >
          <svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.2" class="size-[0.75em]" aria-hidden="true">
            <path d="M1 1 11 11M11 1 1 11"></path>
          </svg>
        </button>
      </div>
    </div>

    <div class="flex min-h-0 flex-1 flex-col overflow-y-auto px-[1.25em] pb-[1.25em]">
      {
        t.groups.map((group, gi) => (
          <section
            aria-label={`${t.groupAria} ${group.index}`}
            class:list={['flex min-h-0 flex-1 flex-col', gi > 0 && 'mt-[1.5em]']}
          >
            <div class:list={['relative w-full shrink-0 overflow-hidden rounded-[0.5em]', bannerH]}>
              <Image src={bgs[group.bg]} alt="" class="absolute inset-0 size-full object-cover" />
              <div class="relative flex h-full w-full items-center pl-[1.25em]">
                <span class="w-[3em] shrink-0 pt-[0.25em] font-['Times_New_Roman',_serif] text-[3em] leading-none text-[#064b35]">
                  {group.index}
                </span>
                <span class="ml-[1.5em] h-[2.25em] w-px shrink-0 bg-[#d9dfd8]" aria-hidden="true" />
                <div class="ml-[1em] min-w-0 flex-1 pt-[0.125em]">
                  <h3 class="truncate text-[1.1875em] leading-[1.375em] font-bold text-[#064b35]">{group.title}</h3>
                  <p class:list={['mt-[0.375em] text-[0.8125em] leading-[1.1875em] text-[#7d8c84] line-clamp-3', descWidth]}>
                    {group.desc}
                  </p>
                </div>
              </div>
            </div>

            <ul class:list={['mx-[0.875em] flex min-h-0 flex-1 flex-col', gi === 0 ? 'mt-[1.375em]' : 'mt-[0.75em]']}>
              {group.items.map((item, i) => (
                <li class="flex min-h-[3.375em] flex-1">
                  <a
                    href={localizePath(item.href, lang)}
                    class:list={[
                      'flex w-full flex-1 items-center pl-[0.625em] transition-colors',
                      i < group.items.length - 1 && 'border-b border-[#d9dfd8]',
                      'hover:bg-[#f5f7f4]',
                    ]}
                  >
                    <Image src={icons[item.icon]} alt="" width={48} height={48} class="size-[2.5em] shrink-0" />
                    <span class="ml-[0.625em] h-[1.5em] w-px bg-[#d9dfd8]" aria-hidden="true" />
                    <span class="ml-[1.5em] min-w-0 flex-1 pt-[0.125em]">
                      <span class="line-clamp-2 text-[1.0625em] leading-[1.375em] font-bold text-black">{item.name}</span>
                      <span class="mt-[0.25em] line-clamp-1 text-[0.8125em] leading-[1.125em] text-[#333]">{item.meta}</span>
                    </span>
                    {item.planned ? (
                      <span class="ml-[0.5em] inline-flex h-[1.5em] shrink-0 items-center gap-[0.3125em] rounded-full bg-[#d7d9d6] px-[0.875em] text-[0.8125em] text-[#333]">
                        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" class="size-[0.75em]" aria-hidden="true">
                          <circle cx="8" cy="8" r="6.4" stroke-width="1.2" />
                          <path d="M8 4.6V8l2.4 1.6" stroke-width="1.2" stroke-linecap="round" />
                        </svg>
                        {t.planned}
                      </span>
                    ) : (
                      <span class="ml-[0.5em] inline-flex h-[1.5em] shrink-0 items-center gap-[0.3125em] rounded-full bg-[#07563d] px-[0.875em] text-[0.8125em] text-white">
                        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" class="size-[0.75em]" aria-hidden="true">
                          <path d="M3.2 8.4 6.4 11.6 12.8 4.8" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                        {t.online}
                      </span>
                    )}
                    <span class="ml-[0.75em] flex size-[1.125em] shrink-0 items-center justify-center pr-[0.25em] text-[#064b35]" aria-hidden="true">
                      <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.4" class="size-[1.125em]">
                        <path d="m8 4 6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
                      </svg>
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ))
      }

      <div class="mt-[1.5em] flex h-[5.5em] shrink-0 items-center rounded-[0.5em] bg-[#edf3ee] pl-[1.25em]">
        <Image src={icons[c.icon]} alt="" width={48} height={48} class="size-[2.25em] shrink-0" />
        <span class="ml-[0.75em] h-[1.625em] w-px bg-[#064b35]" aria-hidden="true" />
        <div class="ml-[0.75em] min-w-0 flex-1">
          <p class="line-clamp-2 text-[1.0625em] leading-[1.375em] font-bold text-[#064b35]">{c.title}</p>
          <p class="mt-[0.25em] truncate text-[0.75em] leading-[1em] text-[#064b35]">{c.meta}</p>
        </div>
        <div class="flex shrink-0 items-center gap-[0.5em] pr-[1em]">
          <a
            href={localizePath(c.href, lang)}
            class="inline-flex h-[2em] shrink-0 items-center gap-[0.375em] bg-[#07563d] px-[0.625em] text-[0.8125em] font-bold whitespace-nowrap text-white transition-colors hover:bg-[#064b35]"
          >
            {c.cta}
            <svg viewBox="0 0 22 22" fill="none" stroke="currentColor" stroke-width="1.8" class="size-[1em]" aria-hidden="true">
              <path d="M3 11h15M13 5.5 18.5 11 13 16.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>
          <a href={`mailto:${c.email}`} aria-label={c.emailLabel} class="block shrink-0 transition-opacity hover:opacity-70">
            <Image src={contactEmail} alt="" width={44} height={42} class="h-[2em] w-[2em] object-contain" />
          </a>
          <a href={telHref} aria-label={c.phoneLabel} class="block shrink-0 transition-opacity hover:opacity-70">
            <Image src={contactPhone} alt="" width={44} height={42} class="h-[2em] w-[2em] object-contain" />
          </a>
        </div>
      </div>
    </div>
  </aside>
</div>

<script>
  const root = document.querySelector<HTMLElement>('[data-drawer]');
  const panel = root?.querySelector<HTMLElement>('[data-drawer-panel]');
  const backdrop = root?.querySelector<HTMLElement>('[data-drawer-backdrop]');
  const triggers = document.querySelectorAll<HTMLElement>('[data-drawer-open]');

  if (root && panel && backdrop) {
    let lastTrigger: HTMLElement | null = null;
    let isOpen = false;

    const open = (trigger: HTMLElement) => {
      lastTrigger = trigger;
      isOpen = true;
      root.classList.remove('hidden');
      root.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
      triggers.forEach((el) => el.setAttribute('aria-expanded', 'true'));
      requestAnimationFrame(() => {
        backdrop.classList.replace('opacity-0', 'opacity-100');
        panel.classList.replace('translate-x-full', 'translate-x-0');
      });
      panel.querySelector<HTMLElement>('[data-drawer-close]')?.focus();
    };

    const close = () => {
      isOpen = false;
      backdrop.classList.replace('opacity-100', 'opacity-0');
      panel.classList.replace('translate-x-0', 'translate-x-full');
      root.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
      triggers.forEach((el) => el.setAttribute('aria-expanded', 'false'));
      window.setTimeout(() => {
        if (!isOpen) root.classList.add('hidden');
      }, 300);
      lastTrigger?.focus();
    };

    triggers.forEach((trigger) => {
      trigger.addEventListener('click', () => {
        if (isOpen) close();
        else open(trigger);
      });
    });

    root.querySelectorAll('[data-drawer-close]').forEach((btn) => btn.addEventListener('click', close));
    backdrop.addEventListener('click', close);

    document.addEventListener('keydown', (event) => {
      if (!isOpen) return;
      if (event.key === 'Escape') {
        close();
        return;
      }
      if (event.key !== 'Tab') return;
      const focusables = panel.querySelectorAll<HTMLElement>('a[href], button');
      if (!focusables.length) return;
      const first = focusables[0];
      const last = focusables[focusables.length - 1];
      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first.focus();
      }
    });
  }
</script>
