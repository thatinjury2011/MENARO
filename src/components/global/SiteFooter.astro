---
// 全站公共：页脚（品牌 + 社交 + 四列链接 + 版权条）
// 文案与链接来自 src/data/site.ts；「产品」列来自 src/data/products.ts 的 show.footer
import { listBy } from "../../data/products/catalog";
import {
  footerCompanyLinks,
  footerSolutionLinks,
  footerUi,
  socials,
} from "../../data/global/footer";
import { brandName, contact, contactLabels, legalName } from "../../data/site";
import { localeOf } from "../../i18n/locales";
import { localeHref } from "../../i18n/links";

const locale = localeOf(Astro.currentLocale);
const t = footerUi[locale];

const productLinks = listBy("footer", locale).map((product) => ({
  label: product.shortName ?? product.name,
  href: "/products",
}));

const solutionLinks = footerSolutionLinks.map((link) => ({
  href: link.href,
  label: link[locale].label,
}));

const companyLinks = footerCompanyLinks.map((link) => ({
  href: link.href,
  label: link[locale].label,
}));

const linkGroups = [
  { title: t.groupProducts, links: productLinks },
  { title: t.groupSolutions, links: solutionLinks },
  { title: t.groupCompany, links: companyLinks },
];

// 联系区从 src/data/site.ts 的 contact 派生，改一次全站生效
const contactLines = [
  contact.phone.value,
  contact.email.value,
  `${contactLabels[locale].whatsapp}: ${contact.whatsapp.value}`,
  contact.address[locale].full,
];
---

<footer class="w-full bg-[#4a4433] text-amber-50/80">
  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6">
    <div
      class="grid gap-10 lg:grid-cols-[1.6fr_auto_1fr_1fr_1fr_1.6fr] lg:gap-8"
    >
      <!-- 品牌 -->
      <div class="flex flex-col gap-4">
        <img
          src="/images/global/logo.webp"
          alt={brandName[locale]}
          class="h-12 w-auto object-contain"
        />
        <p class="max-w-xs text-xs leading-relaxed">
          {t.blurb}
        </p>
        <p class="text-[10px] leading-relaxed text-amber-50/45">
          {t.legalPrefix}{legalName}
        </p>
      </div>

      <!-- 社交 -->
      <div class="flex flex-row gap-3 lg:flex-col">
        {
          socials.map((social) => (
            <a
              href={social.href}
              aria-label={social.name}
              class="flex size-8 items-center justify-center rounded-full border border-amber-50/25 text-amber-50/70 transition-colors hover:border-amber-50/60 hover:text-amber-50"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="size-4"
                aria-hidden="true"
                set:html={social.d}
              />
            </a>
          ))
        }
      </div>

      <!-- 链接列 -->
      {
        linkGroups.map((group) => (
          <div class="flex flex-col gap-3">
            <h3 class="text-sm font-bold text-white">{group.title}</h3>
            <ul class="flex flex-col gap-2 text-xs">
              {group.links.map((link) => (
                <li>
                  <a
                    href={localeHref(locale, link.href)}
                    class="transition-colors hover:text-white"
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }

      <!-- 联系我们 -->
      <div class="flex flex-col gap-3">
        <h3 class="text-sm font-bold text-white">{t.contactTitle}</h3>
        <ul class="flex flex-col gap-2 text-xs">
          {contactLines.map((line) => <li>{line}</li>)}
        </ul>
      </div>
    </div>

    <!-- 版权条 -->
    <div
      class="mt-10 flex flex-col items-center justify-between gap-4 border-t border-white/10 pt-6 text-[11px] sm:flex-row"
    >
      <img
        src="/images/global/logo.webp"
        alt="MENARO"
        class="h-9 w-auto object-contain"
      />
      <p>{t.copyright}</p>
      <div class="flex items-center gap-6">
        <a href="#" class="transition-colors hover:text-white">{t.privacy}</a>
        <a href="#" class="transition-colors hover:text-white">{t.terms}</a>
      </div>
    </div>
  </div>
</footer>
