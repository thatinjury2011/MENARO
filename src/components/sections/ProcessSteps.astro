---
import Container from '../ui/Container.astro';

interface Step {
  index: string;
  title: string;
  desc: string;
}

interface Props {
  eyebrow?: string;
  title: string;
  note?: string;
  steps: Step[];
}

const { eyebrow, title, note, steps } = Astro.props;
---

<section class="bg-base-200/70 py-14 lg:py-20">
  <Container>
    <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
      <div class="flex flex-col gap-2">
        {eyebrow && <p class="text-[12px] tracking-[0.08em] text-mn-muted">{eyebrow}</p>}
        <h2 class="text-[28px] leading-tight font-bold tracking-tight text-mn-ink lg:text-[40px]">{title}</h2>
      </div>
      {note && <p class="max-w-[460px] text-[13px] leading-6 text-mn-muted lg:text-right">{note}</p>}
    </div>

    <ol class="mt-8 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:mt-12 lg:grid-cols-4">
      {
        steps.map((step) => (
          <li class="flex flex-col gap-2 rounded-box border border-mn-border bg-base-100 p-6">
            <span class="text-[13px] font-bold text-mn-green">{step.index}</span>
            <p class="text-[15px] font-semibold text-mn-ink">{step.title}</p>
            <p class="text-[13px] leading-6 text-mn-muted">{step.desc}</p>
          </li>
        ))
      }
    </ol>
  </Container>
</section>
