---
import Container from '../ui/Container.astro';
import Button from '../ui/Button.astro';

interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  cta: { label: string; href: string };
}

const { eyebrow, title, description, cta } = Astro.props;
---

<section class="bg-primary py-12 text-white lg:py-16">
  <Container class="flex flex-col gap-6 lg:flex-row lg:items-center lg:justify-between">
    <div class="flex flex-col gap-2">
      {eyebrow && <p class="text-[13px] text-white/60">{eyebrow}</p>}
      <h2 class="text-2xl font-bold tracking-tight lg:text-[30px]">{title}</h2>
      {description && <p class="text-[13px] text-white/70">{description}</p>}
    </div>
    <Button href={cta.href} variant="white" withArrow class="shrink-0 min-w-[188px] justify-between">
      {cta.label}
    </Button>
  </Container>
</section>
