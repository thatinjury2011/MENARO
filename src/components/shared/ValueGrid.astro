---
// 跨页公共：2×2 价值点网格（首页 About 右侧 / 关于我们页共用）
import Icon from "./Icon.astro";
import { valueGrid } from "../../data/shared/valueGrid";
import { localeOf } from "../../i18n/locales";

const locale = localeOf(Astro.currentLocale);

interface Value {
  name: string;
  desc: string;
  icon?: string;
}

interface Props {
  items?: Value[];
  class?: string;
}

const { items = valueGrid[locale].items, class: className = "" } = Astro.props;
---

<div
  class:list={[
    "grid grid-cols-1 gap-px overflow-hidden bg-neutral-200 sm:grid-cols-2",
    className,
  ]}
>
  {
    items.map((item) => (
      <div class="flex flex-col items-center gap-2 bg-white px-4 py-8 text-center">
        <Icon name={item.icon ?? "check"} class="size-6 text-amber-700/80" />
        <h3 class="text-sm font-bold text-neutral-800">{item.name}</h3>
        <p class="text-xs leading-relaxed text-neutral-500">{item.desc}</p>
      </div>
    ))
  }
</div>
