---
import "../assets/app.css";

import SiteFooter from "../components/global/SiteFooter.astro";
import SiteHeader from "../components/global/SiteHeader.astro";

interface Props {
  title?: string;
}

const { title = "MENARO 美纳罗 | 高端瓷砖铺贴材料" } = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <meta
      name="description"
      content="MENARO 美纳罗 —— 高端瓷砖铺贴材料与系统解决方案：水性环氧彩砂、瓷砖胶、美缝添加剂、防水涂料与铺贴工具配件。"
    />
    <title>{title}</title>
  </head>
  <body class="min-h-screen bg-white text-neutral-800 antialiased">
    <SiteHeader />
    <main>
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
