---
import '../styles/global.css';
import Header from '../components/site/Header.astro';
import Footer from '../components/site/Footer.astro';
import { site } from '../data/site';
import { getLangFromUrl, alternateLangHref } from '../i18n/utils';
import { htmlLang } from '../i18n/config';
import { ui } from '../i18n/ui';

interface Props {
  title?: string;
  description?: string;
  /** 深绿页脚（联系我们 / 获取报价这类无 CTA 带的下单页） */
  footerTheme?: 'light' | 'dark';
}

const lang = getLangFromUrl(Astro.url);
const t = ui[lang];
const { title, description = site.description[lang], footerTheme = 'light' } = Astro.props;
const pageTitle = title ? `${title}｜${site.name}` : site.title[lang];
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : Astro.url.href;
const otherLang = lang === 'zh' ? 'en' : 'zh';
---

<!doctype html>
<html lang={htmlLang[lang]} data-theme="menaro">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="zh-CN" href={alternateLangHref(Astro.url, 'zh')} />
    <link rel="alternate" hreflang="en" href={alternateLangHref(Astro.url, 'en')} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content={lang === 'zh' ? 'zh_CN' : 'en_US'} />
    <slot name="head" />
  </head>
  <body class="flex min-h-screen flex-col bg-base-100 text-base-content antialiased">
    <a
      href="#main"
      class="sr-only rounded-field bg-primary px-4 py-2 text-primary-content focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:z-100"
    >
      {t.skipToContent}
    </a>
    <Header />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer theme={footerTheme} />
  </body>
</html>